<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mro_bringup</name>
  <version>0.1.0</version>
  <description>통합 실행: PC 역할별 launch, 로봇별 파라미터(네임스페이스), 아레나 구역 정의, 지도</description>
  <maintainer email="jungji0913@khu.ac.kr">Kim Byeongjik</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mro_perception</exec_depend>
  <exec_depend>mro_webcam</exec_depend>
  <exec_depend>mro_navigation</exec_depend>
  <exec_depend>mro_fleet</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
