iddle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c723" target="c719"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5694" y="4165" /><mxPoint x="5694" y="3989" /><mxPoint x="4988" y="3989" /><mxPoint x="4988" y="4017" /></Array></mxGeometry></mxCell><mxCell id="e757" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c729" target="c730"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e758" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c730" target="c727"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5694" y="4542" /><mxPoint x="5694" y="4395" /><mxPoint x="4988" y="4395" /><mxPoint x="4988" y="4423" /></Array></mxGeometry></mxCell><mxCell id="c761" value="바꿀 수 있는 값&#10;마커 묶음 4×4 · 50종  ·  허용 번호 1 · 2 · 3 · 4&#10;내보내는 거리 상한 2.0 m — 넘으면 없음으로 낸다&#10;　받는 쪽이 도착으로 인정하는 1.5 m 는 소비자가 따로 건다&#10;거리 픽셀을 모으는 마커 안쪽 비율 0.4  ·  믿을 수 있는 값 판정 15 cm&#10;초점거리 보정 계수 · 로봇별 시차 보정 계수  ·  자세 내보내기 켬" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="4832" width="400" height="104" as="geometry" /></mxCell><mxCell id="c762" value="마커 검출 시작" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="4960" width="400" height="34" as="geometry" /></mxCell><mxCell id="c763" value="컬러 한 장을 풀고, 거리 한 장은 최근 여덟 장까지 시각과 함께 쌓아 둔다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5018" width="400" height="31" as="geometry" /></mxCell><mxCell id="c764" value="카메라 내부값을 받았는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5073" width="400" height="50" as="geometry" /></mxCell><mxCell id="c765" value="이번 장은 버린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="5083" width="250" height="31" as="geometry" /></mxCell><mxCell id="c766" value="보정한 초점거리를 한 번만 저장한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5147" width="400" height="31" as="geometry" /></mxCell><mxCell id="c767" value="컬러에서 마커를 찾는다 — 정해진 마커 묶음 · 모서리를 픽셀보다 잘게 잡는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5202" width="400" height="45" as="geometry" /></mxCell><mxCell id="c768" value="허용된 번호(1·2·3·4)의 마커가 보이는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5271" width="400" height="50" as="geometry" /></mxCell><mxCell id="c769" value="마커 없음(번호 −1)으로 내보낸다&#10;거리와 자세는 내지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="5274" width="250" height="45" as="geometry" /></mxCell><mxCell id="c770" value="가장 큰 마커 하나만 고르고 그 순간의 시각을 적어 둔다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5345" width="400" height="31" as="geometry" /></mxCell><mxCell id="c771" value="마커 네 모서리로 카메라에서 본 자세를 푼다&#10;여러 후보 중 되짚어 본 오차가 가장 작은 것을 고른다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5400" width="400" height="45" as="geometry" /></mxCell><mxCell id="c772" value="자세가 풀렸는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5469" width="400" height="50" as="geometry" /></mxCell><mxCell id="c773" value="이번 장은 버리고 마커 없음으로 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="5479" width="250" height="31" as="geometry" /></mxCell><mxCell id="c774" value="짝이 될 거리 한 장을 기다린다 (시각 차 0.02초 이내)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5543" width="400" height="31" as="geometry" /></mxCell><mxCell id="c775" value="짝 거리를 찾았는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5598" width="400" height="50" as="geometry" /></mxCell><mxCell id="c776" value="0.25초까지 기다린다 — 넘으면 자세로 푼 거리에&#10;최근 비율을 곱해 쓴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="5593" width="250" height="60" as="geometry" /></mxCell><mxCell id="c777" value="마커 안쪽 40 % 네모에서 거리 픽셀을 모은다&#10;하위 20 % 값을 그 마커까지의 거리로 쓴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5682" width="400" height="45" as="geometry" /></mxCell><mxCell id="c778" value="그 값을 믿을 수 있는가?&#10;중앙값과 차이가 15 cm 이내인가" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5751" width="400" height="57" as="geometry" /></mxCell><mxCell id="c779" value="배경이 섞였다 — 거리 픽셀을 버리고&#10;자세로 푼 거리에 최근 비율을 곱해 쓴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="5757" width="250" height="45" as="geometry" /></mxCell><mxCell id="c780" value="거리가 0.8 m 이상인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5832" width="400" height="50" as="geometry" /></mxCell><mxCell id="c781" value="가까우면 자세로 푼 거리를 쓴다&#10;가까울수록 그쪽이 정확하다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="5835" width="250" height="45" as="geometry" /></mxCell><mxCell id="c782" value="로봇별 시차 편향을 보정한다 (역깊이 보정식)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5906" width="400" height="31" as="geometry" /></mxCell><mxCell id="c783" value="정면 거리가 아니라 렌즈에서 마커까지의 직선거리로 바꾼다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="5961" width="400" height="31" as="geometry" /></mxCell><mxCell id="c784" value="거리가 유한하고 2.0 m 이하인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6016" width="400" height="50" as="geometry" /></mxCell><mxCell id="c785" value="버리고 마커 없음으로 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="6026" width="250" height="31" as="geometry" /></mxCell><mxCell id="c786" value="마커 번호 · 거리 · 마커 자세를 내보낸다&#10;자세는 좌우 치우침에만 쓴다 — 회전값은 두 해 문제로 흔들려 쓰지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6090" width="400" height="45" as="geometry" /></mxCell><mxCell id="e787" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=a