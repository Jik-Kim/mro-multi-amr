47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c231" target="c232"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e248" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c232" target="c233"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e249" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c233" target="c234"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e250" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c234" target="c236"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e251" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c236" target="c237"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e252" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c237" target="c238"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e253" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c225" target="c226"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e254" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c228" target="c229"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e255" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c229" target="c227"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1182" y="6676" /><mxPoint x="1182" y="6584" /><mxPoint x="476" y="6584" /><mxPoint x="476" y="6612" /></Array></mxGeometry></mxCell><mxCell id="e256" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c234" target="c235"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c259" value="무엇을 하나&#10;미리 만들어 둔 지도 파일을 읽고, 라이다가 보는 것과 지도를 맞춰&#10;로봇이 지도 어디에 있는지 계속 추정한다&#10;이 값이 없으면 길찾기가 목표를 세울 수 없다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="7335" width="400" height="74" as="geometry" /></mxCell><mxCell id="c260" value="처음 위치를 받아야 시작한다&#10;화면(RViz)에서 손으로 찍지 않는다 — 셔틀 노드가 자기 도크 좌표로 넣어 준다&#10;　손으로 찍으면 두 로봇의 기준점이 물리적으로 다른 점이 되어&#10;　구역 경계 · 정해진 자리 · 통합 상태가 전부 어긋난다 (1대로 시험하면 안 드러난다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="7433" width="400" height="104" as="geometry" /></mxCell><mxCell id="c261" value="받는 것&#10;라이다 스캔 · 바퀴가 돈 양 (로봇에서)&#10;처음 위치 (셔틀 노드가 기동할 때 준다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="7561" width="400" height="60" as="geometry" /></mxCell><mxCell id="c262" value="내보내는 것&#10;지도 위 로봇 위치 — 길찾기가 쓰고 관제가 화면에 쓴다&#10;지도 기준 좌표 변환 — 길찾기가 시작할 때 이것을 요구한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="7645" width="400" height="60" as="geometry" /></mxCell><mxCell id="c263" value="로봇마다 한 벌씩 · 지도 파일은 두 로봇이 같은 것을 쓴다&#10;　기준점이 하나여야 두 로봇의 좌표가 같은 뜻이 된다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="7729" width="400" height="45" as="geometry" /></mxCell><mxCell id="e264" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c259" target="c260"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e265" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c260" target="c261"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e266" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c261" target="c262"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e267" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c262" target="c263"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c270" value="무엇을 하나&#10;지도 위 목표 지점을 주면 경로를 만들고 바퀴 속도를 계속 내보낸다&#10;제자리 회전 · 정해진 방향으로 전진 · 도크 붙이기 같은 동작도 대신 해 준다&#10;자기 위치 추정도 여기서 돈다 — 지도와 라이다를 맞춰 위치를 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="7874" width="400" height="89" as="geometry" /></mxCell><mxCell id="c271" value="기동 순서가 중요하다&#10;① 위치 추정  ② 셔틀 노드(처음 위치를 넣는다)  ③ 길찾기  순서로 띄운다&#10;　길찾기는 시작할 때 지도 기준 좌표 변환을 요구한다&#10;　처음 위치가 늦으면 그 변환이 없어 준비가 실패하고,&#10;　한 번 실패하면 나중에 생겨도 다시 시도하지 않는다&#10;길찾기는 로봇당 한 PC 에서만 띄운다 — 두 곳에서 띄우면 바퀴 명령을 둘이 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="7987" width="400" height="118" as="geometry" /></mxCell><mxCell id="c272" value="받는 것 — 주행 노드들이 준다&#10;갈 곳 (지도 위 목표 지점과 방향)  ·  도크에 붙이기 · 도크에서 빠져나오기&#10;제자리 회전 · 정해진 방향으로 전진 (허용 오차 없이 상대 이동)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="8129" width="400" height="60" as="geometry" /></mxCell><mxCell id="c273" value="내보내는 것&#10;의도한 바퀴 속도 — 안전 감시가 정지 중에 회전분만 빌려 쓴다&#10;　최종 바퀴 명령을 그대로 읽으면 자기가 낸 것을 되먹으므로 앞단 값을 읽는다&#10;평소 바퀴 명령은 그대로 로봇으로 나간다 (정지 중에는 안전 감시가 덮어쓴다)&#10;지도 위 로봇 위치 — 관제가 화면에 쓴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="8213" width="400" height="118" as="geometry" /></mxCell><mxCell id="c274" value="안 쓰는 것&#10;뒤로 가기를 쓰지 않는다 — 로봇 앞쪽에만 범퍼와 낭떠러지 감지가 있다&#10;작은 보정 목표는 주지 않는다 — 허용 오차 안이라 로봇이 안 움직이고 곧장 성공으로 끝난다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="628" y="8355" width="400" height="74" as="geometry" /></mxCell><mxCell id="e275" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c270" target="c271"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e276" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c271" target="c272"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e277" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c272" target="c273"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e278" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c273" target="c274"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c281" value="바꿀 수 있는 값&#10;세우는 거리 0.30 m  ·  푸는 거리 0.38 m — 8 cm 여유는 라이다 오차의 네 배&#10;　0.45 로 두면 좁은 목 안에서 어느 방향으로 돌아도 풀리지 않는다 (통로 반폭 0.395 m)&#10;정지 중 통과시킬 회전 속도 상한 0.4 rad/s&#10;주행 명령 신선도 0.5초 — 이보다 오래된 명령이면 회전도 0&#10;고정값 — 앞을 보는 각도 좌우 35° · 세움 2회 연속 · 풀림 5회 연속 · 초당 20회 발행" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="8529" width="400" height="147" as="geometry" /></mxCell><mxCell id="c282" value="안전 감시 시작 — 라이다만 본다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="8700" width="400" height="34" as="geometry" /></mxCell><mxCell id="c283" value="라이다 한 장이 올 때마다 전방 좌우 35° 안의 가장 가까운 점을 찾는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="8758" width="400" height="31" as="geometry" /></mxCell><mxCell id="c284" value="30 cm 보다 가까운가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="8813" width="400" height="50" as="geometry" /></mxCell><mxCell id="c285" value="가까움 횟수를 센다 (멀어짐 횟수는 0으로)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="8887" width="400" height="31" as="geometry" /></mxCell><mxCell id="c286" value="가까움이 2회 연속인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="8942" width="400" height="50" as="geometry" /></mxCell><mxCell id="c287" value="아직 세우지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="548" y="8952" width="250" height="31" as="geometry" /></mxCell><mxCell id="c288" value="비상정지 참을 알린다 — 모든 로봇 노드가 이때 주행을 멈춘다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="9016" width="400" height="31" as="geometry" /></mxCell><mxCell id="e289" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c281" target="c282"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e290" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c282" target="c283"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e291" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c283" target="c284"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e292" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c284" target="c285"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e293" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c285" target="c286"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e294" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c286" target="c288"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e295" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c286" target="c287"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e296" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c287" target="c282"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="826" y="8967" /><mxPoint x="826" y="8688" /><mxPoint x="92" y="8688" /><mxPoint x="92" y="8717" /></Array></mxGeometry></mxCell><mxCell id="c297" value="해제 갈래" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="858" y="8529" width="400" height="34" as="geometry" /></mxCell><mxCell id="c298" value="38 cm 보다 먼가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="858" y="8587" width="400" height="50" as="geometry" /></mxCell><mxCell id="c299" value="30~38 cm 사이면 상태와 횟수를 그대로 둔다&#10;8 cm 여유는 라이다 오차의 네 배다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1288" y="8590" width="250" height="45" as="geometry" /></mxCell><mxCell id="c300" value="멀어짐 횟수를 센다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="858" y="8661" width="400" height="31" as="geometry" /></mxCell><mxCell id="c301" value="멀어짐이 5회 연속인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="858" y="8716" width="400" height="50" as="geometry" /></mxCell><mxCell id="c302" value="아직 풀지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1288" y="8726" width="250" height="31" as="geometry" /></mxCell><mxCell id="c303" value="비상정지 거짓을 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="858" y="8790" width="400" height="31" as="geometry" /></mxCell><mxCell id="e304" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c297" target="c298"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e305" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c298" target="c300"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e306" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c300" target="c301"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e307" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c301" target="c303"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e308" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c298" target="c299"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e309" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c301" target="c302"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c310" value="정지 중 바퀴 명령 — 0.05초마다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="9105" width="400" height="34" as="geometry" /></mxCell><mxCell id="c311" value="지금 비상정지 상태인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="9163" width="400" height="50" as="geometry" /></mxCell><mxCell id="c312" value="아무것도 내지 않는다 — 주행은 Nav2 가 맡는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="548" y="9165" width="250" height="45" as="geometry" /></mxCell><mxCell id="c313" value="앞뒤 이동은 전부 0 으로 덮는다&#10;전진은 장애물 쪽이고 후진은 애초에 쓰지 않는다 (뒤를 보는 감지기가 없다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="9237" width="400" height="60" as="geometry" /></mxCell><mxCell id="c314" value="길찾기가 0.5초 안에 낸 회전 명령이 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="9321" width="400" height="50" as="geometry" /></mxCell><mxCell id="c315" value="회전도 0 — 멈춘 채로 둔다&#10;돌릴 근거가 없기 때문이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="548" y="9323" width="250" height="45" as="geometry" /></mxCell><mxCell id="c316" value="회전만 0.4 rad/s 상한을 씌워 통과시킨다&#10;제자리 회전이 쓸고 가는 폭은 1.4 cm 뿐이라 안전하고,&#10;후진을 안 쓰는 이상 이것이 유일한 탈출 수단이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="9395" width="400" height="60" as="geometry" /></mxCell><mxCell id="c317" value="바퀴 속도 명령을 초당 20번 덮어쓴다 — Nav2 보다 나중 명령이 이긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="118" y="9479" width="400" height="31" as="geometry" /></mxCell><mxCell id="e318" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c310" target="c311"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e319" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c311" target="c313"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e320" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c313" target="c314"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e321" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c314" target="c316"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e322" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c316" target="c317"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e323" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c311" target="c312"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e324" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c314" target="c315"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c329" value="웹캠 1 · USB 카메라&#10;출입구 정면 · 출입구만 본다 (관제탑 구역은 시야 밖)&#10;초당 25장(장비 상한) · 1280×720 · MJPG&#10;프로그램이 직접 읽는다 — ROS 토픽이 아니다&#10;들고 있는 화면은 한 장만 (오래된 화면이 쌓이면 지연이 커진다)&#10;번호 −1 이면 높은 번호부터 자동 탐색 · 내장 카메라가 있으면 번호를 직접 준다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="456" width="400" height="118" as="geometry" /></mxCell><mxCell id="c330" value="바꿀 수 있는 값 (기본값)&#10;검출 모델 — 작업자 복장 두 가지를 가르도록 학습한 것. 인지팀과 같은 파일을 쓴다&#10;등록 대상 복장 — 파랑 세로줄 · 주황 가로줄 두 가지만&#10;검출 확신도 하한  0.5  — 정확도만 보면 0.4 가 낫지만 잘못 잡으면 잘못 따라간다&#10;재등록 판정 기준  0.45  — 끊긴 사람이 기존 등록자와 같은지 (실측 0.55~0.91 에서 여유 0.10)&#10;카메라 번호 — 자동 탐색(−1) · 화면 창 표시 켬" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="598" width="400" height="147" as="geometry" /></mxCell><mxCell id="c331" value="고정한 값&#10;처리 주기 0.1초 (초당 10회)  ·  등록 확정 1.0초 연속&#10;검출 확정 0.3초 · 해제 0.5초  ·  지문 평균 최근 10장 (= 1초)&#10;재발행 1초마다  ·  최대 작업자 2명 (W1 · W2)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="769" width="400" height="74" as="geometry" /></mxCell><mxCell id="c332" value="등록 프로그램 시작 — 0.1초마다 한 회차" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="867" width="400" height="34" as="geometry" /></mxCell><mxCell id="c333" value="화면 한 장을 읽었는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="925" width="400" height="50" as="geometry" /></mxCell><mxCell id="c334" value="이번 회차는 건너뛴다&#10;0.1초 뒤 다음 화면부터" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3174" y="928" width="250" height="45" as="geometry" /></mxCell><mxCell id="c335" value="검출 모델로 사람을 찾고 추적 번호를 붙인다&#10;프레임이 바뀌어도 같은 사람에게 같은 번호가 유지되는 추적을 쓴다&#10;확신도 0.5 미만은 버린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="999" width="400" height="60" as="geometry" /></mxCell><mxCell id="c336" value="등록 대상 복장인가?&#10;worker_a 파랑 세로줄 · worker_b 주황 가로줄" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1083" width="400" height="57" as="geometry" /></mxCell><mxCell id="c337" value="등록하지 않고 버린다&#10;대상 아닌 것이 등록 자리를 차지하지 못하게" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3174" y="1089" width="250" height="45" as="geometry" /></mxCell><mxCell id="c338" value="사람 네모 안 전체(머리~밑단)를 잘라 색 지문을 만든다&#10;색상 16칸 × 채도 8칸 = 숫자 128개, 크기로 나눠 정규화&#10;상의만 자르면 이 거리에서 픽셀이 부족해 지문이 뭉개진다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1164" width="400" height="60" as="geometry" /></mxCell><mxCell id="c339" value="최근 열 장을 평균내 지문을 안정시킨다&#10;한 장만 쓰면 흐린 프레임이 그대로 나간다 — 평균이 잡음을 씻는다&#10;실측: 같은 인형끼리 닮은 정도가 0.26 → 0.41 로 올라간다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1248" width="400" height="60" as="geometry" /></mxCell><mxCell id="c340" value="추적 번호가 1.0초 동안 끊기지 않았는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1332" width="400" height="50" as="geometry" /></mxCell><mxCell id="c341" value="아직 확정하지 않는다&#10;끊기면 세던 것을 버리고 처음부터 다시 센다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3174" y="1334" width="250" height="45" as="geometry" /></mxCell><mxCell id="c342" value="끊겼던 등록자와 지문이 0.45 이상 닮았는가?&#10;같은 복장 클래스끼리만 비교한다" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1406" width="400" height="57" as="geometry" /></mxCell><mxCell id="c343" value="추적 번호만 갈아끼우고 작업자 번호는 그대로 둔다&#10;한 사람이 끊겼다 다시 들어와 W1·W2 를 모두 차지하는 것을 막는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1487" width="400" height="45" as="geometry" /></mxCell><mxCell id="c344" value="이미 두 명(W1 · W2)이 찼는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1556" width="400" height="50" as="geometry" /></mxCell><mxCell id="c345" value="새 작업자 번호를 준다 — W1 부터 차례로" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1630" width="400" height="31" as="geometry" /></mxCell><mxCell id="c346" value="등록표에 적는다&#10;추적 번호 → (작업자 번호, 복장 클래스, 색 지문 128개)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1685" width="400" height="45" as="geometry" /></mxCell><mxCell id="c347" value="네모와 등록 상태를 그린 화면을 내보낸다&#10;사람이 눈으로 보는 용도 — 판정에는 쓰지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1754" width="400" height="45" as="geometry" /></mxCell><mxCell id="c348" value="1초 타이머 — 등록표를 통째로 다시 내보낸다&#10;/webcam1/worker_descriptor · WorkerDescriptor · RELIABLE&#10;담는 것 — 작업자 번호(W1 · W2) · 복장 종류 · 색 지문 숫자 128개 · 담당 로봇 칸(빈칸)&#10;담당 로봇 칸은 비워 둔다 — 관제가 채운다&#10;관제나 로봇이 늦게 켜져도 받게 한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="1823" width="400" height="104" as="geometry" /></mxCell><mxCell id="e349" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c329" target="c330"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e350" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c330" target="c331"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e351" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="