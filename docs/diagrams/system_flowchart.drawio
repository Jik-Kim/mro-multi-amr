ntSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c465" target="c466"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c475" value="아는 명령이고 대상 로봇이 맞는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4540" width="400" height="50" as="geometry" /></mxCell><mxCell id="c476" value="거부 이유를 답한다&#10;이번 명령은 여기서 끝" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3544" y="4543" width="250" height="45" as="geometry" /></mxCell><mxCell id="c477" value="운영자가 개입한 사실을 기록 파일에 남긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4614" width="400" height="31" as="geometry" /></mxCell><mxCell id="c478" value="작업 종료를 그 로봇에 알린다&#10;짝 지정이면 그 로봇의 인지 노드에 판정을 넘긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4669" width="400" height="45" as="geometry" /></mxCell><mxCell id="c479" value="인지 노드의 수락 여부를 그대로 운영자에게 답한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4738" width="400" height="31" as="geometry" /></mxCell><mxCell id="e480" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize