d="e846" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c830" target="c831"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e847" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c831" target="c833"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e848" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c833" target="c834"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e849" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c834" target="c835"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e850" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c822" target="c823"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e851" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c825" target="c826"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e852" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c826" target="c824"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5694" y="6676" /><mxPoint x="5694" y="6584" /><mxPoint x="4988" y="6584" /><mxPoint x="4988" y="6612" /></Array></mxGeometry></mxCell><mxCell id="e853" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c831" target="c832"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c856" value="무엇을 하나&#10;미리 만들어 둔 지도 파일을 읽고, 라이다가 보는 것과 지도를 맞춰&#10;로봇이 지도 어디에 있는지 계속 추정한다&#10;이 값이 없으면 길찾기가 목표를 세울 수 없다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7335" width="400" height="74" as="geometry" /></mxCell><mxCell id="c857" value="처음 위치를 받아야 시작한다&#10;화면(RViz)에서 손으로 찍지 않는다 — 셔틀 노드가 자기 도크 좌표로 넣어 준다&#10;　손으로 찍으면 두 로봇의 기준점이 물리적으로 다른 점이 되어&#10;　구역 경계 · 정해진 자리 · 통합 상태가 전부 어긋난다 (1대로 시험하면 안 드러난다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7433" width="400" height="104" as="geometry" /></mxCell><mxCell id="c858" value="받는 것&#10;라이다 스캔 · 바퀴가 돈 양 (로봇에서)&#10;처음 위치 (셔틀 노드가 기동할 때 준다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7561" width="400" height="60" as="geometry" /></mxCell><mxCell id="c859" value="내보내는 것&#10;지도 위 로봇 위치 — 길찾기가 쓰고 관제가 화면에 쓴다&#10;지도 기준 좌표 변환 — 길찾기가 시작할 때 이것을 요구한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7645" width="400" height="60" as="geometry" /></mxCell><mxCell id="c860" value="로봇마다 한 벌씩 · 지도 파일은 두 로봇이 같은 것을 쓴다&#10;　기준점이 하나여야 두 로봇의 좌표가 같은 뜻이 된다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7729" width="400" height="45" as="geometry" /></mxCell><mxCell id="e861" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c856" target="c857"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e862" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c857" target="c858"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e863" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c858" target="c859"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e864" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c859" target="c860"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c867" value="무엇을 하나&#10;지도 위 목표 지점을 주면 경로를 만들고 바퀴 속도를 계속 내보낸다&#10;제자리 회전 · 정해진 방향으로 전진 · 도크 붙이기 같은 동작도 대신 해 준다&#10;자기 위치 추정도 여기서 돈다 — 지도와 라이다를 맞춰 위치를 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7874" width="400" height="89" as="geometry" /></mxCell><mxCell id="c868" value="기동 순서가 중요하다&#10;① 위치 추정  ② 셔틀 노드(처음 위치를 넣는다)  ③ 길찾기  순서로 띄운다&#10;　길찾기는 시작할 때 지도 기준 좌표 변환을 요구한다&#10;　처음 위치가 늦으면 그 변환이 없어 준비가 실패하고,&#10;　한 번 실패하면 나중에 생겨도 다시 시도하지 않는다&#10;길찾기는 로봇당 한 PC 에서만 띄운다 — 두 곳에서 띄우면 바퀴 명령을 둘이 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7987" width="400" height="118" as="geometry" /></mxCell><mxCell id="c869" value="받는 것 — 주행 노드들이 준다&#10;갈 곳 (지도 위 목표 지점과 방향)  ·  도크에 붙이기 · 도크에서 빠져나오기&#10;제자리 회전 · 정해진 방향으로 전진 (허용 오차 없이 상대 이동)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8129" width="400" height="60" as="geometry" /></mxCell><mxCell id="c870" value="내보내는 것&#10;의도한 바퀴 속도 — 안전 감시가 정지 중에 회전분만 빌려 쓴다&#10;　최종 바퀴 명령을 그대로 읽으면 자기가 낸 것을 되먹으므로 앞단 값을 읽는다&#10;평소 바퀴 명령은 그대로 로봇으로 나간다 (정지 중에는 안전 감시가 덮어쓴다)&#10;지도 위 로봇 위치 — 관제가 화면에 쓴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8213" width="400" height="118" as="geometry" /></mxCell><mxCell id="c871" value="안 쓰는 것&#10;뒤로 가기를 쓰지 않는다 — 로봇 앞쪽에만 범퍼와 낭떠러지 감지가 있다&#10;작은 보정 목표는 주지 않는다 — 허용 오차 안이라 로봇이 안 움직이고 곧장 성공으로 끝난다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8355" width="400" height="74" as="geometry" /></mxCell><mxCell id="e872" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c867" target="c868"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e873" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c868" target="c869"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e874" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c869" target="c870"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e875" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c870" target="c871"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c878" value="바꿀 수 있는 값&#10;세우는 거리 0.30 m  ·  푸는 거리 0.38 m — 8 cm 여유는 라이다 오차의 네 배&#10;　0.45 로 두면 좁은 목 안에서 어느 방향으로 돌아도 풀리지 않는다 (통로 반폭 0.395 m)&#10;정지 중 통과시킬 회전 속도 상한 0.4 rad/s&#10;주행 명령 신선도 0.5초 — 이보다 오래된 명령이면 회전도 0&#10;고정값 — 앞을 보는 각도 좌우 35° · 세움 2회 연속 · 풀림 5회 연속 · 초당 20회 발행" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8529" width="400" height="147" as="geometry" /></mxCell><mxCell id="c879" value="안전 감시 시작 — 라이다만 본다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8700" width="400" height="34" as="geometry" /></mxCell><mxCell id="c880" value="라이다 한 장이 올 때마다 전방 좌우 35° 안의 가장 가까운 점을 찾는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8758" width="400" height="31" as="geometry" /></mxCell><mxCell id="c881" value="30 cm 보다 가까운가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8813" width="400" height="50" as="geometry" /></mxCell><mxCell id="c882" value="가까움 횟수를 센다 (멀어짐 횟수는 0으로)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8887" width="400" height="31" as="geometry" /></mxCell><mxCell id="c883" value="가까움이 2회 연속인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8942" width="400" height="50" as="geometry" /></mxCell><mxCell id="c884" value="아직 세우지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5060" y="8952" width="250" height="31" as="geometry" /></mxCell><mxCell id="c885" value="비상정지 참을 알린다 — 모든 로봇 노드가 이때 주행을 멈춘다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9016" width="400" height="31" as="geometry" /></mxCell><mxCell id="e886" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c878" target="c879"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e887" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c879" target="c880"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e888" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c880" target="c881"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e889" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c881" target="c882"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e890" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c882" target="c883"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e891" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c883" target="c885"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e892" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c883" target="c884"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e893" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c884" target="c879"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5338" y="8967" /><mxPoint x="5338" y="8688" /><mxPoint x="4604" y="8688" /><mxPoint x="4604" y="8717" /></Array></mxGeometry></mxCell><mxCell id="c894" value="해제 갈래" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8529" width="400" height="34" as="geometry" /></mxCell><mxCell id="c895" value="38 cm 보다 먼가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8587" width="400" height="50" as="geometry" /></mxCell><mxCell id="c896" value="30~38 cm 사이면 상태와 횟수를 그대로 둔다&#10;8 cm 여유는 라이다 오차의 네 배다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5800" y="8590" width="250" height="45" as="geometry" /></mxCell><mxCell id="c897" value="멀어짐 횟수를 센다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8661" width="400" height="31" as="geometry" /></mxCell><mxCell id="c898" value="멀어짐이 5회 연속인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8716" width="400" height="50" as="geometry" /></mxCell><mxCell id="c899" value="아직 풀지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5800" y="8726" width="250" height="31" as="geometry" /></mxCell><mxCell id="c900" value="비상정지 거짓을 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8790" width="400" height="31" as="geometry" /></mxCell><mxCell id="e901" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c894" target="c895"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e902" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c895" target="c897"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e903" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c897" target="c898"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e904" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c898" target="c900"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e905" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c895" target="c896"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e906" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c898" target="c899"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c907" value="정지 중 바퀴 명령 — 0.05초마다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9105" width="400" height="34" as="geometry" /></mxCell><mxCell id="c908" value="지금 비상정지 상태인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9163" width="400" height="50" as="geometry" /></mxCell><mxCell id="c909" value="아무것도 내지 않는다 — 주행은 Nav2 가 맡는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5060" y="9165" width="250" height="45" as="geometry" /></mxCell><mxCell id="c910" value="앞뒤 이동은 전부 0 으로 덮는다&#10;전진은 장애물 쪽이고 후진은 애초에 쓰지 않는다 (뒤를 보는 감지기가 없다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9237" width="400" height="60" as="geometry" /></mxCell><mxCell id="c911" value="길찾기가 0.5초 안에 낸 회전 명령이 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9321" width="400" height="50" as="geometry" /></mxCell><mxCell id="c912" value="회전도 0 — 멈춘 채로 둔다&#10;돌릴 근거가 없기 때문이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5060" y="9323" width="250" height="45" as="geometry" /></mxCell><mxCell id="c913" value="회전만 0.4 rad/s 상한을 씌워 통과시킨다&#10;제자리 회전이 쓸고 가는 폭은 1.4 cm 뿐이라 안전하고,&#10;후진을 안 쓰는 이상 이것이 유일한 탈출 수단이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9395" width="400" height="60" as="geometry" /></mxCell><mxCell id="c914" value="바퀴 속도 명령을 초당 20번 덮어쓴다 — Nav2 보다 나중 명령이 이긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9479" width="400" height="31" as="geometry" /></mxCell><mxCell id="e915" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c907" target="c908"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e916" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fon