<mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c68" target="c66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="2396" /><mxPoint x="966" y="2290" /><mxPoint x="232" y="2290" /><mxPoint x="232" y="2324" /></Array></mxGeometry></mxCell><mxCell id="e102" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c69" target="c70"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c70" target="c66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="952" y="2470" /><mxPoint x="952" y="2290" /><mxPoint x="246" y="2290" /><mxPoint x="246" y="2324" /></Array></mxGeometry></mxCell><mxCell id="e104" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c77" target="c78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c78" target="c75"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="959" y="2907" /><mxPoint x="959" y="2760" /><mxPoint x="239" y="2760" /><mxPoint x="239" y="2787" /></Array></mxGeometry></mxCell><mxCell id="e106" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c80" target="c81"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c81" target="c79"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="952" y="3036" /><mxPoint x="952" y="2944" /><mxPoint x="246" y="2944" /><mxPoint x="246" y="2971" /></Array></mxGeometry></mxCell><mxCell id="c108" value="즉시 짝을 풀고 주행을 취소한다 (1초 안)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="998" y="2174" width="400" height="31" as="geometry" /></mxCell><mxCell id="c109" value="할 일 없음으로 돌린다 — 실패가 아니다&#10;실패로 내면 관제가 미션을 영구 실패로 굳힌다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="998" y="2229" width="400" height="45" as="geometry" /></mxCell><mxCell id="e110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c108" target="c109"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c111" value="비상정지를 받으면 주행을 멈추고 잠깐 기다린다&#10;실패로 내지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="3330" width="400" height="45" as="geometry" /></mxCell><mxCell id="c114" value="바꿀 수 있는 값&#10;베이에서 마커까지 붙는 거리 0.5 m — 마커 기준 절대 위치라 출발점이 달라도 도착점이 같다&#10;　옛 방식(그 자리에서 앞으로 0.3 m)은 상대량이라 위치 오차가 그대로 남았다 (실측 0.38~0.53 m)&#10;마커 재탐지 회전 폭 — 카메라 가로 시야보다 확실히 작게&#10;적재 체류 5초  ·  토큰 재요청 2초  ·  베이 좌표와 방위는 아레나 설정 파일에서 읽는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="3475" width="400" height="133" as="geometry" /></mxCell><mxCell id="c115" value="로봇 프로그램 시작 — Nav2 보다 먼저 띄운다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="3632" width="400" height="34" as="geometry" /></mxCell><mxCell id="c116" value="자기 도크 좌표로 처음 위치를 알려준다&#10;늦게 주면 지도 준비가 실패하고 다시 시도하지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="3690" width="400" height="45" as="geometry" /></mxCell><mxCell id="c117" value="Nav2 가 준비될 때까지 기다린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="3759" width="400" height="31" as="geometry" /></mxCell><mxCell id="c118" value="미션 대기" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="3814" width="400" height="34" as="geometry" /></mxCell><mxCell id="c119" value="관제에서 배정이 왔는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="3872" width="400" height="50" as="geometry" /></mxCell><mxCell id="c120" value="그대로 기다린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="918" y="3882" width="250" height="31" as="geometry" /></mxCell><mxCell id="c121" value="도크에서 빠져나온다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="3946" width="400" height="31" as="geometry" /></mxCell><mxCell id="c122" value="배정된 베이의 정해진 자리로 이동한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4001" width="400" height="31" as="geometry" /></mxCell><mxCell id="c123" value="그 자리에서 마커가 보이는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4056" width="400" height="50" as="geometry" /></mxCell><mxCell id="c124" value="제자리 회전만으로 좌우를 번갈아 훑는다&#10;못 본다는 것은 자기 위치를 못 믿는다는 뜻이라 움직이지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="918" y="4051" width="250" height="60" as="geometry" /></mxCell><mxCell id="c125" value="마커 번호가 배정된 베이와 같고 거리가 1.5 m 이하인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4140" width="400" height="50" as="geometry" /></mxCell><mxCell id="c126" value="도착으로 보지 않는다 — 다시 훑는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="918" y="4150" width="250" height="31" as="geometry" /></mxCell><mxCell id="c127" value="마커에서 0.5 m 인 자리로 붙는다&#10;마커 기준 절대 위치라 출발점이 어디든 도착점이 같다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4214" width="400" height="45" as="geometry" /></mxCell><mxCell id="c128" value="측량된 베이 방위로 돌려세운다 — 회전·직진·회전&#10;마커의 회전값은 흔들려 쓰지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4283" width="400" height="45" as="geometry" /></mxCell><mxCell id="c129" value="베이 도착을 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4352" width="400" height="31" as="geometry" /></mxCell><mxCell id="c130" value="자재를 싣는 동안 5초 머문다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4407" width="400" height="31" as="geometry" /></mxCell><mxCell id="c131" value="좁은 목(P1) 토큰을 얻는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4462" width="400" height="31" as="geometry" /></mxCell><mxCell id="c132" value="토큰을 얻었는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4517" width="400" height="50" as="geometry" /></mxCell><mxCell id="c133" value="그 자리에서 기다렸다 2초 뒤 다시 묻는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="918" y="4527" width="250" height="31" as="geometry" /></mxCell><mxCell id="c134" value="대기 장소로 이동한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4591" width="400" height="31" as="geometry" /></mxCell><mxCell id="c135" value="좁은 목을 지났으니 토큰을 돌려준다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4646" width="400" height="31" as="geometry" /></mxCell><mxCell id="c136" value="대기 장소 도착을 알린다 — 여기서부터 추종 노드가 잡는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="4701" width="400" height="31" as="geometry" /></mxCell><mxCell id="e137" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c114" target="c115"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e138" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c115" target="c116"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e139" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c116" target="c117"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e140" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labe