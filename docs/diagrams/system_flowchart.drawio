html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c185" target="c186"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e219" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c189" target="c190"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e220" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c190" target="c167"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1196" y="6096" /><mxPoint x="1196" y="5003" /><mxPoint x="462" y="5003" /><mxPoint x="462" y="5032" /></Array></mxGeometry></mxCell><mxCell id="c223" value="바꿀 수 있는 값&#10;도킹 재시도 횟수  ·  복귀 제한 시간  ·  토큰 재요청 주기&#10;도크 정면 접근 지점과 대기 자리는 아레나 설정 파일에서 읽는다&#10;　대기 자리는 좁은 목 바깥(중앙 복도, 가장 가까운 도크에서 1.52 m)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6290" width="400" height="74" as="geometry" /></mxCell><mxCell id="c224" value="진행 중이던 이동을 취소한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6388" width="400" height="31" as="geometry" /></mxCell><mxCell id="c225" value="복귀 중임을 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6443" width="400" height="31" as="geometry" /></mxCell><mxCell id="c226" value="도크 구역 토큰을 먼저 얻는다&#10;대기 자리가 좁은 목 바깥이라 순서가 이쪽이 먼저다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6498" width="400" height="45" as="geometry" /></mxCell><mxCell id="c227" value="도크 토큰을 얻었는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6567" width="400" height="50" as="geometry" /></mxCell><mxCell id="c228" value="좁은 목 바깥 대기 자리로 가서 기다린다&#10;못 얻은 로봇은 애초에 좁은 목에 들어가지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="918" y="6562" width="250" height="60" as="geometry" /></mxCell><mxCell id="c229" value="좁은 목(P1) 토큰을 얻는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6651" width="400" height="31" as="geometry" /></mxCell><mxCell id="c230" value="좁은 목 토큰을 얻었는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6706" width="400" height="50" as="geometry" /></mxCell><mxCell id="c231" value="그 자리에서 기다렸다 다시 묻는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="918" y="6716" width="250" height="31" as="geometry" /></mxCell><mxCell id="c232" value="자기 도크 정면 접근 지점으로 이동한다&#10;도착이 곧 좁은 목 통과 완료다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6780" width="400" height="45" as="geometry" /></mxCell><mxCell id="c233" value="좁은 목 토큰을 돌려준다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6849" width="400" height="31" as="geometry" /></mxCell><mxCell id="c234" value="도킹을 시작한다 — 도크 간격이 0.84 m 뿐이라 접근 지점을 반드시 거친다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6904" width="400" height="31" as="geometry" /></mxCell><mxCell id="c235" value="도킹에 성공했는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="6959" width="400" height="50" as="geometry" /></mxCell><mxCell id="c236" value="재시도 횟수가 남았는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="7033" width="400" height="50" as="geometry" /></mxCell><mxCell id="c237" value="실패로 알린다 — 포기할 때만 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="918" y="7043" width="250" height="31" as="geometry" /></mxCell><mxCell id="c238" value="접근 지점으로 되돌아가 다시 시도한다&#10;후진은 쓰지 않는다 (뒤를 보는 감지기가 없다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="7107" width="400" height="45" as="geometry" /></mxCell><mxCell id="c239" value="도킹 완료를 알린다 — 운용시간의 끝이다&#10;성공 직후 준비 상태를 내지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="7176" width="400" height="45" as="geometry" /></mxCell><mxCell id="c240" value="성공이든 실패든 도크 토큰을 반드시 돌려준다&#10;안 돌려주면 그 구역이 영영 잠긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="7245" width="400" height="45" as="geometry" /></mxCell><mxCell id="c241" value="여기서 끝 — 다음 미션이 올 때까지 도크에서 기다린다&#10;도킹 완료 뒤에 준비 상태를 내지 않는다 — 내면 운용시간이 도크에서 한 번 더 끊긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="488" y="7314" width="400" height="60" as="geometry" /></mxCell><mxCell id="e242" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c223" target="c224"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e243" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.