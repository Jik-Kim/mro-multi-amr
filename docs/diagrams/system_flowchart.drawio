lipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8668" width="400" height="34" as="geometry" /></mxCell><mxCell id="c905" value="38 cm 보다 먼가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8726" width="400" height="50" as="geometry" /></mxCell><mxCell id="c906" value="30~38 cm 사이면 상태와 횟수를 그대로 둔다&#10;8 cm 여유는 라이다 오차의 네 배다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5800" y="8729" width="250" height="45" as="geometry" /></mxCell><mxCell id="c907" value="멀어짐 횟수를 센다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8800" width="400" height="31" as="geometry" /></mxCell><mxCell id="c908" value="멀어짐이 5회 연속인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8855" width="400" height="50" as="geometry" /></mxCell><mxCell id="c909" value="아직 풀지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5800" y="8865" width="250" height="31" as="geometry" /></mxCell><mxCell id="c910" value="비상정지 거짓을 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5370" y="8929" width="400" height="31" as="geometry" /></mxCell><mxCell id="e911" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c904" target="c905"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e912" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c905" target="c907"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e913" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c907" target="c908"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e914" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c908" target="c910"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e915" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c905" target="c906"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e916" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c908" target="c909"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c917" value="정지 중 바퀴 명령 — 0.05초마다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9244" width="400" height="34" as="geometry" /></mxCell><mxCell id="c918" value="지금 비상정지 상태인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9302" width="400" height="50" as="geometry" /></mxCell><mxCell id="c919" value="아무것도 내지 않는다 — 주행은 Nav2 가 맡는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5060" y="9304" width="250" height="45" as="geometry" /></mxCell><mxCell id="c920" value="앞뒤 이동은 전부 0 으로 덮는다&#10;전진은 장애물 쪽이고 후진은 애초에 쓰지 않는다 (뒤를 보는 감지기가 없다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9376" width="400" height="60" as="geometry" /></mxCell><mxCell id="c921" value="길찾기가 0.5초 안에 낸 회전 명령이 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9460" width="400" height="50" as="geometry" /></mxCell><mxCell id="c922" value="회전도 0 — 멈춘 채로 둔다&#10;돌릴 근거가 없기 때문이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5060" y="9462" width="250" height="45" as="geometry" /></mxCell><mxCell id="c923" value="회전만 0.4 rad/s 상한을 씌워 통과시킨다&#10;제자리 회전이 쓸고 가는 폭은 1.4 cm 뿐이라 안전하고,&#10;후진을 안 쓰는 이상 이것이 유일한 탈출 수단이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9534" width="400" height="60" as="geometry" /></mxCell><mxCell id="c924" value="바퀴 속도 명령을 초당 20번 덮어쓴다 — Nav2 보다 나중 명령이 이긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9618" width="400" height="31" as="geometry" /></mxCell><mxCell id="e925" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c917" target="c918"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e926" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c918" target="c920"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e927" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c920" target="c921"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e928" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c921" target="c923"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e929" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c923" target="c924"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e930" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c918" target="c919"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e931" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c921" target="c922"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t934" value="MRO Multi-AMR — 시스템 플로우차트" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=30;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="4000" height="46" as="geometry" /></mxCell><mxCell id="t935" value="ROKEY 9기 2PM · Phase 1 · 로봇 2대(/robot3 · /robot8) · 웹캠 2대 · 관제 1대&lt;br&gt;PC 한 대 = 테두리 하나. 테두리 안이 그 PC 에서 도는 노드, 노드 안이 그 노드가 하는 일의 순서다.&lt;br&gt;PC 를 건너는 화살표에 ROS 토픽 이름 · 타입 · 값의 뜻을 적었다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="5200" height="90" as="geometry" /></mxCell><mxCell id="t936" value="읽는 법" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="20" as="geometry" /></mxCell><mxCell id="c937" value="" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t938" value="시작" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="68" y="145" width="50" height="16" as="geometry" /></mxCell><mxCell id="c939" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="116" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t940" value="하는 일" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="144" y="145" width="74" height="16" as="geometry" /></mxCell><mxCell id="c941" value="" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="216" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t942" value="판단" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="244" y="145" width="50" height="16" as="geometry" /></mxCell><mxCell id="c943" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="292" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t944" value="갈라진 쪽의 처리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="134" height="16" as="geometry" /></mxCell><mxCell id="c945" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="452" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t946" value="계약된 토픽·서비스" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="145" width="146" height="16" as="geometry" /></mxCell><mxCell id="c947" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="624" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t948" value="외부 장비·설정" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="652" y="145" width="122" height="16" as="geometry" /></mxCell><mxCell id="t949" value="&lt;b&gt;선 색 = 토픽 갈래&lt;/b&gt;　&lt;span style=&quot;color:#1F5FBF&quot;&gt;━ 식별·대상&lt;/span&gt; (웹캠 등록 · target/*)　&lt;span style=&quot;color:#7A3E9D&quot;&gt;━ 미션 명령&lt;/span&gt; (mission/assigned · finish)　&lt;span style=&quot;color:#0E7C7B&quot;&gt;━ 상태 보고&lt;/span&gt; (approach · shuttle · zone_event)&lt;br&gt;　　　　　　　　　　&lt;span style=&quot;color:#55606B&quot;&gt;━ 장비 원본&lt;/span&gt; (oakd · scan · battery · amcl)　&lt;span style=&quot;color:#D97706&quot;&gt;┅ 서비스&lt;/span&gt; (파선)　&lt;span style=&quot;color:#C0272D&quot;&gt;━ 안전&lt;/span&gt; (estop · cmd_vel)　&lt;span style=&quot;color:#4A4A4A&quot;&gt;━ 노드 안에서 다음 칸으로 · ┅ 앞 칸으로 되돌아간다&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="2500" height="46" as="geometry" /></mxCell><mxCell id="t950" value="&lt;b&gt;말풍선&lt;/b&gt;　토픽 이름은 &lt;b&gt;제 선 위에&lt;/b&gt; 흰 바탕 상자로 얹었다 — 상자를 덮고 있는 선이 그 토픽의 선이다.&lt;br&gt;&lt;b&gt;둥근 점&lt;/b&gt;　한 토픽이 여럿에게 갈라지는 자리. &lt;b&gt;이름과 타입은 줄기에 한 번만&lt;/b&gt; 적고, 갈래에는 받는 노드가 그것으로 무엇을 하는지만 적었다.&lt;br&gt;&lt;b&gt;테두리&lt;/b&gt;　바깥 = PC 한 대　·　안쪽 = 그 PC 에서 도는 노드 하나　·　&lt;b&gt;PC4 와 PC5 는 똑같다&lt;/b&gt; — 노드도 토픽도 같고 이름 앞만 /robot3 · /robot8 로 갈린다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="2500" height="60" as="geometry" /></mxCell><mxCell id="e951" value="검출 결과를 그린 화면 한 장&#10;최신 것만 보관한다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c385" target="c417"><mxGeometry relative="1" as="geometry" x="0.5"><mxPoint as="offset" x="0" y="0" /><Array as="points"><mxPoint x="3228" y="2846" /><mxPoint x="3228" y="2374" /></Array></mxGeometry></mxCell><mxCell id="e952" value="작업자 번호 ↔ 복장 표" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c422" target="c390"><mxGeometry relative="1" as="geometry" x="0.5"><mxPoint as="offset" x="0" y="0" /><Array as="points"><mxPoint x="2940" y="3582" /><mxPoint x="2940" y="3080" /></Array></mxGeometry></mxCell><mxCell id="e953" value="/webcam2/target_hint · TargetHint&#10;10 Hz · BEST_EFFORT · 유효 2초" style="edgeStyle=orthogonalEdgeStyle;