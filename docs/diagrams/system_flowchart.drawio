Color=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c416" target="c417"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e420" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c417" target="c418"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c421" value="웹캠1 등록 소식을 받으면&#10;작업자 번호 → 복장 클래스 표를 채운다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="3498" width="400" height="45" as="geometry" /></mxCell><mxCell id="c422" value="이 표를 위 검출 갈래가 읽는다 — 없으면 복장으로 작업자를 특정할 수 없다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="3567" width="400" height="31" as="geometry" /></mxCell><mxCell id="e423" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c421" target="c422"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c428" value="바꿀 수 있는 값&#10;로봇 명단 — 두 로봇의 이름 (설정 파일이 단일 출처)&#10;통합 상태 내보내는 주기 1초  ·  대기 명단이 모이기를 기다리는 시간&#10;배정 조건 — 등록된 작업자이고 배터리가 기준 이상일 것&#10;기록은 파일 데이터베이스 한 개 — 작업자 표 · 미션 표 · 사건 표" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="3972" width="400" height="89" as="geometry" /></mxCell><mxCell id="c429" value="관제 상태 관리자 시작" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="4085" width="400" height="34" as="geometry" /></mxCell><mxCell id="c430" value="로봇별 최신값을 메모리에 모은다&#10;접근 상태 · 운송 상태 · 배터리 · 위치 · 비상정지 · 짝" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="4143" width="400" height="45" as="geometry" /></mxCell><mxCell id="c431" value="1초마다 로봇별 통합 상태를 만든다 (우선순위를 적용)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="4212" width="400" height="31" as="geometry" /></mxCell><mxCell id="c432" value="상태가 바뀌었는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="4267" width="400" height="50" as="geometry" /></mxCell><mxCell id="c433" value="최신값만 보관하고 다음 소식을 기다린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2804" y="4276" width="250" height="31" as="geometry" /></mxCell><mxCell id="c434" value="로봇별 통합 상태를 내보낸다 (초당 1번)" style="rounded=0;whiteSpace=wrap;html=1;fontFam