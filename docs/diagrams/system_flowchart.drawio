ay></mxGeometry></mxCell><mxCell id="c438" value="이미 로봇이 붙은 작업자인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="3932" width="400" height="50" as="geometry" /></mxCell><mxCell id="c439" value="그냥 넘어간다 — 이번 소식은 여기서 끝" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4006" width="400" height="31" as="geometry" /></mxCell><mxCell id="c440" value="쓸 수 있는 로봇이 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4061" width="400" height="50" as="geometry" /></mxCell><mxCell id="c441" value="배정하지 않고 기록만 남긴다&#10;이번 소식은 여기서 끝" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3544" y="4063" width="250" height="45" as="geometry" /></mxCell><mxCell id="c442" value="대기 명단에 올린다 (등록된 시각과 함께)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4135" width="400" height="31" as="geometry" /></mxCell><mxCell id="c443" value="모두 모였거나 기다리는 시간이 끝났는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3114" y="4190" width="400" height="50" as="geometry" /></mxCell><mxCell id="c444" value="잠깐 기다렸다 처리한다&#10;두 명이 거의 동시에 오면 모일 때까지 기다린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;