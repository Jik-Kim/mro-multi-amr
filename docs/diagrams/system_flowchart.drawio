ttySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c908" target="c909"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e921" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c911" target="c912"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t924" value="MRO Multi-AMR — 시스템 플로우차트" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=30;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="4000" height="46" as="geometry" /></mxCell><mxCell id="t925" value="ROKEY 9기 2PM · Phase 1 · 로봇 2대(/robot3 · /robot8) · 웹캠 2대 · 관제 1대&lt;br&gt;PC 한 대 = 테두리 하나. 테두리 안이 그 PC 에서 도는 노드, 노드 안이 그 노드가 하는 일의 순서다.&lt;br&gt;PC 를 건너는 화살표에 ROS 토픽 이름 · 타입 · 값의 뜻을 적었다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="5200" height="90" as="geometry" /></mxCell><mxCell id="t926" value="읽는 법" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="20" as="geometry" /></mxCell><mxCell id="c927" value="" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t928" value="시작" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="68" y="145" width="50" height="16" as="geometry" /></mxCell><mxCell id="c929" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="116" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t930" value="하는 일" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="144" y="145" width="74" height="16" as="geometry" /></mxCell><mxCell id="c931" value="" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="216" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t932" value="판단" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="244" y="145" width="50" height="16" as="geometry" /></mxCell><mxCell id="c933" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="292" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t934" value="갈라진 쪽의 처리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="134" height="16" as="geometry" /></mxCell><mxCell id="c935" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="452" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t936" value="계약된 토픽·서비스" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="145" width="146" height="16" as="geometry" /></mxCell><mxCell id="c937" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="624" y="144" width="22" height="16" as="geometry" /></mxCell><mxCell id="t938" value="외부 장비·설정" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="652" y="145" width="122" height="16" as="geometry" /></mxCell><mxCell id="t939" value="&lt;b&gt;선 색 = 토픽 갈래&lt;/b&gt;　&lt;span style=&quot;color:#1F5FBF&quot;&gt;━ 식별·대상&lt;/span&gt; (웹캠 등록 · target/*)　&lt;span style=&quot;color:#7A3E9D&quot;&gt;━ 미션 명령&lt;/span&gt; (mission/assigned · finish)　&lt;span style=&quot;color:#0E7C7B&quot;&gt;━ 상태 보고&lt;/span&gt; (approach · shuttle · zone_event)&lt;br&gt;　　　　　　　　　　&lt;span style=&quot;color:#55606B&quot;&gt;━ 장비 원본&lt;/span&gt; (oakd · scan · battery · amcl)　&lt;span style=&quot;color:#D97706&quot;&gt;┅ 서비스&lt;/span&gt; (파선)　&lt;span style=&quot;color:#C0272D&quot;&gt;━ 안전&lt;/span&gt; (estop · cmd_vel)　&lt;span style=&quot;color:#4A4A4A&quot;&gt;━ 노드 안에서 다음 칸으로 · ┅ 앞 칸으로 되돌아간다&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="2500" height="46" as="geometry" /></mxCell><mxCell id="t940" value="&lt;b&gt;말풍선&lt;/b&gt;　토픽 이름은 &lt;b&gt;제 선 위에&lt;/b&gt; 흰 바탕 상자로 얹었다 — 상자를 덮고 있는 선이 그 토픽의 선이다.&lt;br&gt;&lt;b&gt;둥근 점&lt;/b&gt;　한 토픽이 여럿에게 갈라지는 자리. &lt;b&gt;이름과 타입은 줄기에 한 번만&lt;/b&gt; 적고, 갈래에는 받는 노드가 그것으로 무엇을 하는지만 적었다.&lt;br&gt;&lt;b&gt;테두리&lt;/b&gt;　바깥 = PC 한 대　·　안쪽 = 그 PC 에서 도는 노드 하나　·　&lt;b&gt;PC4 와 PC5 는 똑같다&lt;/b&gt; — 노드도 토픽도 같고 이름 앞만 /robot3 · /robot8 로 갈린다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Malgun Gothic;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="2500" height="60" as="geometry" /></mxCell><mxCell id="e941" value="/webcam2/target_hint · TargetHint&#10;10 Hz · BEST_EFFORT · 유효 2초" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F5FBF;strokeWidth=1.6;fontFamily=Malgun Gothic;fontSize=10;fontColor=#1F5FBF;labelBackgroundColor=#FFFFFF;labelBorderColor=#1F5FBF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c389" target="c562"><mxGeometry relative="1" as="geometry" x="-0.04640819443820443"><mxPoint as="offset" x="0" y="0" /><Array as="points"><mxPoint x="2484" y="3274" /><mxPoint x="2484" y="3588" /><mxPoint x="2329" y="3588" /><mxPoint x="2329" y="6844" /><mxPoint x="2854" y="6844" /><mxPoint x="2854" y="6986" /></Array></mxGeometry></mxCell><mxCell id="e942" value="/fleet/request_mission · 서비스&#10;자재 요청" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.6;fontFamily=Malgun Gothic;fontSize=10;fontColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=#D97706;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c485" target="c458"><mxGeometry relative="1" as