parent="1" source="c833" target="c835"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e852" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c835" target="c836"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e853" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c836" target="c837"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e854" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c837" target="c838"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e855" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c838" target="c839"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e856" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c839" target="c841"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e857" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c841" target="c842"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e858" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c842" target="c843"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e859" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c843" target="c844"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e860" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c830" target="c831"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e861" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c833" target="c834"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e862" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c834" target="c832"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5694" y="6731" /><mxPoint x="5694" y="6639" /><mxPoint x="4988" y="6639" /><mxPoint x="4988" y="6667" /></Array></mxGeometry></mxCell><mxCell id="e863" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c839" target="c840"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c866" value="무엇을 하나&#10;미리 만들어 둔 지도 파일을 읽고, 라이다가 보는 것과 지도를 맞춰&#10;로봇이 지도 어디에 있는지 계속 추정한다&#10;이 값이 없으면 길찾기가 목표를 세울 수 없다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7474" width="400" height="74" as="geometry" /></mxCell><mxCell id="c867" value="처음 위치를 받아야 시작한다&#10;화면(RViz)에서 손으로 찍지 않는다 — 셔틀 노드가 자기 도크 좌표로 넣어 준다&#10;　손으로 찍으면 두 로봇의 기준점이 물리적으로 다른 점이 되어&#10;　구역 경계 · 정해진 자리 · 통합 상태가 전부 어긋난다 (1대로 시험하면 안 드러난다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7572" width="400" height="104" as="geometry" /></mxCell><mxCell id="c868" value="받는 것&#10;라이다 스캔 · 바퀴가 돈 양 (로봇에서)&#10;처음 위치 (셔틀 노드가 기동할 때 준다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7700" width="400" height="60" as="geometry" /></mxCell><mxCell id="c869" value="내보내는 것&#10;지도 위 로봇 위치 — 길찾기가 쓰고 관제가 화면에 쓴다&#10;지도 기준 좌표 변환 — 길찾기가 시작할 때 이것을 요구한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7784" width="400" height="60" as="geometry" /></mxCell><mxCell id="c870" value="로봇마다 한 벌씩 · 지도 파일은 두 로봇이 같은 것을 쓴다&#10;　기준점이 하나여야 두 로봇의 좌표가 같은 뜻이 된다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="7868" width="400" height="45" as="geometry" /></mxCell><mxCell id="e871" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c866" target="c867"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e872" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c867" target="c868"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e873" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c868" target="c869"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e874" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c869" target="c870"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c877" value="무엇을 하나&#10;지도 위 목표 지점을 주면 경로를 만들고 바퀴 속도를 계속 내보낸다&#10;제자리 회전 · 정해진 방향으로 전진 · 도크 붙이기 같은 동작도 대신 해 준다&#10;자기 위치 추정도 여기서 돈다 — 지도와 라이다를 맞춰 위치를 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8013" width="400" height="89" as="geometry" /></mxCell><mxCell id="c878" value="기동 순서가 중요하다&#10;① 위치 추정  ② 셔틀 노드(처음 위치를 넣는다)  ③ 길찾기  순서로 띄운다&#10;　길찾기는 시작할 때 지도 기준 좌표 변환을 요구한다&#10;　처음 위치가 늦으면 그 변환이 없어 준비가 실패하고,&#10;　한 번 실패하면 나중에 생겨도 다시 시도하지 않는다&#10;길찾기는 로봇당 한 PC 에서만 띄운다 — 두 곳에서 띄우면 바퀴 명령을 둘이 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8126" width="400" height="118" as="geometry" /></mxCell><mxCell id="c879" value="받는 것 — 주행 노드들이 준다&#10;갈 곳 (지도 위 목표 지점과 방향)  ·  도크에 붙이기 · 도크에서 빠져나오기&#10;제자리 회전 · 정해진 방향으로 전진 (허용 오차 없이 상대 이동)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8268" width="400" height="60" as="geometry" /></mxCell><mxCell id="c880" value="내보내는 것&#10;의도한 바퀴 속도 — 안전 감시가 정지 중에 회전분만 빌려 쓴다&#10;　최종 바퀴 명령을 그대로 읽으면 자기가 낸 것을 되먹으므로 앞단 값을 읽는다&#10;평소 바퀴 명령은 그대로 로봇으로 나간다 (정지 중에는 안전 감시가 덮어쓴다)&#10;지도 위 로봇 위치 — 관제가 화면에 쓴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8352" width="400" height="118" as="geometry" /></mxCell><mxCell id="c881" value="안 쓰는 것&#10;뒤로 가기를 쓰지 않는다 — 로봇 앞쪽에만 범퍼와 낭떠러지 감지가 있다&#10;작은 보정 목표는 주지 않는다 — 허용 오차 안이라 로봇이 안 움직이고 곧장 성공으로 끝난다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5140" y="8494" width="400" height="74" as="geometry" /></mxCell><mxCell id="e882" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c877" target="c878"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e883" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c878" target="c879"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e884" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c879" target="c880"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e885" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c880" target="c881"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c888" value="바꿀 수 있는 값&#10;세우는 거리 0.30 m  ·  푸는 거리 0.38 m — 8 cm 여유는 라이다 오차의 네 배&#10;　0.45 로 두면 좁은 목 안에서 어느 방향으로 돌아도 풀리지 않는다 (통로 반폭 0.395 m)&#10;정지 중 통과시킬 회전 속도 상한 0.4 rad/s&#10;주행 명령 신선도 0.5초 — 이보다 오래된 명령이면 회전도 0&#10;고정값 — 앞을 보는 각도 좌우 35° · 세움 2회 연속 · 풀림 5회 연속 · 초당 20회 발행" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8668" width="400" height="147" as="geometry" /></mxCell><mxCell id="c889" value="안전 감시 시작 — 라이다만 본다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8839" width="400" height="34" as="geometry" /></mxCell><mxCell id="c890" value="라이다 한 장이 올 때마다 전방 좌우 35° 안의 가장 가까운 점을 찾는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8897" width="400" height="31" as="geometry" /></mxCell><mxCell id="c891" value="30 cm 보다 가까운가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="8952" width="400" height="50" as="geometry" /></mxCell><mxCell id="c892" value="가까움 횟수를 센다 (멀어짐 횟수는 0으로)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9026" width="400" height="31" as="geometry" /></mxCell><mxCell id="c893" value="가까움이 2회 연속인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9081" width="400" height="50" as="geometry" /></mxCell><mxCell id="c894" value="아직 세우지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5060" y="9091" width="250" height="31" as="geometry" /></mxCell><mxCell id="c895" value="비상정지 참을 알린다 — 모든 로봇 노드가 이때 주행을 멈춘다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4630" y="9155" width="400" height="31" as="geometry" /></mxCell><mxCell id="e896" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c888" target="c889"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e897" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c889" target="c890"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e898" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c890" target="c891"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e899" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c891" target="c892"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e900" value="" style="edgeStyle=orthogon