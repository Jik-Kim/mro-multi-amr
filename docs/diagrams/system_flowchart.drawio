 edge="1" parent="1" source="c337" target="c332"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3438" y="1112" /><mxPoint x="3438" y="855" /><mxPoint x="2732" y="855" /><mxPoint x="2732" y="884" /></Array></mxGeometry></mxCell><mxCell id="e369" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c340" target="c341"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e370" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c341" target="c332"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3438" y="1357" /><mxPoint x="3438" y="855" /><mxPoint x="2732" y="855" /><mxPoint x="2732" y="884" /></Array></mxGeometry></mxCell><mxCell id="c375" value="웹캠 2 · USB 카메라&#10;P3 개구부 정면 — 작업공간 입구를 본다&#10;640×480 · 초당 30장 · 버퍼 5 · 프로그램이 직접 읽는다&#10;바닥 좌표 변환표(호모그래피 3×3)를 파일에서 미리 읽는다&#10;  화면 픽셀 → 바닥 평면 map 좌표. 바닥에 붙은 기준점 네 개로 미리 구해 둔다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2301" width="400" height="104" as="geometry" /></mxCell><mxCell id="c376" value="바꿀 수 있는 값 (기본값)&#10;카메라 번호 0 · 가로 640 · 세로 480 · 초당 30장 · 버퍼 5장&#10;검출 주기 초당 10회      화면 내보내는 주기 초당 10회&#10;검출 확신도 하한 0.5  ·  등록 대상 복장 두 가지&#10;트랙 확정 0.3초 연속 보이면  ·  0.5초 넘게 끊기면 세던 것을 버린다&#10;놓침 확정 1.0초 안 보이면  ·  받는 쪽이 힌트를 믿는 시간 2.0초&#10;화면 압축 품질 80  ·  검출 모델과 바닥 좌표 변환표는 파일에서 읽는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2429" width="400" height="118" as="geometry" /></mxCell><mxCell id="c377" value="실행 구조&#10;스레드 셋이 각각 돈다 — 카메라 읽기 / 검출 / 화면 발행&#10;검출과 화면 발행은 서로 배타로 묶어 같은 자원을 동시에 만지지 않게 한다&#10;카메라 스레드는 최신 화면 한 장과 번호만 남긴다 — 처리가 밀려도 지연이 쌓이지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2571" width="400" height="89" as="geometry" /></mxCell><mxCell id="c378" value="0.1초 타이머 — 여기서부터 검출 한 회차" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2684" width="400" height="34" as="geometry" /></mxCell><mxCell id="c379" value="마지막에 처리한 번호와 다른 새 화면이 왔는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2742" width="400" height="50" as="geometry" /></mxCell><mxCell id="c380" value="이번 회차는 건너뛴다 — 같은 화면을 두 번 처리하지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2944" y="2744" width="250" height="45" as="geometry" /></mxCell><mxCell id="c381" value="검출 모델로 사람을 찾고 추적 번호를 붙인다&#10;확신도 0.5 미만은 버린다&#10;검출 결과(네모·번호)를 그린 화면을 따로 만들어 최신 한 장으로 보관한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2816" width="400" height="60" as="geometry" /></mxCell><mxCell id="c382" value="등록 대상 복장인가? (worker_a · worker_b)" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2900" width="400" height="50" as="geometry" /></mxCell><mxCell id="c383" value="버린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2944" y="2910" width="250" height="31" as="geometry" /></mxCell><mxCell id="c384" value="이 추적 번호가 확정됐는가?&#10;0.3초 연속 보였는가 · 0.5초 넘게 끊겼으면 처음부터 다시" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="2974" width="400" height="57" as="geometry" /></mxCell><mxCell id="c385" value="아직 힌트를 내지 않는다&#10;확정 전에는 좌표를 믿지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2944" y="2980" width="250" height="45" as="geometry" /></mxCell><mxCell id="c386" value="그 복장으로 등록된 작업자가 정확히 한 명인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="3055" width="400" height="50" as="geometry" /></mxCell><mxCell id="c387" value="작업자 번호를 정하지 않는다 — 힌트를 내지 않는다&#10;둘 다 같은 복장이면 누구인지 못 정한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2944" y="3050" width="250" height="60" as="geometry" /></mxCell><mxCell id="c388" value="사람 네모의 아래 가운데 점을 바닥 좌표로 바꾼다&#10;발이 바닥에 닿는 점이라 평면 가정이 성립한다 — 몸통 중심을 쓰면 키만큼 밀린다&#10;미리 읽어 둔 변환표(3×3)를 곱해 map 좌표를 얻는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="3139" width="400" height="74" as="geometry" /></mxCell><mxCell id="c389" value="작업자 번호와 바닥 좌표를 내보낸다&#10;/webcam2/target_hint · TargetHint · 초당 10번 · BEST_EFFORT&#10;담는 것 — 작업자 번호 · 바닥 좌표 두 값 · 확신도 · 시각&#10;받는 쪽도 같은 QoS 로 잡아야 받는다 · 2초까지만 믿는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="3237" width="400" height="74" as="geometry" /></mxCell><mxCell id="c390" value="1.0초 넘게 안 보인 추적 번호가 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="3335" width="400" height="50" as="geometry" /></mxCell><mxCell id="c391" value="그 추적 상태를 지운다 — 다시 나타나면 처음부터 다시 센다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2514" y="3409" width="400" height="31" as="geometry" /></mxCell><mxCell id="e392" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c375" target="c376"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e393" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=