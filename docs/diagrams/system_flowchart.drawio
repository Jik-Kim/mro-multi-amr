 /></mxCell><mxCell id="c551" value="그대로 둔다 — 정상 통과는 10~20초다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3264" y="6633" width="250" height="31" as="geometry" /></mxCell><mxCell id="c552" value="억지로 거둬들였다고 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2834" y="6698" width="400" height="31" as="geometry" /></mxCell><mxCell id="c553" value="구역을 비운다&#10;돌려주지 않고 사라진 로봇 때문에 구역이 영영 잠기는 것을 막는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2834" y="6753" width="400" height="45" as="geometry" /></mxCell><mxCell id="e554" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c549" target="c550"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e555" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c550" target="c552"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e556" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c552" target="c553"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e557" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c550" target="c551"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e558" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c551" target="c549"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3535" y="6649" /><mxPoint x="3535" y="6554" /><mxPoint x="2815" y="6554" /><mxPoint x="2815" y="6583" /></Array></mxGeometry></mxCell><mxCell id="c561" value="기록기 시작 — 로봇 명단은 설정 파일에서 읽는다" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="6898" width="400" height="34" as="geometry" /></mxCell><mxCell id="c562" value="여러 소식을 한꺼번에 듣는다&#10;접근 상태 · 운송 상태 · 비상정지 · 대상 거리 · 대상 보임&#10;미션 · 개입 · 구역 사건 · 웹캠2 힌트" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="6956" width="400" height="60" as="geometry" /></mxCell><mxCell id="c563" value="구독 QoS 를 발행자와 맞춘다&#10;명령 · 상태 · 미션은 확실히 받는 쪽(RELIABLE)&#10;카메라 · 라이다 · 힌트는 빠른 쪽(BEST_EFFORT)&#10;잘못 잡으면 그 항목이 통째로 빈 채로 시연이 끝난다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="7040" width="400" height="74" as="geometry" /></mxCell><mxCell id="c564" value="소식이 올 때마다 한 줄씩 적는다&#10;시각 · 어디서 · 어느 로봇 · 무엇 · 값 · 좌표" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="7138" width="400" height="45" as="geometry" /></mxCell><mxCell id="c565" value="시각은 어느 것을 쓰는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="7207" width="400" height="50" as="geometry" /></mxCell><mxCell id="c566" value="벽시계를 섞지 않는다&#10;로봇 · 웹캠 · 관제 기록을 나중에 합쳐야 하기 때문이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="7281" width="400" height="45" as="geometry" /></mxCell><mxCell id="c567" value="기록 파일 — 사용자 홈의 kpi 폴더에 표 파일(CSV) 한 개&#10;ROS 노드가 아니다 — 이 노드가 파일에 직접 쓴다&#10;적는 열 — 시각 · 어디서 · 어느 로봇 · 무엇 · 값 · 좌표 x · 좌표 y · 덧붙임&#10;추종거리 · 놓침 · 리드타임 계산은 나중에 이 파일로 따로 한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="7350" width="400" height="74" as="geometry" /></mxCell><mxCell id="e568" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c561" target="c562"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e569" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c562" target="c563"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e570" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c563" target="c564"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e571" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c564" target="c565"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e572" value="ROS 시각만 쓴다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c565" target="c566"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e573" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c566" target="c567"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c578" value="/robot3  TurtleBot4 Standard&#10;바닥 · iRobot Create 3 — 구동 · 범퍼 · 낭떠러지 감지 · 도크 적외선&#10;　몸통 반지름 안쪽 0.175 m · 바깥 0.189 m · 최고 속도 0.3 m/s&#10;　범퍼와 낭떠러지 감지가 앞쪽에만 있다 → 후진을 쓰지 않는 근거&#10;라이다 · RPLIDAR A1 — 스캔 높이 바닥에서 18.5 cm&#10;카메라 · OAK-D Pro — 렌즈 높이 23.5 cm · 704×704 · 초당 10장&#10;　컬러와 거리를 같은 순간에 찍는다 (시각 차 0.1 ms 안팎)&#10;계산기 · Raspberry Pi 4 — 위 장치의 ROS 토픽을 발행한다&#10;　토픽 이름 앞에 /robot3 가 붙는다 · 도메인 3&#10;　통신은 PC-F 192.168.108.41 의 서버 한 대만 본다&#10;도크 · Create 3 도크 — 두 도크 사이 0.84 m · 한 번에 한 대만" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="7798" width="400" height="177" as="geometry" /></mxCell><mxCell id="c579" value="내보내는 것 (TurtleBot4 기본 토픽)&#10;oakd/rgb/image_raw/compressed · oakd/stereo/image_raw/compressedDepth&#10;oakd/rgb/camera_info · scan · battery_state · 바퀴가 돈 양&#10;　지도 위 위치는 로봇이 내지 않는다 — 제어 PC 의 위치 추정이 낸다&#10;도킹됐는지 여부 — 토픽이 아니라 물어보면 답한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="7999" width="400" height="104" as="geometry" /></mxCell><mxCell id="c580" value="받는 것&#10;cmd_vel · TwistStamped — 바퀴 속도 명령" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="8127" width="400" height="45" as="geometry" /></mxCell><mxCell id="c581" value="주행 계산은 로봇이 하지 않는다&#10;지도 · 위치 추정 · 경로 계획은 전부 제어 PC 에서 돈다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="8196" width="400" height="45" as="geometry" /></mxCell><mxCell id="e582" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c578" target="c579"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e583" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c579" target="c580"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e584" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c580" target="c581"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c589" value="/robot8  TurtleBot4 Standard&#10;바닥 · iRobot Create 3 — 구동 · 범퍼 · 낭떠러지 감지 · 도크 적외선&#10;　몸통 반지름 안쪽 0.175 m · 바깥 0.189 m · 최고 속도 0.3 m/s&#10;　범퍼와 낭떠러지 감지가 앞쪽에만 있다 → 후진을 쓰지 않는 근거&#10;라이다 · RPLIDAR A1 — 스캔 높이 바닥에서 18.5 cm&#10;카메라 · OAK-D Pro — 렌즈 높이 23.5 cm · 704×704 · 초당 10장&#10;　컬러와 거리를 같은 순간에 찍는다 (시각 차 0.1 ms 안팎)&#10;계산기 · Raspberry Pi 4 — 위 장치의 ROS 토픽을 발행한다&#10;　토픽 이름 앞에 /robot8 가 붙는다 · 도메인 3&#10;　통신은 PC-F 192.168.108.41 의 서버 한 대만 본다&#10;도크 · Create 3 도크 — 두 도크 사이 0.84 m · 한 번에 한 대만" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="8615" width="400" height="177" as="geometry" /></mxCell><mxCell id="c590" value="내보내는 것 (TurtleBot4 기본 토픽)&#10;oakd/rgb/image_raw/compressed · oakd/stereo/image_raw/compressedDepth&#10;oakd/rgb/camera_info · scan · battery_state · 바퀴가 돈 양&#10;　지도 위 위치는 로봇이 내지 않는다 — 제어 PC 의 위치 추정이 낸다&#10;도킹됐는지 여부 — 토픽이 아니라 물어보면 답한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="8816" width="400" height="104" as="geometry" /></mxCell><mxCell id="c591" value="받는 것&#10;cmd_vel · TwistStamped — 바퀴 속도 명령" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="8944" width="400" height="45" as="geometry" /></mxCell><mxCell id="c592" value="주행 계산은 로봇이 하지 않는다&#10;지도 · 위치 추정 · 경로 계획은 전부 제어 PC 에서 돈다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2884" y="9013" width="400" height="45" as="geometry" /></mxCell><mxCell id="e593" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c589" target="c590"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e594" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c590" target="c591"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e595" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c591" target="c592"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c600" value="바꿀 수 있는 값&#10;검출 확신도 하한 0.5  ·  색 지문 닮은 정도 기준 0.6&#10;지문 평균 창 최근 10장  ·  짝 확정 1초 연속 · 해제 3초 연속&#10;거리를 재는 네모 안쪽 비율 0.5  ·  화면 압축 품질 80  ·  재발행 1초마다&#10;로봇별로 다른 값 — 거리 보정 계수 (로봇마다 시차 편향이 다르다)&#10;　광역 설정을 먼저, 로봇별 설정을 나중에 읽어야 로봇별 값이 이긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="456" width="400" height="104" as="geometry" /></mxCell><mxCell id="c601" value="탐지 시작 — 켜지면 곧바로 돈다 (시작 신호는 없다)" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="584" width="400" height="34" as="geometry" /></mxCell><mxCell id="c602" value="컬러 한 장과 거리 한 장을 시각을 맞춰 한 쌍으로 묶는다&#10;시각 차 0.1초 안이면 같은 순간 · 최신 한 쌍만 남긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="642" width="400" height="45" as="geometry" /></mxCell><mxCell id="c603" value="카메라 내부값을 받았는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="711" width="400" height="50" as="geometry" /></mxCell><mxCell id="c604" value="이번 쌍은 버린다 — 거리를 잴 수 없다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5200" y="720" width="250" height="31" as="geometry" /></mxCell><mxCell id="c605" value="작업자 후보를 전부 찾는다&#10;파랑 세로줄 · 주황 가로줄 두 가지만 남기고 상대 로봇은 뺀다&#10;확신도 0.5 미만은 버린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="785" width="400" height="60" as="geometry" /></mxCell><mxCell id="c606" value="내 담당 기준값이 있는가?&#10;관제가 배정을 알려줬고 웹캠1 지문이 왔는가" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="869" width="400" height="57" as="geometry" /></mxCell><mxCell id="c607" value="확신도 1등을 대상으로 삼는다&#10;혼자 시험할 때의 뜻이 된다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5200" y="875" width="250" height="45" as="geometry" /></mxCell><mxCell id="c608" value="후보마다 네모 안 전체의 색 지문을 뽑는다&#10;웹캠1 과 같은 계산을 써야 비교가 성립한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="950" width="400" height="45" as="geometry" /></mxCell><mxCell id="c609" value="내 담당과 같은 복장의 후보가 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1019" width="400" height="50" as="geometry" /></mxCell><mxCell id="c610" value="이번 회차 실패 — 남의 옷만 보인다&#10;보임 = 거짓으로 내보낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5200" y="1022" width="250" height="45" as="geometry" /></mxCell><mxCell id="c611" value="기준 지문과 가장 닮은 후보 하나를 고른다&#10;둘 다 보여도 내 담당을 놓치지 않게" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1093" width="400" height="45" as="geometry" /></mxCell><mxCell id="c612" value="고른 후보의 지문을 최근 열 장 평균내 다시 잰다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1162" width="400" height="31" as="geometry" /></mxCell><mxCell id="c613" value="닮은 정도가 기준을 넘는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1217" width="400" height="50" as="geometry" /></mxCell><mxCell id="c614" value="평균 버퍼를 비운다&#10;남의 지문이 쌓여 내 담당이 돌아와도 못 알아보는 일을 막는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5200" y="1212" width="250" height="60" as="geometry" /></mxCell><mxCell id="c615" value="짝 확인 값을 시간 조건으로 갱신한다&#10;1초 넘게 연속 통과하면 참 · 3초 넘게 연속 실패면 거짓&#10;한 회차 깜빡임으로 바뀌지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1301" width="400" height="60" as="geometry" /></mxCell><mxCell id="c616" value="짝 확인과 작업자 번호를 내보낸다&#10;바뀐 순간 즉시 · 그 뒤로도 1초마다 다시" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1385" width="400" height="45" as="geometry" /></mxCell><mxCell id="c617" value="내 담당이 보이나를 매 회차 내보낸다&#10;놓침과 재획득을 세는 원천이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1454" width="400" height="45" as="geometry" /></mxCell><mxCell id="c618" value="네모 중심부 절반 영역의 거리 픽셀로 거리를 잰다&#10;측정 실패 픽셀은 빼고 하위 20 % 값을 쓴다 (배경이 섞이지 않게)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1523" width="400" height="45" as="geometry" /></mxCell><mxCell id="c619" value="거리를 믿을 수 있는가?&#10;중앙값과 하위값 차이가 15 cm 이내인가" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1592" width="400" height="57" as="geometry" /></mxCell><mxCell id="c620" value="이번 쌍의 거리·좌표는 버린다&#10;네모 안에 배경이나 다른 물체가 섞였다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5200" y="1598" width="250" height="45" as="geometry" /></mxCell><mxCell id="c621" value="네모 중심 픽셀과 거리로 카메라 기준 3차원 점을 만든다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1673" width="400" height="31" as="geometry" /></mxCell><mxCell id="c622" value="렌즈에서 몸통 중심까지의 직선거리를 내보낸다&#10;추종거리 채점의 기준값이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1728" width="400" height="45" as="geometry" /></mxCell><mxCell id="c623" value="지도 좌표로 바꿀 수 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1797" width="400" height="50" as="geometry" /></mxCell><mxCell id="c624" value="좌표는 내지 않는다 — 변환을 기다리지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5200" y="1800" width="250" height="45" as="geometry" /></mxCell><mxCell id="c625" value="지도 좌표로 바꾼 점을 내보낸다&#10;짝 확인이 거짓이어도 나간다 — 쓸지는 받는 쪽이 정한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1871" width="400" height="45" as="geometry" /></mxCell><mxCell id="c626" value="모니터 화면을 만들어 내보낸다 (검출이 없어도 매 쌍)&#10;왼쪽 컬러+네모 · 오른쪽 거리 색지도 · 위 띠에 상태" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="4770" y="1940" width="400" height="45" as="geometry" /></mxCell><mxCell id="e627" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c600" target="c601"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e628" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c601" target="c602"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e629" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c602" target="c603"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e630" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c603" target="c605"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e631" value="" style="edgeStyle=orthogonalEdgeStyle;rou