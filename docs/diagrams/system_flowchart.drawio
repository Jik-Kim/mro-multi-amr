" /></mxCell><mxCell id="e57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="952" y="1620" /><mxPoint x="952" y="572" /><mxPoint x="246" y="572" /><mxPoint x="246" y="601" /></Array></mxGeometry></mxCell><mxCell id="e58" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c59" value="내가 맡은 작업자 번호를 저장한다&#10;다른 로봇 것이면 버린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="998" y="456" width="400" height="45" as="geometry" /></mxCell><mxCell id="c60" value="그 번호의 색 지문을 짝짓기 기준값으로 건다&#10;복장이 바뀌면 지문 버퍼와 짝 확인을 초기화한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="998" y="525" width="400" height="45" as="geometry" /></mxCell><mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c59" target="c60"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c62" value="사람이 손으로 지은 짝을 푼다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2043" width="400" height="31" as="geometry" /></mxCell><mxCell id="c65" value="바꿀 수 있는 값&#10;유지할 거리 0.5 m  ·  바로 따라가기 시작하는 거리 1.0 m&#10;　멀면 남은 거리의 절반씩 좁힌다 — 회차 수를 정해두지 않는다&#10;놓침 판정 1.0초  ·  회전 탐색 시작 8초  ·  대기 상태로 물러나기 30초&#10;최고 속도 0.3 m/s (실제로는 길찾기 쪽 값이 이긴다)  ·  힌트를 믿는 시간 2초" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2174" width="400" height="104" as="geometry" /></mxCell><mxCell id="c66" value="찾는 중 — 로봇은 이미 작업자 쪽(서향)을 보고 서 있다&#10;로봇이 가는 것이 아니라 작업자가 로봇에게 온다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2302" width="400" height="45" as="geometry" /></mxCell><mxCell id="c67" value="인지가 준 지도 좌표가 두 번 연속 30 cm 안에서 맞는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2371" width="400" height="50" as="geometry" /></mxCell><mxCell id="c68" value="아직 목표로 삼지 않는다&#10;움직인 직후 2초 동안 온 좌표는 버린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="688" y="2373" width="250" height="45" as="geometry" /></mxCell><mxCell id="c69" value="짝 확인이 참인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2445" width="400" height="50" as="geometry" /></mxCell><mxCell id="c70" value="따라가지 않는다 — 짝이 확인될 때까지 기다린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="688" y="2447" width="250" height="45" as="geometry" /></mxCell><mxCell id="c71" value="남은 거리가 1.0 m 보다 가까운가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2519" width="400" height="50" as="geometry" /></mxCell><mxCell id="c72" value="남은 거리의 절반씩 좁혀 간다&#10;회차 수를 정해두지 않는다 — 하한에서 저절로 끝난다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2593" width="400" height="45" as="geometry" /></mxCell><mxCell id="c73" value="접근 중임을 알린다 (중간 목표 · 최종 목표)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2662" width="400" height="31" as="geometry" /></mxCell><mxCell id="c74" value="도착을 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2717" width="400" height="31" as="geometry" /></mxCell><mxCell id="c75" value="작업자 앞 0.5 m 를 유지하며 따라간다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2772" width="400" height="31" as="geometry" /></mxCell><mxCell id="c76" value="추종 중임을 알린다 — 추종거리 채점 구간은 여기뿐이다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2827" width="400" height="31" as="geometry" /></mxCell><mxCell id="c77" value="1초 넘게 안 보이는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2882" width="400" height="50" as="geometry" /></mxCell><mxCell id="c78" value="계속 따라간다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="688" y="2891" width="250" height="31" as="geometry" /></mxCell><mxCell id="c79" value="주행을 취소하고 제자리에서 기다린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="2956" width="400" height="31" as="geometry" /></mxCell><mxCell id="c80" value="8초가 지났는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="3011" width="400" height="50" as="geometry" /></mxCell><mxCell id="c81" value="그 자리에서 기다린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="688" y="3020" width="250" height="31" as="geometry" /></mxCell><mxCell id="c82" value="웹캠2 힌트 방향으로 제자리 회전해 다시 찾는다&#10;힌트는 작업자 번호가 내 담당과 같을 때만 쓴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="3085" width="400" height="45" as="geometry" /></mxCell><mxCell id="c83" value="30초 안에 다시 보였는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="3154" width="400" height="50" as="geometry" /></mxCell><mxCell id="c84" value="대기 상태로 물러난다&#10;대기로 끝난 재획득은 실패로 센다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="258" y="3228" width="400" height="45" as="geometry" /></mxCell><mxCell id="e85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c65" target="c66"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c66" target="c67"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e87" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source=