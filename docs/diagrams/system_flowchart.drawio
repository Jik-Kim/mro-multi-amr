tSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6235" width="400" height="74" as="geometry" /></mxCell><mxCell id="c819" value="진행 중이던 이동을 취소한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6333" width="400" height="31" as="geometry" /></mxCell><mxCell id="c820" value="복귀 중임을 알린다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6388" width="400" height="31" as="geometry" /></mxCell><mxCell id="c821" value="도크 구역 토큰을 먼저 얻는다&#10;대기 자리가 좁은 목 바깥이라 순서가 이쪽이 먼저다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6443" width="400" height="45" as="geometry" /></mxCell><mxCell id="c822" value="도크 토큰을 얻었는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6512" width="400" height="50" as="geometry" /></mxCell><mxCell id="c823" value="좁은 목 바깥 대기 자리로 가서 기다린다&#10;못 얻은 로봇은 애초에 좁은 목에 들어가지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="6507" width="250" height="60" as="geometry" /></mxCell><mxCell id="c824" value="좁은 목(P1) 토큰을 얻는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6596" width="400" height="31" as="geometry" /></mxCell><mxCell id="c825" value="좁은 목 토큰을 얻었는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6651" width="400" height="50" as="geometry" /></mxCell><mxCell id="c826" value="그 자리에서 기다렸다 다시 묻는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="6661" width="250" height="31" as="geometry" /></mxCell><mxCell id="c827" value="자기 도크 정면 접근 지점으로 이동한다&#10;도착이 곧 좁은 목 통과 완료다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6725" width="400" height="45" as="geometry" /></mxCell><mxCell id="c828" value="좁은 목 토큰을 돌려준다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6794" width="400" height="31" as="geometry" /></mxCell><mxCell id="c829" value="도킹을 시작한다 — 도크 간격이 0.84 m 뿐이라 접근 지점을 반드시 거친다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6849" width="400" height="31" as="geometry" /></mxCell><mxCell id="c830" value="도킹에 성공했는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6904" width="400" height="50" as="geometry" /></mxCell><mxCell id="c831" value="재시도 횟수가 남았는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="6978" width="400" height="50" as="geometry" /></mxCell><mxCell id="c832" value="실패로 알린다 — 포기할 때만 낸다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5430" y="6988" width="250" height="31" as="geometry" /></mxCell><mxCell id="c833" value="접근 지점으로 되돌아가 다시 시도한다&#10;후진은 쓰지 않는다 (뒤를 보는 감지기가 없다)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="7052" width="400" height="45" as="geometry" /></mxCell><mxCell id="c834" value="도킹 완료를 알린다 — 운용시간의 끝이다&#10;성공 직후 준비 상태를 내지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="7121" width="400" height="45" as="geometry" /></mxCell><mxCell id="c835" value="성공이든 실패든 도크 토큰을 반드시 돌려준다&#10;안 돌려주면 그 구역이 영영 잠긴다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="5000" y="7190" width="400" height="45" as="geometry" /></mxCell><mxCell id="e836" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c818" target="c819"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e837" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontCo