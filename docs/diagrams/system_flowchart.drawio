929" width="400" height="60" as="geometry" /></mxCell><mxCell id="c487" value="실행 구조&#10;ROS 쪽과 웹 서버가 서로 다른 스레드에서 돈다&#10;웹 요청이 오면 관제에 ROS 서비스를 부르고 그 답을 화면에 돌려준다&#10;아레나 지도 그림도 같이 띄운다 (경로는 설정에서 읽는다)&#10;보여 주는 로봇 목록과 짝 상태 세 가지(짝지어짐 · 게이트 미달 · 대상 없음)는 설정으로 둔다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5013" width="400" height="104" as="geometry" /></mxCell><mxCell id="c488" value="웹 대시보드 시작" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5141" width="400" height="34" as="geometry" /></mxCell><mxCell id="c489" value="로봇별 최신 상태를 화면에 표시한다&#10;상태 · 배터리 · 위치 · 미션 · 작업자 · 비상정지 · 짝" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5199" width="400" height="45" as="geometry" /></mxCell><mxCell id="c490" value="운영자가 누른 것은?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5268" width="400" height="50" as="geometry" /></mxCell><mxCell id="c491" value="관제에 서비스로 물어본다&#10;자재 요청 · 작업 종료 · 짝 지정 중 하나" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5342" width="400" height="45" as="geometry" /></mxCell><mxCell id="c492" value="관제가 어느 갈래로 처리하는지는 명령 종류가 정한다&#10;자재 요청은 미션을 새로 만들고, 종료·짝 지정은 운영자 개입으로 기록한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5411" width="400" height="45" as="geometry" /></mxCell><mxCell id="c493" value="관제가 받아들였는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5480" width="400" height="50" as="geometry" /></mxCell><mxCell id="c494" value="거절 이유를 화면에 표시&#10;이번 요청은 여기서 끝" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3174" y="5483" width="250" height="45" as="geometry" /></mxCell><mxCell id="c495" value="결과를 화면에 표시한다 (미션 번호 · 성공 여부)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5554" width="400" height="31" as="geometry" /></mxCell><mxCell id="c496" value="짝 지정이 성공하면 개입 사실을 한 번 알린다&#10;채점에서 사람 손이 들어간 횟수로 센다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2744" y="5609" width="400" height="45" as="geometry" /></mxCell><mxCell id="e497" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c486" target="c487"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e498" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c487" target="c488"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e499" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c488" target="c489"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e500" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c489" target="c490"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e501" value="세 가지 중 하나" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c490" target="c491"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e502" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c491" target="c492"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e503" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c492" target="c493"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e504" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c493" target="c495"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e505" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c495" target="c496"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e506" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c493" target="c494"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e507" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c494" target="c488"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3445" y="5505" /><mxPoint x="3445" y="5129" /><mxPoint x="2725" y="5129" /><mxPoint x="2725" y="5158" /></Array></mxGeometry></mxCell><mxCell id="c510" value="구역 잠금 서버가 돈다&#10;구역은 둘뿐 — P1 병목(폭 0.79 m) · DOCK 도크" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E4ECF7;strokeColor=#3B6CA8;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="5754" width="400" height="45" as="geometry" /></mxCell><mxCell id="c511" value="로봇이 구역 안에 있는지 좌표로 계산하지 않는다&#10;「들어가기 직전에 얻고 나온 직후에 돌려준다」는 순서만 지키면 된다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="5823" width="400" height="45" as="geometry" /></mxCell><mxCell id="c512" value="바꿀 수 있는 값&#10;억지 회수까지 기다리는 시간 60초 — 정상 통과는 10~20초 (좁은 목 이동만 3~9초)&#10;감시 주기 1초  ·  로봇이 다시 물어보는 주기 2초 (로봇 쪽에서 정한다)&#10;구역 이름은 아레나 설정 파일의 목록과 반드시 같아야 한다&#10;되살리는 신호(하트비트) 규칙은 두지 않는다 — 계약에 없다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EFEFEF;strokeColor=#777777;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="5892" width="400" height="104" as="geometry" /></mxCell><mxCell id="c513" value="아는 구역 이름인가?&#10;요청 = 로봇 이름 · 구역 이름 · 얻기인지 돌려주기인지" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6020" width="400" height="57" as="geometry" /></mxCell><mxCell id="c514" value="거절로 답한다 — 이번 요청은 여기서 끝" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2804" y="6033" width="250" height="31" as="geometry" /></mxCell><mxCell id="c515" value="얻으러 온 요청인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6101" width="400" height="50" as="geometry" /></mxCell><mxCell id="c516" value="구역이 비었거나 이미 내가 가지고 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6175" width="400" height="50" as="geometry" /></mxCell><mxCell id="c517" value="나보다 먼저 기다린 로봇이 있는가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6249" width="400" height="50" as="geometry" /></mxCell><mxCell id="c518" value="대기 명단에서 나온다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6323" width="400" height="31" as="geometry" /></mxCell><mxCell id="c519" value="이번에 처음 얻는 것인가?" style="rhombus;rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FFF6E0;strokeColor=#C88A00;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6378" width="400" height="50" as="geometry" /></mxCell><mxCell id="c520" value="가진 시각을 다시 적지 않는다&#10;다시 물을 때마다 고치면 60초 회수를 무한정 미룰 수 있다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#FDECEC;strokeColor=#C0272D;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2804" y="6373" width="250" height="60" as="geometry" /></mxCell><mxCell id="c521" value="가지기 시작한 시각을 적는다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#EEF4FD;strokeColor=#5B87C4;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6462" width="400" height="31" as="geometry" /></mxCell><mxCell id="c522" value="얻었다고 알리고 답한다" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Malgun Gothic;fontSize=11;fillColor=#E8F0FE;strokeColor=#1F5FBF;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2374" y="6517" width="400" height="31" as="geometry" /></mxCell><mxCell id="e523" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c510" target="c511"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e524" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c511" target="c512"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e525" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A4A4A;strokeWidth=1.4;fontFamily=Malgun Gothic;fontSize=10;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;endArrow=block;endFill=1;endSize=6;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entry