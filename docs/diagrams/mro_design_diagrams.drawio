ll><mxCell id="STEP3-2 전체 흐름_f_86" value="카메라 · 힌트 = BEST_EFFORT" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="2464" y="1065" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_87" value="주행 게이트" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="1281" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_88" value="· P1 토큰 — 베이 출발 전 획득, 대기공간 도착 후 반납 (방법 B, 순서 기반)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="38" y="1305" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_89" value="· 거절되면 2 s 후 재요청 · 60 s 초과 보유는 세마포어가 강제 회수 (RECLAIM)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="38" y="1325" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_90" value="· 받았든 못 받았든 반드시 반납한다 — 안 하면 대기열에 남아 P1 이 잠긴다 (I-033)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="38" y="1345" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_91" value="· estop true 동안 주행 명령 금지 · cmd_vel 0 이 Nav2 출력을 덮어쓴다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="38" y="1365" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_92" value="· T_lim 120 s 초과 → 미션 폐기 · 늦은 도착은 arrived_late 로 따로 기록" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="38" y="1385" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_93" value="· 도크 간격 0.84 m — DOCK 토큰으로 한 대씩 (E-7 순차 도킹)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="38" y="1405" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_94" value="판정 게이트  (KPI 기준점)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1758" y="1281" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_95" value="· AC-08 배송 성공 — shuttle/status = WAITING 이 도착 확정 시각. 미션당 1회" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1758" y="1305" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_96" value="· K-05 리드타임 — 요청 created_at → WAITING. DONE(도킹 완료)과 다르다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1758" y="1325" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_97" value="· AC-05 추종거리 — FOLLOWING 구간만. Nav2 도착 오차 0.25 는 판정에서 뺀다 (I-029)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1758" y="1345" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_98" value="· K-04 재획득 — target/visible 1→0 이 1.0 s 이상. STANDBY 면 포기로 센다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1758" y="1365" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_99" value="· K-06 교착 — REJECT → GRANT 60 s. 그 사이 그 구역에 RECLAIM 이 있으면 미해결" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1758" y="1385" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_100" value="· AC-13 IPH — 개입 ÷ (undock ~ DOCKED). 안전 정지 뒤 자동 재개는 개입이 아니다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1758" y="1405" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_101" value="읽는 법" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="26" y="1477" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_102" value="토픽  Topic" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="88" y="1503" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_103" value="서비스  Service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="248.7" y="1503" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_104" value="액션  Action" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="432.6" y="1503" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_105" value="안전 경로  (토픽이지만 따로 표시)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="599.4" y="1503" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_106" value="PC 는 상자 채움색으로 나눈다 — 파랑 로봇3 · 보라 로봇4 · 주황 관제 · 초록 웹캠 · 회색 온보드. 테두리는 전부 회색이라 화살표 색과 섞이지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="26" y="1531" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_107" value="화살표 위 상자 — 첫 줄이 토픽 · 서비스 · 액션 이름, 둘째 줄이 메시지 타입과 방향이다. PC 를 넘는 것은 전부 가운데 DDS 버스를 지난다 — 직접 호출도 소켓도 없다 (NR-06)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="26" y="1551" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_108" value="robot4 는 robot3 과 구성이 같다. 두 대가 만나는 곳은 zone_semaphore 의 P1 · DOCK 토큰뿐이고, 그 경합이 E-3 교착과 E-7 순차 도킹이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="26" y="1571" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_f_109" value="생성: tools/build_diagrams.py   ·   근거: docs/architecture.md, docs/interfaces.md, SDD 2.4 FR 표" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="26" y="1593" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step3c_ros_graph" name="STEP3-3 ROS 그래프"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2892" pageHeight="1322" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP3-3 ROS 그래프_t_1" value="STEP 3-3 — ROS 계산 그래프 (노드 · 토픽 · 서비스 · 액션)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="2844" height="30" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_t_2" value="타원 = 노드 · 네모 = 토픽 · 육각 = 서비스 · 점선묶음 = 액션  |  화살표 색 = 통신 종류 (파랑 토픽 · 주황 서비스 · 보라 액션 · 빨강 안전)  |  토픽 이름·타입은 계약 4절에서 읽어 그린다  |  로봇 열은 /robot3 · /robot4 둘 다 같다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="2844" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_n_3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="18" y="122" width="296" height="160" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_n_4" value="&lt;b&gt;&lt;font color=&quot;#1E6B40&quot;&gt;webcam_register&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;작업자 등록 (S1) ≤ 10 s&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C4A8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="32" y="130" width="268" height="54" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_n_5" value="&lt;b&gt;&lt;font color=&quot;#1E6B40&quot;&gt;webcam_hint&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;작업자 힌트 10 Hz&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C4A8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="32" y="220" width="268" height="54" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_n_6" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="18" y="328" width="296" height="250" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_n_7" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;OAK-D Pro&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;704×704 crop · 렌즈 23.5 cm&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="32" y="336" width="268" height="54" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_n_8" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;RPLIDAR A1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scan 10 Hz · 높이 18.5 cm&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="32" y="426" width="268" height="54" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_n_9" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;Create3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;구동 · 범퍼·클리프는 전방만&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeom