exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_15" target="STEP2 Nav2 스택_n_23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="569"/><mxPoint x="744" y="673"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_40" value="⑭" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_22" target="STEP2 Nav2 스택_n_13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="583.5"/><mxPoint x="710" y="352.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_41" value="⑮" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_19" target="STEP2 Nav2 스택_n_24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_42" value="⑯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_24" target="STEP2 Nav2 스택_n_25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_43" value="⑰" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=2.2;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_16" target="STEP2 Nav2 스택_n_25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="673.5"/><mxPoint x="730" y="742"/><mxPoint x="1212" y="742"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_44" value="⑱" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_16" target="STEP2 Nav2 스택_n_14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="348" y="673.5"/><mxPoint x="348" y="472"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_f_45" value="생성: tools/build_diagrams.py   ·   원본 근거: docs/architecture.md, docs/interfaces.md 4절, SDD 3.2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="24" y="1007" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step3_scenario" name="STEP3 시나리오"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="2011" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP3 시나리오_t_1" value="STEP 3 — 운영 시나리오 S1~S10 흐름과 예외 처리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1272" height="30" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_t_2" value="가운데가 정상 흐름 · 왼쪽은 수행 노드 · 오른쪽은 예외와 그때의 처리 · SDD 3.3 / BRD 3.2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1272" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_3" value="<b><font color="#1B4F91">S1  진입 · 등록</font></b><br><font style="font-size:10px">작업자가 관제 구역에 들어서면 웹캠1 이 외형을 등록하고</font><br><font style="font-size:10px">로봇 한 대를 배정한다  ·  등록 완료 ≤ 10 초</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="104" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_4" value="<b><font color="#333840">webcam_register  (PC-W1)</font></b><br><font style="font-size:10px">→ fleet_manager  (PC-F)</font><br><font style="font-size:10px">/webcam1/worker_descriptor</font><br><font style="font-size:10px">HSV 히스토그램 H16 × S8 = 128</font><br><font style="font-size:10px">벨트 위 상의 영역만 쓴다</font><br><font style="font-size:10px">담당 한세교 · 김학민</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="104" width="320" height="112" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_5" value="<b><font color="#8E2A1F">두 작업자의 서술자가 너무 비슷할 때</font></b><br><font style="font-size:10px">같은 인형끼리의 유사도와 다른 인형끼리의 유사도 분포가 겹치면</font><br><font style="font-size:10px">서술자 자체를 손봐야 한다는 신호다. 조명을 맞추고 다시 등록한다.</font><br><font style="font-size:10px">상의 색 두 가지는 휘도를 맞춰 인쇄해 색만으로 갈리게 한다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="104" width="456" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_6" value="<b><font color="#1B4F91">S2  준비</font></b><br><font style="font-size:10px">배정된 로봇이 도크에서 빠져나와 대기 상태가 된다</font><br><font style="font-size:10px">undock  →  shuttle/status = READY</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="242" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_7" value="<b><font color="#333840">fleet_manager → shuttle_mission</font></b><br><font style="font-size:10px">opennav_docking  undock</font><br><font style="font-size:10px">기동할 때 자신의 dock_pose 로</font><br><font style="font-size:10px">AMCL 초기 위치를 설정한다</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="242" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_8" value="<b><font color="#8E2A1F">두 로봇의 맵 좌표계가 어긋나는 사고  (I-013)</font></b><br><font style="font-size:10px">각 로봇이 (0,0) 으로 초기화하면 같은 좌표가 서로 다른 장소를</font><br><font style="font-size:10px">가리키게 되어 세마포어도 waypoint 도 전부 무의미해진다.</font><br><font style="font-size:10px">→ 맵 원점은 SLAM 작성 시점 하나로 고정하고, 각 로봇은</font><br><font style="font-size:10px">   arena.yaml 의 dock_zone.pose 값으로 초기화한다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="242" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_9" value="<b><font color="#1B4F91">S3  자재 요청</font></b><br><font style="font-size:10px">관제 UI 에서 작업자와 창고 베이를 골라 요청한다</font><br><font style="font-size:10px">RequestMission → Mission(ASSIGNED)  ·  접수 ≤ 2 초</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="365" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_10" value="<b><font color="#333840">control_ui  (Flask :5000)</font></b><br><font style="font-size:10px">→ fleet_manager</font><br><font style="font-size:10px">mission/assigned 발행</font><br><font style="font-size:10px">담당 김민준</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="365" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_11" value="<b><font color="#6F5610">P1 병목 토큰을 얻었는가?</font></b><br><font style="font-size:10px">도크 ↔ 창고 통로 0.79 m · 한 번에 한 대만</font>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="473" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_12" value="<b><font color="#333840">zone_semaphore  (PC-F 실행)</font></b><br><font style="font-size:10px">srv/ZoneToken  acquire</font><br><font style="font-size:10px">패키지는 관제, 소유는 주행</font><br><font style="font-size:10px">담당 박병후 · 이시율</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="473" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_13" value="<b><font color="#8E2A1F">E-3  교착 회피</font></b><br><font style="font-size:10px">거절되면 2 초 뒤 다시 요청한다. 폴리곤에 들어가기 전에 얻고,</font><br><font style="font-size:10px">완전히 빠져나온 뒤에 반납한다. 60 초를 넘겨 쥐고 있으면</font><br><font style="font-size:10px">세마포어가 강제로 회수하고 이벤트를 남긴다.</font><br><font style="font-size:10px">S4 갈 때와 S10 돌아올 때 두 번 통과하므로 교착을 여기서 본다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="473" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_14" value="<b><font color="#1B4F91">S4  셔틀 주행</font></b><br><font style="font-size:10px">창고 베이 A / B / C 의 고정 waypoint 로 이동한다</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="596" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_15" value="<b><font color="#333840">shuttle_mission</font></b><br><font style="font-size:10px">Nav2  navigate_to_pose</font><br><font style="font-size:10px">arena.yaml 의 베이 waypoint</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="596" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_16" value="<b><font color="#6F5610">베이 ArUco ID 가 일치하는가?</font></b><br><font style="font-size:10px">거리 ≤ 1.5 m · 정면 ±30°</font>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="689" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_17" value="<b><font color="#333840">aruco_detector</font></b><br><font style="font-size:10px">aruco/id · aruco/distance</font><br><font style="font-size:10px">ID 1/2/3 = 베이 A/B/C</font><br><font style="font-size:10px">선반 뒤 벽면, 높이 20 cm</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="689" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_18" value="<b><font color="#8E2A1F">도착 판정 실패</font></b><br><font style="font-size:10px">다시 접근해 읽는다. T_lim 120 초를 넘기면 미션을 FAILED 로</font><br><font style="font-size:10px">확정하고 운영자에게 알린다. 늦게라도 도착한 사실은</font><br><font style="font-size:10px">arrived_late 로 따로 남겨 성공으로 이중 계상하지 않는다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="689" width="456" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_19" value="<b><font color="#1B4F91">S4′  적재 · 합류 지점 이동</font></b><br><font style="font-size:10px">베이에서 5 초 체류한 뒤 대기공간(Z-05)으로 이동하고</font><br><font style="font-size:10px">P1 토큰을 반납한다  ·  shuttle/arrived 발행</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="797" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_20" value="<b><font color="#333840">shuttle_mission</font></b><br><font style="font-size:10px">zone_semaphore  release</font><br><font style="font-size:10px">실패해도 토큰은 반드시 반납한다</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="797" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_21" value="<b><font color="#6F5610">재식별 게이트를 통과했는가?</font></b><br><font style="font-size:10px">외형 유사도 ≥ reid_threshold</font>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="890" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_22" value="<b><font color="#333840">amr_detection  (재식별)</font></b><br><font style="font-size:10px">core/reid.hsv_hist() 공유 함수</font><br><font style="font-size:10px">target/paired · target/worker_id</font><br><font style="font-size:10px">담당 정정인 · 민범진</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="890" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_23" value="<b><font color="#8E2A1F">E-2  엉뚱한 사람을 따라가지 않기</font></b><br><font style="font-size:10px">임계에 못 미치면 페어링하지 않고 그 자리에서 대기한다.</font><br><font style="font-size:10px">잘못된 작업자를 따라가는 일은 0 건이 절대 기준이라,</font><br><font style="font-size:10px">확신이 없을 때 멈추는 쪽이 항상 옳다.</font><br><font style="font-size:10px">폴백 — 관제 UI 에서 운영자가 대상을 수동으로 지정한다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="890" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_24" value="<b><font color="#1B4F91">S5  합류</font></b><br><font style="font-size:10px">배정된 작업자를 확인하고 접근한다</font><br><font style="font-size:10px">APPROACH_1 → APPROACH_2 → ARRIVED</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1013" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_25" value="<b><font color="#333840">follow_target</font></b><br><font style="font-size:10px">approach/status</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1013" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_26" value="<b><font color="#1B4F91">S6 ~ S8  추종</font></b><br><font style="font-size:10px">중앙 복도(P3 0.93 m)를 지나 작업공간까지 따라간다</font><br><font style="font-size:10px">간격 0.5 m 유지  ·  approach/status = FOLLOWING</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1106" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_27" value="<b><font color="#333840">follow_target</font></b><br><font style="font-size:10px">Nav2  navigate_to_pose</font><br><font style="font-size:10px">추종 경로에는 토큰을 두지 않는다</font><br><font style="font-size:10px">(기다리다 작업자를 놓치기 때문)</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1106" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_28" value="<b><font color="#6F5610">대상을 놓쳤는가?  (Target Lost)</font></b>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1214" width="380" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_29" value="<b><font color="#333840">amr_detection → follow_target</font></b><br><font style="font-size:10px">target/visible = false</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1214" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_30" value="<b><font color="#8E2A1F">E-1  재탐지</font></b><br><font style="font-size:10px">작업공간 안이면 웹캠2 힌트가 있다 → 그 방향으로 회전 탐색.</font><br><font style="font-size:10px">중앙 복도는 웹캠2 시야 밖이라 힌트가 없다 → 제자리 탐색.</font><br><font style="font-size:10px">두 조건의 재획득 시간을 비교하는 것이 시험 TS-19 다.</font><br><font style="font-size:10px">T_lim 을 넘기면 STANDBY 로 들어가 운영자를 기다린다.</font><br><font style="font-size:10px">가림은 교차하는 다른 작업자(RC카 2호)로 만든다 —</font><br><font style="font-size:10px">벽으로 만들면 웹캠2 의 바닥 시야까지 함께 막힌다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="1214" width="456" height="127" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_31" value="<b><font color="#6F5610">전방 0.30 m 안에 장애물이 있는가?</font></b>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1367" width="380" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_32" value="<b><font color="#333840">safety_watchdog  (온보드)</font></b><br><font style="font-size:10px">scan 만 구독 · 전방 ±35°</font><br><font style="font-size:10px">어느 단계에서든 항상 동작한다</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1367" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_33" value="<b><font color="#8E2A1F">E-4  안전 정지</font></b><br><font style="font-size:10px">safety/estop 을 올리고 cmd_vel 에 0 을 20 Hz 로 덮어쓴다.</font><br><font style="font-size:10px">0.45 m 밖으로 벗어나면 스스로 재개한다.</font><br><font style="font-size:10px">이 정지는 사람이 개입한 것이 아니므로 개입 지표(IPH)에</font><br><font style="font-size:10px">계상하지 않는다. 웹캠이나 Wi-Fi 가 죽어도 이 경로는 살아 있다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="1367" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_34" value="<b><font color="#8A4F0B">S9  작업 종료 발행</font></b><br><font style="font-size:10px">작업자가 종료 버튼을 누르면 추종을 즉시 멈춘다</font><br><font style="font-size:10px">RETURN / RETURN_ALL → mission/finish → 페어링 해제 ≤ 1 초</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF3E3;strokeColor=#B06810;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1490" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_35" value="<b><font color="#333840">control_ui → fleet_manager</font></b><br><font style="font-size:10px">→ follow_target  (즉시 중단)</font><br><font style="font-size:10px">→ return_dock  (복귀 시작)</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1490" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_36" value="<b><font color="#6F5610">복귀 통로와 도크 토큰을 얻었는가?</font></b><br><font style="font-size:10px">P1 통과 → DOCK 은 한 번에 한 대</font>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1583" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_37" value="<b><font color="#333840">return_dock</font></b><br><font style="font-size:10px">zone_semaphore  P1 · DOCK</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1583" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_38" value="<b><font color="#8E2A1F">E-7  순차 도킹</font></b><br><font style="font-size:10px">도크 두 대의 중심 간격이 0.9 m 뿐이라 두 대가 동시에 들어가면</font><br><font style="font-size:10px">IR 신호가 서로 간섭한다. DOCK 토큰으로 한 대씩 들여보내고</font><br><font style="font-size:10px">나머지는 홀딩 포인트에서 기다린다.</font><br><font style="font-size:10px">도크 사이에는 MDF 차폐판을 세운다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="1583" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_39" value="<b><font color="#1B4F91">S10  도킹</font></b><br><font style="font-size:10px">자기 도크 정면의 접근 지점을 거쳐 도킹한다</font><br><font style="font-size:10px">opennav_docking  dock</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1706" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_40" value="<b><font color="#333840">return_dock</font></b><br><font style="font-size:10px">T_ret 180 초 · 재시도 2회</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1706" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_41" value="<b><font color="#6F5610">도킹에 성공했는가?</font></b>" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1799" width="380" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_42" value="<b><font color="#333840">shuttle/status 로 보고</font></b>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1799" width="320" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_43" value="<b><font color="#8E2A1F">도킹 실패</font></b><br><font style="font-size:10px">최대 2회까지 다시 시도한다. 그래도 안 되면 FAILED 를 발행하고</font><br><font style="font-size:10px">멈춘다. 성공이든 실패든 DOCK 토큰은 반드시 반납한다 —</font><br><font style="font-size:10px">반납하지 않으면 다른 로봇이 영영 들어오지 못한다.</font>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="1799" width="456" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_44" value="<b><font color="#1E6B40">DOCKED  ·  Phase 1 종료</font></b><br><font style="font-size:10px">두 대 모두 도킹 완료 · KPI 로그 확정</font>" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DFF0E6;strokeColor=#2E8B57;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1907" width