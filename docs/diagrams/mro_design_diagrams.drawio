<mxfile host="app.diagrams.net" type="device"><diagram id="step1_deployment" name="STEP1 배치도"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="815" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP1 배치도_t_1" value="STEP 1 — 시스템 배치도 (PC 5대 · AMR 2대 · 네트워크)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1232" height="30" as="geometry"/></mxCell><mxCell id="STEP1 배치도_t_2" value="MRO Multi-AMR Phase 1 · 2026-09-05 구성 확정 및 검증 완료 · SDD 3.1" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1232" height="20" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_3" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#5A5F6A&quot;&gt;&lt;b&gt;무선망 SSID turtle08   ·   ROS_DOMAIN_ID = 3   ·   RMW = rmw_fastrtps_cpp   ·   전송 = Fast DDS Discovery Server 방식 (멀티캐스트 미사용)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="24" y="70" width="1232" height="34" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_4" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;PC-W1 — 웹캠1 PC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Ubuntu 24.04 · ROS 2 Jazzy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;pkg  mro_webcam&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• webcam_register&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;   작업자 등록 · 외형 서술자 발행&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;USB 웹캠 640×480 (출입구 시야)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;ROS_SUPER_CLIENT = False&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;담당  한세교 · 김학민&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="126" width="236" height="142" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_5" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;PC-W2 — 웹캠2 PC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Ubuntu 24.04 · ROS 2 Jazzy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;pkg  mro_webcam&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• webcam_hint&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;   재탐지 방위 힌트 · KPI 계측&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;USB 웹캠 640×480 (작업공간 남단)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;ROS_SUPER_CLIENT = False&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;담당  한세교 · 김학민&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="273" y="126" width="236" height="142" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_6" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;PC-F — 관제 PC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Ubuntu 24.04 · Jazzy · GPU 불필요&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;IP 192.168.108.41/24 (고정)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;★ Fast DDS Discovery Server&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;    서버 ID 1 · UDP 11811&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;pkg  mro_fleet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• fleet_manager   • zone_semaphore&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• control_ui (Flask :5000)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• kpi_logger · SQLite&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;담당  김민준&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FDF3E3;strokeColor=#B06810;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="522" y="126" width="236" height="172" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_7" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;PC-R3 — 로봇3 제어 PC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Ubuntu 24.04 · Jazzy · NVIDIA GPU&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Nav2 + AMCL + RViz2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;pkg  mro_perception&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• amr_detection  • aruco_detector&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;pkg  mro_navigation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• shuttle_mission  • follow_target&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• return_dock  • safety_watchdog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;namespace = /robot3&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="771" y="126" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_8" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;PC-R4 — 로봇4 제어 PC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Ubuntu 24.04 · Jazzy · NVIDIA GPU&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Nav2 + AMCL + RViz2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;pkg  mro_perception&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• amr_detection  • aruco_detector&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;pkg  mro_navigation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• shuttle_mission  • follow_target&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;• return_dock  • safety_watchdog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;namespace = /robot4&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1020" y="126" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_9" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;ROS_DISCOVERY_SERVER = &quot;;192.168.108.41:11811&quot;      ← 앞의 세미콜론 하나가 &quot;서버 ID 1&quot; 을 뜻한다. 5대 PC + 로봇 2대가 모두 같은 값을 쓴다.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;이 경로로 오가는 것은 참가자·토픽 탐색 정보뿐이다. 실제 토픽 데이터는 발행 노드와 구독 노드 사이를 직접(P2P) 흐르므로 PC-F 를 거치지 않는다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FDF3E3;strokeColor=#B06810;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="402" width="1232" height="52" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_10" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;robot3 — TurtleBot4 Standard&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Raspberry Pi 4B · Ubuntu 24.04&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;turtlebot4_bringup · _node&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;depthai_ros_driver → OAK-D Pro&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;rplidar_ros → RPLIDAR A1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;iRobot Create3 (범퍼·클리프·도크)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;onboard Discovery ID 3 — 남겨두되&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;PC 의 접속 목록에는 넣지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Offboard IP → 192.168.108.41&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="771" y="512" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_11" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;robot4 — TurtleBot4 Standard&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Raspberry Pi 4B · Ubuntu 24.04&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;turtlebot4_bringup · _node&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;depthai_ros_driver → OAK-D Pro&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;rplidar_ros → RPLIDAR A1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;iRobot Create3 (범퍼·클리프·도크)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;onboard Discovery ID 4 — 남겨두되&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;PC 의 접속 목록에는 넣지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Offboard IP → 192.168.108.41&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1020" y="512" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_12" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;읽는 법 · 확인 상태&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;─── 주황 실선 = 디스커버리 등록 경로. 모든 참가자가 PC-F 의 서버 하나에만 등록한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;      토픽 데이터 경로는 P2P 라서 이 그림에 선으로 그리지 않는다 (STEP 2 가 그 내용이다).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;[검증됨] 2026-09-05 — PC 5대와 로봇 2대를 모두 붙인 뒤 각 PC 에서 /robot3 · /robot4 토픽이&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;      동시에 보이는 것을 확인했다. 통신 구성은 이 상태로 확정한다 (SDD NR-01).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;이 구조를 택한 이유 — 종전에는 로봇의 라즈베리파이가 디스커버리 허브를 겸했다. PC 가 늘어날수록&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;      RPi 가 병목이 되고, 로봇 2대면 PC 마다 서버 두 곳을 동시에 봐야 해서 설정이 갈라진다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;      서버를 관제 노트북 한 대로 빼면 RPi 는 자기 센서 처리에만 쓰이고, 모든 PC 의 설정이 한 줄로 같아진다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;웹캠 PC 와 nav2 터미널은 ROS_SUPER_CLIENT = False 로 둔다. 전체 토픽 목록이 필요한 도구&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;      (ros2 topic list, RViz 탐색)를 쓸 때만 True 가 필요하고, 상시 True 는 불필요한 트래픽을 만든다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;고정 IP 192.168.108.41 은 공유기 DHCP 예약이 아직 걸려 있지 않다 → 강사님께 예약 요청 필요.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="512" width="723" height="247" as="geometry"/></mxCell><mxCell id="STEP1 배치도_e_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_4" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="142" y="335"/><mxPoint x="640" y="335"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_5" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="391" y="335"/><mxPoint x="640" y="335"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_6" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_7" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="889" y="342.5"/><mxPoint x="640" y="342.5"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_8" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1138" y="342.5"/><mxPoint x="640" y="342.5"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_10" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="889" y="483"/><mxPoint x="640" y="483"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_11" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1138" y="483"/><mxPoint x="640" y="483"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_f_20" value="생성: tools/build_diagrams.py   ·   원본 근거: docs/setup.md, docs/architecture.md, SDD 2.3 NR-01" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="17" y="768" width="481.6" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step2_nav2" name="STEP2 Nav2 스택"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1055" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP2 Nav2 스택_t_1" value="STEP 2 — 로봇 1대(/robotN) 내부 구성과 Nav2 스택과의 교환" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1292" height="30" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_t_2" value="robot3 · robot4 는 네임스페이스만 다르고 구성은 같다 · SDD 3.2" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1292" height="20" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_3" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#5A5F6A&quot;&gt;&lt;b&gt;A. 센서 · 구동 (로봇 온보드) 및 외부 입력&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="24" y="74" width="300" height="694" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_4" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#5A5F6A&quot;&gt;&lt;b&gt;B. 우리가 만드는 노드 (PC-RN 에서 실행)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="356" y="74" width="350" height="694" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_5" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#5A5F6A&quot;&gt;&lt;b&gt;C. Nav2 스택 (turtlebot4_navigation)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="748" y="74" width="340" height="694" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_6" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#5A5F6A&quot;&gt;&lt;b&gt;D. 구동 출력&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1112" y="74" width="200" height="694" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_7" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;OAK-D Pro  ·  depthai_ros_driver&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;oakd/rgb/image_raw/compressed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;oakd/stereo/…/compressedDepth&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;oakd/rgb/camera_info&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;704×704 @10 Hz · 깊이 정렬 · subpixel&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F1F2F4;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="268" height="97" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_8" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;RPLIDAR A1  ·  rplidar_ros&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;scan  (LaserScan, 10 Hz)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F1F2F4;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="237" width="268" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_9" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;iRobot Create3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;odom · tf · battery_state&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;범퍼 · 클리프 (하드웨어 안전)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F1F2F4;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="268" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_10" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;외부 입력 (PC-F · 웹캠 PC 에서 옴)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;mission/assigned      S4 셔틀 트리거&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;mission/finish          S9 종료 신호&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;/webcam1/worker_descriptor&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;/webcam2/target_hint   재탐지 힌트&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;/fleet/zone_token   서비스 · P1 · DOCK&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="268" height="112" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_11" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;aruco_detector   (mro_perception)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;DICT_4X4_50 · 베이 ID 1/2/3 판독&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;aruco/id · aruco/distance&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="110" width="318" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_12" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;shuttle_mission   (mro_navigation)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;S2 undock · S4 베이 왕복 · Z-05 대기공간&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;shuttle/status · shuttle/arrived&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="207" width="318" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_13" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;amr_detection   (mro_perception)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;YOLO11n worker.pt + HSV 재식별 게이트&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;target/map_point · target/visible&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;target/paired · target/worker_id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;target/distance  ← 추종거리 판정의 기준값&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="304" width="318" height="97" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_14" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;follow_target   (mro_navigation)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;S5 합류 · S6~S8 추종 (간격 0.5 m)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;Lost → 힌트 방향 탐색 → STANDBY&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;approach/status&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="431" width="318" height="82" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_15" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;return_dock   (mro_navigation)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;S10 복귀 · DOCK 토큰 · 도킹 재시도 2회&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="543" width="318" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_16" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;safety_watchdog   (mro_navigation)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;scan 만 구독 · 전방 ±35°&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;정지 0.30 m / 해제 0.45 m&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;safety/estop · cmd_vel = 0 @20 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#8A2E22&quot;&gt;YOLO · 웹캠 · Wi-Fi 에 의존하지 않는다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="625" width="318" height="97" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_17" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;bt_navigator&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;action  navigate_to_pose&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;동작 트리가 계획 · 제어 · 복구를 조립한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="110" width="308" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_18" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;planner_server  (Smac / NavFn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;전역 경로 생성 (정적 맵 + 전역 costmap)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="207" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_19" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;controller_server  (RPP / DWB)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;지역 경로 추종 → 속도 명령 산출&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="289" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_20" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;behavior_server&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;spin · backup · wait  (복구 동작)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="371" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_21" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;global / local costmap&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;입력: 정적 맵 + scan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;inflation_radius 0.25 — 받침대 덮기 (I-009)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="453" width="308" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_22" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;amcl  +  map_server&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;입력: scan + odom + 정적 맵&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;출력: amcl_pose · map→odom 변환&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="550" width="308" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_23" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;opennav_docking&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;action  dock / undock  (Create3 IR 도크)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="647" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_24" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;velocity_smoother&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;cmd_vel (TwistStamped)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1128" y="289" width="168" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_25" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;Create3 구동부&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;v ≤ 0.3 m/s&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F1F2F4;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1128" y="381" width="168" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_26" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;교환 지점 — 번호별 내용&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;①  rgb + depth + camera_info 를 message_filters 로 동기화해 사람 검출과 거리 산출에 쓴다.      ②  rgb 만 받아 ArUco 를 읽는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;③  scan 은 안전 감시가 직접 구독한다. 인지·웹캠·관제 어느 것도 이 경로에 끼지 않는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;④⑤⑥  관제·웹캠에서 오는 트리거. mission/assigned → 셔틀 시작 · /webcam2/target_hint → 재탐지 방향 · mission/finish → 추종 즉시 중단 및 복귀 시작.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;⑦  target/paired 가 참일 때만 추종이 시작된다 (재식별 게이트).      ⑧  베이 도착 판정의 근거.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;⑨⑩⑪  우리 노드가 Nav2 에 붙는 주행 인터페이스는 navigate_to_pose 액션 하나뿐이다. 경로 계획과 지역 제어는 Nav2 에 맡긴다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;⑫⑬  도킹도 opennav_docking 액션에 맡긴다. 우리가 정하는 것은 언제 부를지와 실패 시 몇 번 다시 부를지뿐이다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;⑭  amcl_pose 로 카메라가 본 대상을 map 프레임 좌표로 옮긴다. 두 로봇이 같은 맵 원점을 쓰기 때문에 이 값이 서로 통한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;⑮⑯  Nav2 가 낸 속도 명령이 평활화를 거쳐 Create3 로 간다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;⑰  안전 감시는 정지 조건에서 cmd_vel 에 0 을 20 Hz 로 덮어써 Nav2 출력을 이긴다.      ⑱  safety/estop 을 받은 우리 노드는 새 주행 명령을 내지 않는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;설계 원칙 — 안전은 온보드(scan + costmap)에서만 성립시킨다. 웹캠 · 재식별 · 관제는 &quot;더 잘 하게&quot; 할 뿐 &quot;안 부딪히게&quot; 하는 일에는 관여하지 않는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;           그래야 Wi-Fi 가 끊기거나 웹캠이 죽어도 무사고가 유지된다. (AGENTS.md 안전 계층 원칙)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="784" width="1292" height="217" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_e_27" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_7" target="STEP2 Nav2 스택_n_13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="334" y="158.5"/><mxPoint x="334" y="352.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_28" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_7" target="STEP2 Nav2 스택_n_11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342" y="158.5"/><mxPoint x="342" y="143.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_29" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontCol