ingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="110" width="308" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_18" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;planner_server  (Smac / NavFn)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;전역 경로 생성 (정적 맵 + 전역 costmap)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="207" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_19" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;controller_server  (RPP / DWB)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;지역 경로 추종 → 속도 명령 산출&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="289" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_20" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;behavior_server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;spin · backup · wait  (복구 동작)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="371" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_21" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;global / local costmap&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;입력: 정적 맵 + scan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;inflation_radius 0.22  ← P1 0.79 m 통과용&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="453" width="308" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_22" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;amcl  +  map_server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;입력: scan + odom + 정적 맵&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;출력: amcl_pose · map→odom 변환&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="550" width="308" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_23" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;opennav_docking&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;action  dock / undock  (Create3 IR 도크)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="764" y="647" width="308" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_24" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;velocity_smoother&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cmd_vel (TwistStamped)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#6B4FA8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1128" y="289" width="168" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_25" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;Create3 구동부&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;v ≤ 0.3 m/s&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F2F4;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1128" y="381" width="168" height="52" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_26" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;교환 지점 — 번호별 내용&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;①  rgb + depth + camera_info 를 message_filters 로 동기화해 사람 검출과 거리 산출에 쓴다.      ②  rgb 만 받아 ArUco 를 읽는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;③  scan 은 안전 감시가 직접 구독한다. 인지·웹캠·관제 어느 것도 이 경로에 끼지 않는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;④⑤⑥  관제·웹캠에서 오는 트리거. mission/assigned → 셔틀 시작 · /webcam2/target_hint → 재탐지 방향 · mission/finish → 추종 즉시 중단 및 복귀 시작.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑦  target/paired 가 참일 때만 추종이 시작된다 (재식별 게이트).      ⑧  베이 도착 판정의 근거.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑨⑩⑪  우리 노드가 Nav2 에 붙는 주행 인터페이스는 navigate_to_pose 액션 하나뿐이다. 경로 계획과 지역 제어는 Nav2 에 맡긴다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑫⑬  도킹도 opennav_docking 액션에 맡긴다. 우리가 정하는 것은 언제 부를지와 실패 시 몇 번 다시 부를지뿐이다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑭  amcl_pose 로 카메라가 본 대상을 map 프레임 좌표로 옮긴다. 두 로봇이 같은 맵 원점을 쓰기 때문에 이 값이 서로 통한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑮⑯  Nav2 가 낸 속도 명령이 평활화를 거쳐 Create3 로 간다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑰  안전 감시는 정지 조건에서 cmd_vel 에 0 을 20 Hz 로 덮어써 Nav2 출력을 이긴다.      ⑱  safety/estop 을 받은 우리 노드는 새 주행 명령을 내지 않는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;설계 원칙 — 안전은 온보드(scan + costmap)에서만 성립시킨다. 웹캠 · 재식별 · 관제는 &quot;더 잘 하게&quot; 할 뿐 &quot;안 부딪히게&quot; 하는 일에는 관여하지 않는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;           그래야 Wi-Fi 가 끊기거나 웹캠이 죽어도 무사고가 유지된다. (AGENTS.md 안전 계층 원칙)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="784" width="1292" height="217" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_e_27" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_7" target="STEP2 Nav2 스택_n_13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="334" y="158.5"/><mxPoint x="334" y="352.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_28" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_7" target="STEP2 Nav2 스택_n_11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342" y="158.5"/><mxPoint x="342" y="143.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_29" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_8" target="STEP2 Nav2 스택_n_16"><mx