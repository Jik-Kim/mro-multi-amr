" vertex="1" parent="1"><mxGeometry x="3191" y="82.5" width="170" height="20.5" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_182" value="↖ 왼쪽 칸과 같은 PC 다. 터미널만 다르다 (T1·T2·T3, setup.md)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=9.5;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="3191" y="101.5" width="279.392" height="17.5" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_183" value="로봇 온보드" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12.5;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3901" y="82.5" width="83.5" height="20.5" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_184" value="RPi · TB4 드라이버 · Create3" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=9.5;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="3901" y="101.5" width="140.16" height="17.5" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_185" value="읽는 법" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="29" y="2610" width="60.28" height="21" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_186" value="────" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3576C8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="29" y="2634" width="60" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_187" value="토픽  Topic" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#333840;" vertex="1" parent="1"><mxGeometry x="63" y="2634" width="70.936" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_188" value="────" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#B06810;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="219" y="2634" width="60" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_189" value="서비스  Service" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#333840;" vertex="1" parent="1"><mxGeometry x="253" y="2634" width="91.352" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_190" value="────" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#6B4FA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="409" y="2634" width="60" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_191" value="액션  Action" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#333840;" vertex="1" parent="1"><mxGeometry x="443" y="2634" width="76.304" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_192" value="────" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#C0392B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="599" y="2634" width="60" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_193" value="안전 경로" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#333840;" vertex="1" parent="1"><mxGeometry x="633" y="2634" width="60" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_194" value="세로 레인이 그 일을 실제로 수행하는 주체다. 위에서 아래로 시나리오가 흐르고, 상자는 (주체 × 단계) 자리에 놓인다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="29" y="2658" width="567.696" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_195" value="그래서 연결선이 레인 한 칸만 건너면 되고 먼 배선이 생기지 않는다 — 3-2 에서 빈 구간을 가로지르던 선 36 개가 여기서는 없다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="29" y="2676" width="619.264" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_196" value="PC-R3 과 PC-R8 은 네임스페이스만 다르고 구성이 같아 한 레인으로 접었다. 안전 경로(safety_watchdog)는 단계와 무관하게 상시 동작한다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="29" y="2694" width="671.8" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_197" value="설명은 이 판 하나로 한다. 25 % 로 봐야 전체가 들어오므로 단계별 상세는 3-1, 노드 내부는 3-2 를 곁들인다. Nav2 · 온보드 내부는 0-B 번외판." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="29" y="2712" width="700.84" height="19" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_f_198" value="생성: tools/build_diagrams.py   ·   근거: docs/architecture.md · docs/interfaces.md 4절 · docs/SOT.md · SDD 3.3" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="29" y="2735" width="550.88" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step0b_integrated_full" name="STEP0-B 완전 통합 상세 (번외)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4652" pageHeight="3842" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP0-B 완전 통합 상세 (번외)_t_1" value="STEP 0-B — 완전 통합 상세 (번외)   ·   Nav2 스택과 로봇 온보드 내부까지 펼친 판" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="4604" height="30" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_t_2" value="0 번 판에 &quot;Nav2 안에서 무슨 일이 일어나는가&quot; 와 &quot;센서가 무엇을 내보내는가&quot; 를 더했다. 외부 스택이라 평소에는 접어 두지만, 물어보면 이 판으로 답한다. 근거: SDD 3.2 · docs/setup.md" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="4604" height="20" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_3" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="78" width="150" height="3574" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_4" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="226" y="78" width="340" height="3574" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_5" value="" style="rounded=1;arcSize=6