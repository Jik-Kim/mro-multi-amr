<mxfile host="app.diagrams.net" type="device"><diagram id="step0_integrated" name="STEP0 완전 통합 상세"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4292" pageHeight="2782" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP0 완전 통합 상세_t_1" value="STEP 0 — 완전 통합 상세   ·   레인 = 실행 주체,  위 → 아래 = 시나리오 S1 ~ S10" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="4244" height="30" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_t_2" value="한 장에 전부 담는 대조용 기준 도면 (발표용 아님). 근거: SDD 3.3 · BRD 3.2 · 계약 docs/interfaces.md 4절" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="4244" height="20" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_3" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="78" width="150" height="2514" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_4" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="226" y="78" width="340" height="2514" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_5" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=