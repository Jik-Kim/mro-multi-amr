fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_24" target="STEP3 시나리오_n_25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_56" value="N  —  정상 주행 유지&lt;br&gt;estop 이 풀리면 Nav2 가 이어서 간다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#5A5F6A;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#5A5F6A;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_24" target="STEP3 시나리오_n_26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="807"/><mxPoint x="1410" y="809"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_57" value="mission/finish&lt;br&gt;std_msgs/Bool → follow_target 중단 · return_dock 시작" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_26" target="STEP3 시나리오_n_27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="962"/><mxPoint x="1410" y="964"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_58" value="/fleet/zone_token   acquire&lt;br&gt;ZoneToken (서비스) — P1 → DOCK 순서" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.8;dashed=1;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_27" target="STEP3 시나리오_n_28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="1096"/><mxPoint x="1410" y="1098"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_59" value="N  ·  다른 로봇이 보유&lt;br&gt;홀딩 포인트 대기" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_28" target="STEP3 시나리오_n_29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_60" value="action  dock&lt;br&gt;opennav_docking (액션) — 접근 지점에서 호출" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_28" target="STEP3 시나리오_n_30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="1236"/><mxPoint x="1410" y="1238"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_61" value="N  ·  2회 실패" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_30" target="STEP3 시나리오_n_31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_62" value="shuttle/status = DOCKED&lt;br&gt;Mission.DONE — 미션이 여기서 확정된다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_30" target="STEP3 시나리오_n_32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="1370"/><mxPoint x="1410" y="1372"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_f_63" value="1단  —  진입 · 등록에서 대기공간 도착까지" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="33" y="80" width="289.08" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_64" value="2단  —  합류에서 도킹 완료까지" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1203" y="80" width="215.24" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_65" value="전 구간 공통" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="51" y="1490" width="93.56" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_66" value="· 모든 로그 · CSV · DB 는 ROS 시각을 쓴다 — 벽시계를 섞지 않는다 (계약 2절)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1516" width="393.368" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_67" value="· safety_watchdog 은 어느 단계에서든 항상 동작한다. estop 중에는 주행 명령을 내지 않는다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1536" width="457.872" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_68" value="· 안전 정지 뒤의 자동 재개는 사람의 개입이 아니므로 IPH(AC-13) 분자에 넣지 않는다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1556" width="418.184" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_69" value="· 토큰은 받았든 못 받았든 반드시 반납한다 — 안 하면 대기열에 남아 그 구역이 잠긴다 (I-033)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1576" width="462.272" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_70" value="· T_lim 120 초를 넘긴 미션은 폐기한다. 늦은 도착은 arrived_late 로 따로 남긴다 (계약 7절)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1596" width="465.352" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_71" value="· S1 ~ S10 은 로봇 두 대가 동시에 돈다. 두 대가 만나는 곳은 P1 과 DOCK 토큰뿐이다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1616" width="422.408" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_72" value="이 순서도가 정하는 KPI 기준점" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1221" y="1490" width="207.96" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_73" value="· K-05 리드타임 — S3 의 created_at 에서 S4′ 의 WAITING 까지. 도킹 완료(DONE)와 다르다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1516" width="451.272" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_74" value="· AC-08 배송 성공 — S4′ 의 WAITING 이 T_lim 안이면 성공. 미션당 한 번만 센다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1536" width="401.904" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_75" value="· AC-05 추종거리 — S6~S8 의 FOLLOWING 구간만. Nav2 도착 오차 0.25 는 뺀다 (I-029)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1556" width="432.968" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_76" value="· K-04 재획득 — q4 의 Lost 1건을 성공 · 포기 · 미복귀 중 하나로만 센다 (I-028)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1576" width="411.584" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_77" value="· K-06 교착 — q2 · q6 의 REJECT → GRANT 가 60 초 안. 그 사이 RECLAIM 이면 미해결 (I-032)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1596" width="471.6" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_78" value="· AC-13 IPH — 개입 ÷ (undock ~ DOCKED). q5 의 안전 정지는 개입이 아니다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1616" width="380.344" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_79" value="읽는 법" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="33" y="1686" width="60.28" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_80" value="토픽  Topic" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="95" y="1714" width="70.936" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_81" value="서비스  Service" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="255.7" y="1714" width="91.352" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_82" value="액션  Action" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="439.6" y="1714" width="76.304" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_83" value="안전 경로" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="606.4" y="1714" width="60" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_84" value="단계 상자의 채움색이 그 단계를 수행하는 PC 다. 화살표 위 상자는 첫 줄이 토픽 · 서비스 · 액션 이름, 둘째 줄이 메시지 타입과 그 선이 하는 일이다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="33" y="1746" width="723.544" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_85" value="오른쪽 빨간 상자는 그 판단에서 갈라지는 예외와 그때의 처리다. 판단의 나머지 한쪽(Y 또는 N)이 아래로 이어지는 정상 흐름이다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="33" y="1766" width="621.464" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_86" value="생성: tools/build_diagrams.py   ·   근거: BRD v3.5 3.2 시나리오, SDD 3.3, docs/interfaces.md" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="33" y="1789" width="455.28" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step3b_system_flow" name="STEP3-2 전체 흐름"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2620" pageHeight="1829" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP3-2 전체 흐름_t_1" value="STEP 3-2 — 전체 기능 흐름 (Functional Process Flow)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="2572" height="30" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_t_2" value="PC = 채움색 · 화살표 색 = 통신 종류(토픽 / 서비스 / 액션 / 안전) · SDD 3.3 · 계약 v1.11" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="2572" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_3" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;PC-R3 — 로봇3 제어 PC   (namespace /robot3)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="860" height="675" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_4" value