;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3735.3" y="2104" width="271.4" height="67" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_113" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;번외 ①&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;센서 → 우리 노드&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;SDD 3.2&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EFF2F6;strokeColor=#9AA0A8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="2140" width="150" height="67" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_114" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;OAK-D Pro   스테레오 카메라&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;camera_info 는 704×704 crop 기준 — I-031 보정&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;BEST_EFFORT — 구독자도 sensor_data QoS 여야 한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="4036" y="2140" width="580" height="67" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_115" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;RPLIDAR   2D 라이다&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;안전 경로 전체가 이 한 토픽에 걸려 있다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="4036" y="2217" width="580" height="52" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_116" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;Create3   구동부 · 내부 센서&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;범퍼 · 클리프 · 도크 IR · 휠 엔코더&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;v ≤ 0.3 m/s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;odom · tf · battery_state · dock_status 발행&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;→ amcl(측위) · fleet_manager(배차) · return_dock(도킹)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="4036" y="2279" width="580" height="97" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_117" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;amr_detection · aruco_detector&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;카메라를 실제로 쓰는 것은 이 두 노드다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;RGB+Depth 를 slop 0.1 s 로 묶어 재식별에 쓰고&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;RGB+camera_info 로 베이 마커를 푼다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2346" y="2140" width="510" height="82" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_118" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;safety_watchdog&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;scan 만 구독한다 — 카메라도 웹캠도 보지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;그래서 인지가 틀려도 이 경로는 살아 있다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FDF0EF;strokeColor=#D98A80;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2346" y="2232" width="510" height="67" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_119" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;oakd/rgb · stereo/depth · camera_info&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3728.5" y="2191" width="285" height="34" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_120" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;scan   LaserScan  10 Hz&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=t