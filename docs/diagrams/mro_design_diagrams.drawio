" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_12" target="STEP2 Nav2 스택_n_23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="738" y="240.5"/><mxPoint x="738" y="673"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_39" value="⑬" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_15" target="STEP2 Nav2 스택_n_23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="569"/><mxPoint x="744" y="673"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_40" value="⑭" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_22" target="STEP2 Nav2 스택_n_13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="583.5"/><mxPoint x="710" y="352.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_41" value="⑮" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_19" target="STEP2 Nav2 스택_n_24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_42" value="⑯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_24" target="STEP2 Nav2 스택_n_25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_43" value="⑰" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=2.2;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_16" target="STEP2 Nav2 스택_n_25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="673.5"/><mxPoint x="730" y="742"/><mxPoint x="1212" y="742"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_44" value="⑱" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_16" target="STEP2 Nav2 스택_n_14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="348" y="673.5"/><mxPoint x="348" y="472"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_f_45" value="생성: tools/build_diagrams.py   ·   원본 근거: docs/architecture.md, docs/interfaces.md 4절, SDD 3.2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="24" y="1007" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step3_scenario" name="STEP3 시나리오"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="2011" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP3 시나리오_t_1" value="STEP 3 — 운영 시나리오 S1~S10 흐름과 예외 처리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1272" height="30" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_t_2" value="가운데가 정상 흐름 · 왼쪽은 수행 노드 · 오른쪽은 예외와 그때의 처리 · SDD 3.3 / BRD 3.2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1272" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_3" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S1  진입 · 등록&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;작업자가 관제 구역에 들어서면 웹캠1 이 외형을 등록하고&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;로봇 한 대를 배정한다  ·  등록 완료 ≤ 10 초&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="104" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_4" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;webcam_register  (PC-W1)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ fleet_manager  (PC-F)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/webcam1/worker_descriptor&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HSV 히스토그램 H16 × S8 = 128&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;벨트 위 상의 영역만 쓴다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;담당 한세교 · 김학민&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="104" width="320" height="112" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_5" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;두 작업자의 서술자가 너무 비슷할 때&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;같은 인형끼리의 유사도와 다른 인형끼리의 유사도 분포가 겹치면&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;서술자 자체를 손봐야 한다는 신호다. 조명을 맞추고 다시 등록한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;상의 색 두 가지는 휘도를 맞춰 인쇄해 색만으로 갈리게 한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="104" width="456" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_6" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S2  준비&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;배정된 로봇이 도크에서 빠져나와 대기 상태가 된다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;undock  →  shuttle/status = READY&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="242" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_7" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;fleet_manager → shuttle_mission&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;opennav_docking  undock&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;기동할 때 자신의 dock_pose 로&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AMCL 초기 위치를 설정한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="242" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_8" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;두 로봇의 맵 좌표계가 어긋나는 사고  (I-013)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;각 로봇이 (0,0) 으로 초기화하면 같은 좌표가 서로 다른 장소를&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;가리키게 되어 세마포어도 waypoint 도 전부 무의미해진다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 맵 원점은 SLAM 작성 시점 하나로 고정하고, 각 로봇은&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;   arena.yaml 의 dock_zone.pose 값으로 초기화한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="242" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_9" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S3  자재 요청&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;관제 UI 에서 작업자와 창고 베이를 골라 요청한다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RequestMission → Mission(ASSIGNED)  ·  접수 ≤ 2 초&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="365" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_10" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;control_ui  (Flask :5000)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ fleet_manager&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mission/assigned 발행&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;담당 김민준&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="365" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_11" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;P1 병목 토큰을 얻었는가?&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;도크 ↔ 창고 통로 0.79 m · 한 번에 한 대만&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="473" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_12" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;zone_semaphore  (PC-F 실행)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;srv/ZoneToken  acquire&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;패키지는 관제, 소유는 주행&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;담당 박병후 · 이시율&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="473" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_13" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;E-3  교착 회피&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;거절되면 2 초 뒤 다시 요청한다. 폴리곤에 들어가기 전에 얻고,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;완전히 빠져나온 뒤에 반납한다. 60 초를 넘겨 쥐고 있으면&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;세마포어가 강제로 회수하고 이벤트를 남긴다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;S4 갈 때와 S10 돌아올 때 두 번 통과하므로 교착을 여기서 본다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="473" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_14" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S4  셔틀 주행&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;창고 베이 A / B / C 의 고정 waypoint 로 이동한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="596" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_15" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;shuttle_mission&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nav2  navigate_to_pose&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;arena.yaml 의 베이 waypoint&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="596" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_16" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;베이 ArUco ID 가 일치하는가?&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;거리 ≤ 1.5 m · 정면 ±30°&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="689" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_17" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;aruco_detector&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;aruco/id · aruco/distance&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ID 1/2/3 = 베이 A/B/C&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;선반 뒤 벽면, 높이 20 cm&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="689" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_18" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;도착 판정 실패&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;다시 접근해 읽는다. T_lim 120 초를 넘기면 미션을 FAILED 로&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;확정하고 운영자에게 알린다. 늦게라도 도착한 사실은&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;arrived_late 로 따로 남겨 성공으로 이중 계상하지 않는다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="689" width="456" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_19" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S4′  적재 · 합류 지점 이동&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;베이에서 5 초 체류한 뒤 대기공간(Z-05)으로 이동하고&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P1 토큰을 반납한다  ·  shuttle/arrived 발행&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="797" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_20" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;shuttle_mission&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;zone_semaphore  release&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;실패해도 토큰은 반드시 반납한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="797" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_21" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;재식별 게이트를 통과했는가?&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;외형 유사도 ≥ reid_threshold&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="890" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_22" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;amr_detection  (재식별)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;core/reid.hsv_hist() 공유 함수&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target/paired · target/worker_id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;담당 정정인 · 민범진&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="890" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_23" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;E-2  엉뚱한 사람을 따라가지 않기&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;임계에 못 미치면 페어링하지 않고 그 자리에서 대기한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;잘못된 작업자를 따라가는 일은 0 건이 절대 기준이라,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;확신이 없을 때 멈추는 쪽이 항상 옳다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;폴백 — 관제 UI 에서 운영자가 대상을 수동으로 지정한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="890" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_24" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S5  합류&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;배정된 작업자를 확인하고 접근한다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;APPROACH_1 → APPROACH_2 → ARRIVED&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1013" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_25" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;follow_target&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;approach/status&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1013" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_26" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S6 ~ S8  추종&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;중앙 복도(P3 0.93 m)를 지나 작업공간까지 따라간다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;간격 0.5 m 유지  ·  approach/status = FOLLOWING&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1106" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_27" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;follow_target&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nav2  navigate_to_pose&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;추종 경로에는 토큰을 두지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(기다리다 작업자를 놓치기 때문)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1106" width="320" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_28" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;대상을 놓쳤는가?  (Target Lost)&lt;/font&gt;&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1214" width="380" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_29" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;amr_detection → follow_target&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target/visible = false&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1214" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_30" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;E-1  재탐지&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;작업공간 안이면 웹캠2 힌트가 있다 → 그 방향으로 회전 탐색.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;중앙 복도는 웹캠2 시야 밖이라 힌트가 없다 → 제자리 탐색.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;두 조건의 재획득 시간을 비교하는 것이 시험 TS-19 다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_lim 을 넘기면 STANDBY 로 들어가 운영자를 기다린다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;가림은 교차하는 다른 작업자(RC카 2호)로 만든다 —&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;벽으로 만들면 웹캠2 의 바닥 시야까지 함께 막힌다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="1214" width="456" height="127" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_31" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;전방 0.30 m 안에 장애물이 있는가?&lt;/font&gt;&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1367" width="380" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_32" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;safety_watchdog  (온보드)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scan 만 구독 · 전방 ±35°&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;어느 단계에서든 항상 동작한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1367" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_33" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;E-4  안전 정지&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;safety/estop 을 올리고 cmd_vel 에 0 을 20 Hz 로 덮어쓴다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;0.45 m 밖으로 벗어나면 스스로 재개한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;이 정지는 사람이 개입한 것이 아니므로 개입 지표(IPH)에&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;계상하지 않는다. 웹캠이나 Wi-Fi 가 죽어도 이 경로는 살아 있다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="1367" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_34" value="&lt;b&gt;&lt;font color=&quot;#8A4F0B&quot;&gt;S9  작업 종료 발행&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;작업자가 종료 버튼을 누르면 추종을 즉시 멈춘다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RETURN / RETURN_ALL → mission/finish → 페어링 해제 ≤ 1 초&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF3E3;strokeColor=#B06810;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1490" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_35" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;control_ui → fleet_manager&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ follow_target  (즉시 중단)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ return_dock  (복귀 시작)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1490" width="320" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_36" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;복귀 통로와 도크 토큰을 얻었는가?&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P1 통과 → DOCK 은 한 번에 한 대&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1583" width="380" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_37" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;return_dock&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;zone_semaphore  P1 · DOCK&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1583" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_38" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;E-7  순차 도킹&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;도크 두 대의 중심 간격이 0.9 m 뿐이라 두 대가 동시에 들어가면&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IR 신호가 서로 간섭한다. DOCK 토큰으로 한 대씩 들여보내고&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;나머지는 홀딩 포인트에서 기다린다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;도크 사이에는 MDF 차폐판을 세운다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="1583" width="456" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_39" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;S10  도킹&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;자기 도크 정면의 접근 지점을 거쳐 도킹한다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;opennav_docking  dock&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1706" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_40" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;return_dock&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_ret 180 초 · 재시도 2회&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1706" width="320" height="52" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_41" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;도킹에 성공했는가?&lt;/font&gt;&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="392" y="1799" width="380" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_42" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;shuttle/status 로 보고&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#8A8F98;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="1799" width="320" height="34" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_43" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;도킹 실패&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;최대 2회까지 다시 시도한다. 그래도 안 되면 FAILED 를 발행하고&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;멈춘다. 성공이든 실패든 DOCK 토큰은 반드시 반납한다 —&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;반납하지 않으면 다른 로봇이 영영 들어오지 못한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSi