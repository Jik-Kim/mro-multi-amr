" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_107" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;복귀 구간에는 관여하지 않는다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="896" y="2017" width="340" height="34" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_108" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;navigate_to_pose  (액션)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;도크 정면 접근 지점까지&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;거기서부터는 opennav_docking 이 맡는다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3186" y="2017" width="380" height="67" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_109" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;/fleet/zone_token&lt;/b&gt;&lt;/font&gt;" style="shape=hexagon;whiteSpace=nowrap;html=1;fillColor=#FDF3E3;strokeColor=#B06810;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2081" y="2048.5" width="200" height="34" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_110" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;action  dock&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: