value="로봇 온보드 (TurtleBot4 ×2)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="302" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_127" value="토픽 — 센서 원천" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#1B4F91;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="409" y="96" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_128" value="BEST_EFFORT — 구독자도 sensor_data QoS 로 잡아야 받는다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8E2A1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="409" y="254" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_129" value="TB4 기본 토픽 (계약 4절 표 아래)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="409" y="552" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_130" value="로봇 제어 PC — 인지 · 안전" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#1B4F91;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="772" y="96" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_131" value="토픽 — 인지 · 안전" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#1B4F91;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1135" y="96" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_132" value="safety/estop 은 로봇 안 모든 노드와 관제가 받는다 (계약 4절)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8E2A1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1135" y="730" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_133" value="로봇 제어 PC — 임무 · 주행" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#1B4F91;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1498" y="96" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_134" value="토픽 — 임무 · 구동" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#1B4F91;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1861" y="96" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_135" value="estop 중 워치독이 20 Hz 로 덮어쓴다 · 병진 0 · 각속도 0.4 rad/s" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8E2A1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1861" y="382" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_136" value="후진 금지 (계약 2절 확정) — 범퍼·클리프가 전방에만 있다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8E2A1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1861" y="400" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_137" value="navigate_to_pose" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12.5;fontColor=#4B357A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1861" y="442" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_138" value="nav2_msgs/action/NavigateToPose" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="1861" y="459" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_139" value="dock · undock" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12.5;fontColor=#4B357A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1861" y="698" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_140" value="irobot_create_msgs/action/Dock" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="1861" y="715" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_141" value="액션 하나가 속으로는 서비스 3 + 토픽 2 다 — 강사 자료 p.72 가" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#4B357A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1861" y="938" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_142" value="빽빽한 이유. Nav2 만 붙여도 상자가 40 개 는다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#4B357A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1861" y="956" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_143" value="관제 PC" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#8A4F0B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2224" y="96" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_144" value="토픽 · 서비스 — 관제" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=13;fontColor=#8A4F0B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2587" y="96" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_145" value="서비스는 요청·응답이라 양방향이다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A4F0B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2587" y="594" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_146" value="거절되면 2 초 뒤 재요청 (계약 3절)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="2587" y="612" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_147" value="범례 — rqt_graph 규약 (강사 자료 Day5 p.72 와 같은 표기)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=14;fontColor=#1B2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="94" y="654" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_148" value="액션 묶음" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12.5;fontColor=#4B357A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="754" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_149" value="속은 서비스 3 + 토픽 2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="68" y="772" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_150" value="━━  토픽" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#3576C8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="314" y="748" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_151" value="━━  서비스" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#B06810;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="314" y="770" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_152" value="━━  액션" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#6B4FA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="314" y="792" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_153" value="━━  안전 · 구동" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#C0392B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="314" y="814" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_154" value="━━  센서 원본" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#5A5F6A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="314" y="836" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_155" value="화살표 색 = 통신 종류" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#1B2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="748" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_156" value="점선 = BEST_EFFORT 또는 조건부" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="456" y="768" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_157" value="굵은 빨강 = 안전에 걸린 경로" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#8E2A1F;" vertex="1" parent="1"><mxGeometry x="456" y="786" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_158" value="읽는 법 — 노드에서 나온 화살표는 그 토픽을 **발행**, 토픽에서 나온 화살표는" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="94" y="822" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_159" value="그것을 **구독**한다는 뜻이다. 한 토픽에서 화살표가 여럿 나가면 구독자가 여럿이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="94" y="840" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_160" value="로봇 열(인지·임무)은 /robot3 과 /robot4 에 똑같이 하나씩 뜬다. 이름은 상대 이름이라" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="94" y="866" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_161" value="launch 가 namespace:=/robotN 을 붙인다 (계약 4절). 전역 이름은 앞에 / 가 있는 것들이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="94" y="884" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_162" value="이 그림에 없는 것 — Nav2 내부 노드 20여 개와 tf. 강사 자료 p.72 가 그것까지 담아 그만큼 빽빽하다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="94" y="910" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_163" value="mission/assigned  →  shu      S4 트리거" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3576C8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="1016" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_164" value="mission/finish  →  fol      S9 — 즉시 페어링 해제 (≤ 1 s)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3576C8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="1050" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_165" value="mission/finish  →  ret      S9 — 복귀 시작" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3576C8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="1084" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_166" value="mission/finish  →  det      S9 — 명시 페어링 해제 (10절)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3576C8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="1118" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_167" value="/fleet/zone_token  ⇄  shuttle_mission      P1·DOCK 획득·반납 (서비스라 양방향)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#B06810;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="1152" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_168" value="cmd_vel  →  Create3      워치독·Nav2·follow_target 셋이 같은 토픽에 쓴다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#C0392B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="1186" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_169" value="이 장이 step3b 와 다른 점 — 토픽이 화살표의 라벨이 아니라 상자다. mission/finish 를 받는 노드가 셋이라는 것이 step3b 에서는 안 보였다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12.5;fontColor=#1B4F91;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="1252" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3-3 ROS 그래프_f_170" value="토픽 이름과 타입은 계약(docs/interfaces.md 4절)에서 읽어 그린다. 계약이 바뀌면 이 그림도 같이 바뀐다 — 손으로 적지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11.5;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="32" y="1274" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>