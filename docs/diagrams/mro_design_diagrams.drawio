;fontSize=10;fontColor=#5A5F6A;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_15" target="STEP3 시나리오_n_16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_f_66" value="1단  —  요청에서 대기공간까지" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="70" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_67" value="webcam_register" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="76" y="147" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_68" value="shuttle_mission" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="76" y="195" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_69" value="control_ui" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="76" y="243" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_70" value="shuttle_mission" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="76" y="291" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_71" value="aruco_detector" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="76" y="346" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_72" value="zone_semaphore" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="76" y="408" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_73" value="shuttle_mission" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="76" y="463" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_74" value="2단  —  합류에서 도킹까지" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_75" value="amr_detection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="154" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_76" value="follow_target" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="209" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_77" value="follow_target" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="257" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_78" value="amr_detection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="312" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_79" value="safety_watchdog" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="374" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_80" value="control_ui" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="429" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_81" value="return_dock" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="484" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_82" value="return_dock" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="539" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_83" value="return_dock" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10.5;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="636" y="594" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_84" value="예외 처리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="714" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_85" value="같은 인형끼리와 다른 인형끼리의 유사도 분포가 겹치면 서술자를 손봐야 한다는 신호다. 조명을 맞추고 다시 등록한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="746" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_86" value="각 로봇이 (0,0) 으로 초기화하면 같은 좌표가 다른 장소를 가리킨다. arena.yaml 의 dock_zone.pose 값으로 초기화한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="773" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_87" value="다시 접근해 마커를 읽는다. T_lim 120 초를 넘기면 FAILED. 늦은 도착은 arrived_late 로 따로 남겨 이중 계상하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="800" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_88" value="거절되면 2 초 뒤 다시 요청한다. 구역에 들어가기 전에 얻고 빠져나온 뒤 반납한다. 60 초를 넘겨 쥐면 강제 회수한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="827" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_89" value="유사도가 임계에 못 미치면 페어링하지 않고 대기한다. 확신이 없을 때 멈추는 쪽이 항상 옳다. 폴백은 운영자 수동 지정." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="854" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_90" value="작업공간이면 웹캠2 힌트 방향으로 회전 탐색, 중앙 복도는 시야 밖이라 제자리 탐색. T_lim 초과 시 STANDBY." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="881" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_91" value="safety/estop 을 올리고 cmd_vel 에 0 을 20 Hz 로 덮어쓴다. 0.45 m 밖이면 스스로 재개. 개입(IPH)에 계상하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="908" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_92" value="도크 간격이 0.84 m 뿐이라 동시에 들어가면 IR 이 간섭한다. DOCK 토큰으로 한 대씩, 나머지는 홀딩 포인트 대기." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="935" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_93" value="최대 2회 재시도 후 FAILED 를 발행하고 멈춘다. 성공이든 실패든 DOCK 토큰은 반드시 반납한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="186" y="962" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_94" value="전 구간 공통 — 모든 로그와 CSV 는 ROS 시각을 쓴다. 안전 정지 뒤의 자동 재개는 개입으로 계상하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="999" width="260" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_95" value="생성: tools/build_diagrams.py   ·   근거: BRD 3.2 시나리오, SDD 3.3, docs/interfaces.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="24" y="1019" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step3b_system_flow" name="STEP3-2 전체 흐름"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2620" pageHeight="1551" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP3-2 전체 흐름_t_1" value="STEP 3-2 — 전체 기능 흐름 (Functional Process Flow)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="2572" height="30" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_t_2" value="PC = 채움색 · 화살표 색 = 통신 종류(토픽 / 서비스 / 액션 / 안전) · SDD 3.3 · 계약 v1.11" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="2572" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_3" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;PC-R3 — 로봇3 제어 PC   (namespace /robot3)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF3FC;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="860" height="675" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_4" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;PC-R4 — 로봇4 제어 PC   (namespace /robot4)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1740" y="96" width="860" height="675" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_5" value="&lt;b&gt;&lt;font color=&quot;#8A4F0B&quot;&gt;PC-F — 관제 PC   (Discovery Server ID 1)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="900" y="96" width="820" height="419" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_6" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="921" width="2580" height="108" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_7" value="&lt;b&gt;&lt;font color=&quot;#1E6B40&quot;&gt;PC-W1 / PC-W2 — 웹캠 PC&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="900" y="1179" width="820" height="155" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_8" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;TurtleBot4 · OAK-D Pro 드라이버&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;oakd/rgb · stereo/depth · camera_info   704×704 crop · BEST_EFFORT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scan 10 Hz · odom · tf · battery_state · dock_status&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cmd_vel (geometry_msgs/TwistStamped) 로 구동한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="136" width="828" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_9" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;aruco_detector&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;camera_fx_scale 1.7778 보정 (I-031)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;solvePnP IPPE_SQUARE · 1.5 m 게이트&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;aruco/id · aruco/distance&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_10" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;amr_detection&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RGB+Depth 동기 slop 0.1 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;worker.pt · 재식별 임계 0.6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target/paired · map_point&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="318.667" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_11" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;safety_watchdog  (온보드)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scan 만 구독 · 전방 ±35°&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;0.30 m 2프레임 → estop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cmd_vel 0 을 20 Hz 로 덮어씀&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF0EF;strokeColor=#D98A80;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="601.333" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_12" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;shuttle_mission    S4 셔틀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;READY → SHUTTLE → AT_BAY → WAITING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ArUco 확인 → 적재 5 s → P1 토큰 → 대기공간&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_lim 120 s 초과 → 미션 폐기 (계약 7절)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WAITING 은 도착 확정 시 1회 — AC-08 기준점&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="400" width="339" height="97" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_13" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;Nav2 / AMCL   turtlebot4_navigation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;map_server · amcl · bt_navigator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;planner_server · controller_server&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;velocity_smoother → cmd_vel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;xy_goal_tolerance 0.25 (I-029)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="525" y="400" width="339" height="97" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_14" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;follow_target      S5~S8 추종&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;APPROACH_1 / 2 → ARRIVED → FOLLOWING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;standoff 0.5 m · 놓치면 힌트 방향 탐색&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_lim 초과 → STANDBY (운영자 대기)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="543" width="339" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_15" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;opennav_docking&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;action  undock  — S2 기동&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;action  dock     — S10 복귀&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="525" y="543" width="339" height="67" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_16" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;return_dock       S10 복귀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P1 → DOCK 토큰 (한 번에 한 대, E-7)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;도크 정면 접근 지점 경유 → dock&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_ret 180 s · 재시도 2회 · 실패해도 반납&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="671" width="339" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_17" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;Create3 구동부&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;v ≤ 0.3 m/s · 범퍼 · 클리프 · 도크 IR&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="525" y="671" width="339" height="52" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_18" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;TurtleBot4 · OAK-D Pro 드라이버&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;oakd/rgb · stereo/depth · camera_info   704×704 crop · BEST_EFFORT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scan 10 Hz · odom · tf · battery_state · dock_status&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cmd_vel (geometry_msgs/TwistStamped) 로 구동한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1756" y="136" width="828" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_19" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;aruco_detector&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;camera_fx_scale 1.7778 보정 (I-031)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;solvePnP IPPE_SQUARE · 1.5 m 게이트&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;aruco/id · aruco/distance&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1756" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_20" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;amr_detection&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RGB+Depth 동기 slop 0.1 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;worker.pt · 재식별 임계 0.6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target/paired · map_point&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2038.67" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_21" value="&lt;b&gt;&lt;font color=&quot;#8E2A1F&quot;&gt;safety_watchdog  (온보드)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scan 만 구독 · 전방 ±35°&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;0.30 m 2프레임 → estop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cmd_vel 0 을 20 Hz 로 덮어씀&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF0EF;strokeColor=#D98A80;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2321.33" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_22" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;shuttle_mission    S4 셔틀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;READY → SHUTTLE → AT_BAY → WAITING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ArUco 확인 → 적재 5 s → P1 토큰 → 대기공간&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_lim 120 s 초과 → 미션 폐기 (계약 7절)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WAITING 은 도착 확정 시 1회 — AC-08 기준점&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1756" y="400" width="339" height="97" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_23" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;Nav2 / AMCL   turtlebot4_navigation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;map_server · amcl · bt_navigator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;planner_server · controller_server&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;velocity_smoother → cmd_vel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;xy_goal_tolerance 0.25 (I-029)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2245" y="400" width="339" height="97" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_24" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;follow_target      S5~S8 추종&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;APPROACH_1 / 2 → ARRIVED → FOLLOWING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;standoff 0.5 m · 놓치면 힌트 방향 탐색&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_lim 초과 → STANDBY (운영자 대기)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1756" y="543" width="339" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_25" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;opennav_docking&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;action  undock  — S2 기동&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;action  dock     — S10 복귀&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2245" y="543" width="339" height="67" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_26" value="&lt;b&gt;&lt;font color=&quot;#4B357A&quot;&gt;return_dock       S10 복귀&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P1 → DOCK 토큰 (한 번에 한 대, E-7)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;도크 정면 접근 지점 경유 → dock&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;T_ret 180 s · 재시도 2회 · 실패해도 반납&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1756" y="671" width="339" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_27" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;Create3 구동부&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;v ≤ 0.3 m/s · 범퍼 · 클리프 · 도크 IR&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB0B8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2245" y="671" width="339" height="52" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_28" value="&lt;b&gt;&lt;font color=&quot;#8A4F0B&quot;&gt;control_ui     Flask :5000&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;운영자 화면 — 2대 상태 표시 (뷰어)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;자재 요청 → RequestMission (서비스)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;종료 → OperatorCommand RETURN / RETURN_ALL&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B685;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="916" y="158" width="329" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_29" value="&lt;b&gt;&lt;font color=&quot;#8A4F0B&quot;&gt;fleet_manager&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;서술자 수신 → 로봇 배정 (트랙 ID 작은 쪽)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;배터리 25 % 미만이면 미션 거부&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mission/assigned · mission/finish 발행&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&