t;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="56" y="428" width="338" height="52" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_22" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;사람이 보이는가?&lt;/font&gt;&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="56" y="493" width="338" height="34" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_23" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;ByteTrack 으로 트랙 ID 부여&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="56" y="540" width="338" height="34" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_24" value="&lt;b&gt;&lt;font color=&quot;#6F5610&quot;&gt;0.3 s 연속으로 잡히는가?&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;아니오 → 무시 (오검출 억제)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="56" y="587" width="338" height="52" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_25" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;벨트 위 상의만 잘라&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HSV 히스토그램 H16×S8 = 128&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="