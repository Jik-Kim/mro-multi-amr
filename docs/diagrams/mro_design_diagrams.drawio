 y="569"/><mxPoint x="730" y="143.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_38" value="⑫" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_12" target="STEP2 Nav2 스택_n_23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="738" y="240.5"/><mxPoint x="738" y="673"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_39" value="⑬" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_15" target="STEP2 Nav2 스택_n_23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="569"/><mxPoint x="744" y="673"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_40" value="⑭" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_22" target="STEP2 Nav2 스택_n_13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="583.5"/><mxPoint x="710" y="352.5"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_41" value="⑮" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_19" target="STEP2 Nav2 스택_n_24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_42" value="⑯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_24" target="STEP2 Nav2 스택_n_25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_43" value="⑰" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=2.2;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_16" target="STEP2 Nav2 스택_n_25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="673.5"/><mxPoint x="730" y="742"/><mxPoint x="1212" y="742"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_e_44" value="⑱" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.4;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP2 Nav2 스택_n_16" target="STEP2 Nav2 스택_n_14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="348" y="673.5"/><mxPoint x="348" y="472"/></Array></mxGeometry></mxCell><mxCell id="STEP2 Nav2 스택_f_45" value="생성: tools/build_diagrams.py   ·   원본 근거: docs/architecture.md, docs/interfaces.md 4절, SDD 3.2" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="17" y="1008" width="495.28" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step3_scenario" name="STEP3 시나리오"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="1836" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP3 시나리오_t_1" value="STEP 3-1 — 운영 시나리오 S1 ~ S10 순서도" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="2312" height="30" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_t_2" value="단계 상자 = 채움색이 수행 PC · 화살표 색 = 통신 종류 · 오른쪽 = 그때의 예외 처리 · SDD 3.3 / BRD 3.2" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="2312" height="20" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_3" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;S1   진입 · 등록&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;webcam_register (PC-W1) · 출입구 시야 · 추론 10 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;ByteTrack ID 부여 · 0.3 s 연속으로 잡혀야 등록&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;HSV H16×S8 = 128 · 10프레임 평균 · 재등록 임계 0.45&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;등록 ≤ 10 초 → 로봇 배정 (트랙 ID 작은 쪽 먼저)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF7F1;strokeColor=#93C4A8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="400" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_4" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;두 작업자의 서술자가 너무 비슷할 때&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;같은 인형끼리의 유사도와 다른 인형끼리의 유사도 분포가 겹치면&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;서술자 자체를 손봐야 한다는 신호다. 조명을 맞추고 다시 등록한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;상의 색 두 가지는 휘도를 맞춰 인쇄해 색만으로 갈리게 한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="125.5" width="520" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_5" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;S2   준비 — 도크에서 나온다&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;shuttle_mission (PC-R3 / PC-R4)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;dock_pose 로 AMCL 초기 위치 설정 — I-013&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;opennav_docking   action  undock&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;shuttle/status = READY → SHUTTLE&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="273" width="400" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_6" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;I-013   두 로봇의 맵 좌표계가 어긋나는 사고&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;각 로봇이 (0,0) 으로 초기화하면 같은 좌표가 서로 다른 장소를&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;가리키게 되어 세마포어도 waypoint 도 전부 무의미해진다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;맵 원점은 SLAM 작성 시점 하나로 고정하고, 각 로봇은&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;arena.yaml 의 dock_zone.pose 값으로 초기화한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="273" width="520" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_7" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;S3   자재 요청&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;control_ui (Flask :5000) 에서 작업자 · 베이 선택&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;RequestMission (서비스) → fleet_manager&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;배터리 25 % 미만이면 거부하고 사유를 남긴다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;접수 ≤ 2 초 · missions.created_at 기록 (K-05 시작점)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFF6E8;strokeColor=#D6B685;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="400" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_8" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;S4   셔틀 주행 — 창고 베이로&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;shuttle_mission → Nav2   navigate_to_pose (액션)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;arena.yaml 의 베이 A / B / C waypoint&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;도크와 창고는 벽 없이 이어져 여기서는 토큰이 없다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;shuttle/status = SHUTTLE → AT_BAY&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="583" width="400" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_9" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;베이 ArUco ID 가 일치하는가?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;aruco_detector · 거리 ≤ 1.5 m&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="738" width="400" height="76" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_10" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;도착 판정 실패 — 오도착&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;다시 접근해 읽는다. T_lim 120 초를 넘기면 미션을 FAILED 로&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;확정하고 운영자에게 알린다. 늦게라도 도착한 사실은&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;arrived_late 로 따로 남겨 성공으로 이중 계상하지 않는다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="735" width="520" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_11" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;P1 병목 토큰을 얻었는가?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;zone_semaphore · 한 번에 한 대&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="400" height="76" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_12" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;E-3   교착 회피&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;거절되면 2 초 뒤 다시 요청한다 (REJECT 는 대기 시작 1건만).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;폴리곤에 들어가기 전에 얻고 완전히 빠져나온 뒤 반납한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;60 초를 넘겨 쥐고 있으면 세마포어가 강제 회수(RECLAIM)한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;S4 창고에서 나올 때와 S10 돌아갈 때 두 번 통과한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="861.5" width="520" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_13" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;S4′   적재 · 대기공간 이동&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;적재 5 초 체류 → P1 통과 → 대기공간 (Z-05)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;도착 후 P1 토큰 반납 — 못 받았어도 반드시 반납 (I-033)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;shuttle/arrived (Bool) · shuttle/status = WAITING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;WAITING 이 AC-08 · K-05 판정 기준점 — 미션당 1회&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="1006" width="400" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_14" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;①&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#DFF0E6;strokeColor=#2E8B57;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="219" y="1129" width="42" height="42" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_15" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;①&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#DFF0E6;strokeColor=#2E8B57;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1389" y="50" width="42" height="42" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_16" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;재식별 게이트를 통과했는가?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;amr_detection · 유사도 ≥ 0.6&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="118" width="400" height="76" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_17" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;E-2   엉뚱한 사람을 따라가지 않기&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;임계에 못 미치면 페어링하지 않고 그 자리에서 대기한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;잘못된 작업자를 따라가는 일은 0 건이 절대 기준이라,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;확신이 없을 때 멈추는 쪽이 항상 옳다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;폴백 — 관제 UI 에서 운영자가 대상을 수동으로 지정한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1800" y="107.5" width="520" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_18" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;S5   합류 — 배정된 작업자에게 접근&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;follow_target → Nav2   navigate_to_pose (액션)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;APPROACH_1 → APPROACH_2 → ARRIVED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;approach/status (String) 로 관제에 보고한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="252" width="400" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_19" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;S6 ~ S8   추종&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;중앙 복도(P3 0.93 m)를 지나 작업공간까지 따라간다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;standoff 0.5 m 유지 · v ≤ 0.3 m/s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;approach/status = FOLLOWING · target/distance 발행&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;추종 경로에는 토큰을 두지 않는다 — 기다리면 놓친다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="392" width="400" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_20" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;대상을 놓쳤는가?   (Target Lost)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;target/visible = false 가 1.0 s 이상&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="547" width="400" height="76" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_21" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;E-1   재탐지&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;작업공간 안이면 웹캠2 힌트가 있다 → 그 방향으로 회전 탐색.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;중앙 복도는 웹캠2 시야 밖이라 힌트가 없다 → 제자리 탐색.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;두 조건의 재획득 시간을 비교하는 것이 시험 TS-19 다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;T_lim 을 넘기면 STANDBY 로 들어가 운영자를 기다린다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1800" y="536.5" width="520" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_22" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;전방 0.30 m 안에 장애물이 있는가?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;safety_watchdog · scan · 전방 ±35°&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="681" width="400" height="76" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_23" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;E-4   안전 정지&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;safety/estop 을 올리고 cmd_vel 에 0 을 20 Hz 로 덮어쓴다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;0.45 m 밖으로 벗어나면 스스로 재개한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;이 정지는 사람이 개입한 것이 아니므로 IPH 에 계상하지 않는다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;웹캠이나 Wi-Fi 가 죽어도 이 경로는 온보드에서 살아 있다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1800" y="670.5" width="520" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_24" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;S9   작업 종료&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;작업자가 종료 버튼 → control_ui → fleet_manager&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;OperatorCommand   RETURN / RETURN_ALL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;mission/finish (Bool) — 추종 즉시 중단 (≤ 1 초)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;페어링 해제 · return_dock 이 복귀를 시작한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFF6E8;strokeColor=#D6B685;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="815" width="400" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_25" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;복귀 통로와 도크 토큰을 얻었는가?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;P1 통과 → DOCK 은 한 번에 한 대&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="970" width="400" height="76" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_26" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;S10   도킹&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;자기 도크 정면의 접근 지점을 거쳐 도킹한다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;opennav_docking   action  dock · T_ret 180 초&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;shuttle/status = RETURNING → DOCK_WAIT → DOCKED&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="1104" width="400" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_27" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;E-7   순차 도킹&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;도크 두 대의 간격이 0.84 m(도킹점 기준)뿐이라 두 대가 동시에&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;들어가면 IR 신호가 서로 간섭한다. DOCK 토큰으로 한 대씩&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;들여보내고 나머지는 홀딩 포인트에서 기다린다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;차폐판은 두지 않는다 — TS-U12 10회 오도킹 0 (9/6).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1800" y="1096.5" width="520" height="97" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_28" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;도킹에 성공했는가?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;dock_status · 재시도 2회까지&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="1244" width="400" height="76" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_29" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;도킹 실패&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;최대 2회까지 다시 시도한다. 그래도 안 되면 FAILED 를 발행하고&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;멈춘다. 성공이든 실패든 DOCK 토큰은 반드시 반납한다 —&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;반납하지 않으면 다른 로봇이 영영 들어오지 못한다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1800" y="1241" width="520" height="82" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_30" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;DOCKED   ·   Phase 1 종료&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;두 대 모두 도킹 완료 · KPI 로그 확정&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#DFF0E6;strokeColor=#2E8B57;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="1378" width="400" height="48" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_31" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="1110" height="178" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_n_32" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAli