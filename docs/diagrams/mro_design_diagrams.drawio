nt="1"><mxGeometry x="372" y="110" width="318" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_12" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;shuttle_mission   (mro_navigation)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;S2 undock · S4 베이 왕복 · Z-05 대기공간&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shuttle/status · shuttle/arrived&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="207" width="318" height="67" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_13" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;amr_detection   (mro_perception)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;YOLO11n worker.pt + HSV 재식별 게이트&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target/map_point · target/visible&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target/paired · target/worker_id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target/distance  ← 추종거리 판정의 기준값&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="372" y="304" width="318" height="97" as="geometry"/></mxCell><mxCell id="STEP2 Nav2 스택_n_14" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;follow_target   (mro_navigation)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;S5 합류 · S6~S8 추종 (간격 0.5 m)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Lost → 힌트 방향 탐색 → STANDBY&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;approach/status&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpac