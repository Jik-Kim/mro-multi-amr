eometry x="3631" y="509" width="200" height="34" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_45" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;S3  자재 요청&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;접수 ≤ 2 초&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;K-05 시작점&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EFF2F6;strokeColor=#9AA0A8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="623" width="150" height="67" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_46" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;control_ui   Flask :5000&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;운영자가 작업자 · 베이를 고른다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;RequestMission (서비스) → fleet_manager&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;missions.created_at 기록 — K-05 리드타임 시작&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B685;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1566" y="623" width="450" height="82" as="geometry"/></mxCell><mxCell id="STEP0 완전 통합 상세_n_47" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;RequestMission   (서비스)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A