<mxfile host="app.diagrams.net" type="device"><diagram id="step5_graph_w1" name="STEP5 노드 그래프 — 웹캠1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2510" pageHeight="2212" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP5 노드 그래프 — 웹캠1_t_1" value="STEP 5 — 웹캠1 갈래   ·   PC 안에 노드, 노드 안에 동작 순서도" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="2462" height="30" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_t_2" value="상자에는 무슨 일을 하는지 우리말로 적는다 (함수명 · 변수명은 쓰지 않는다). 화살표에는 ROS 토픽 이름과 메시지 타입을 적는다. 사양은 외부 장비 상자에만 적는다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="2462" height="20" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_3" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;webcam_register        작업자를 등록하는 프로그램&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#A9C3E3;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="474.812" y="176" width="871.188" height="1076" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_4" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;PC-W1   웹캠1 PC&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="454.812" y="138" width="911.188" height="1152" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_5" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;webcam_hint        재탐지 힌트를 내는 프로그램&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#A9C3E3;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1486" y="190" width="405" height="298" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_6" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;PC-W2   웹캠2 PC&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1456" y="150" width="965" height="376" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_7" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;fleet_manager        작업자에게 로봇을 붙이는 프로그램&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#A9C3E3;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1486" y="606" width="452" height="724" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_8" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;PC-F   관제 PC&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFF9EC;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1456" y="566" width="1012" height="802" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_9" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;amr_detection        작업자를 알아보는 프로그램&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#A9C3E3;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1486" y="1504" width="464.25" height="498" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_10" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;PC-RN   로봇 제어 PC   (로봇마다 한 벌)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=5;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1456" y="1464" width="1024.25" height="576" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_11" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;웹캠 1        USB 카메라&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;설치      출입구 정면 · 남쪽 외벽&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;시야      출입구만 본다 (그 밖은 등록하지 않는다)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;촬영      초당 25장 — 이 장비의 상한&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;해상도   장치 기본값을 그대로 쓴다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;             프로그램이 따로 지정하지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;연결      USB. 꽂힌 카메라를 프로그램이 자동으로 찾는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;             여러 대면 나중에 꽂은 것부터 시도한다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;             내장 카메라가 잡히면 번호를 직접 지정한다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;전달      ROS 토픽이 아니다 — 프로그램이 직접 읽는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;             오래된 화면이 쌓이지 않게 한 장만 들고 있는다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F1F2F4;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="268" width="361" height="187" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_12" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;작업자 등록 시작&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=nowrap;html=1;fillColor=#DFF0E6;strokeColor=#2E8B57;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="214" width="180" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_13" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;웹캠 영상 한 장 읽기&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="346" width="180" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_14" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;사람 검출&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="438" width="180" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_15" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;등록 대상 복장인가?&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="562.5" y="538" width="315" height="62" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_16" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;같은 사람에게 추적 번호 유지&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="608" y="670" width="224" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_17" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;상의 색 지문 뽑기&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="630" y="762" width="180" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_18" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;최근 열 장을 평균내 지문 안정화&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="598.25" y="854" width="243.5" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_19" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;1초 넘게 같은 사람으로 보이는가?&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="500.812" y="954" width="438.375" height="62" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_20" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;작업자 번호 부여  (최대 2명)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="606.5" y="1086" width="227" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_21" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;작업자 정보 내보내기&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;등록 뒤에도 1초마다 다시 보낸다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#7FA6D6;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="610.25" y="1178" width="219.5" height="52" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_22" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;등록하지 않고 버린다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1140" y="542" width="180" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_23" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;아직 확정하지 않는다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1140" y="958" width="180" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_24" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;작업자 번호에 복장 종류를 짝지어 표에 적어 둔다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#93C4A8;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1516" y="216" width="345" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_25" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;이 표가 있어야 화면에서 본 사람이&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;누구인지 가릴 수 있다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#93C4A8;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1560.5" y="306" width="256" height="52" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_26" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;이후 그 사람이 어디 있는지&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;방향 힌트를 로봇에 보낸다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#93C4A8;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1582.75" y="414" width="211.5" height="52" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_27" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;이미 로봇이 붙은 작업자인가?&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1516" y="632" width="392" height="62" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_28" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;쓸 수 있는 로봇이 있는가?&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1531.75" y="750" width="360.5" height="62" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_29" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;대기 명단에 올린다  (등록된 시각과 함께)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B685;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1561" y="868" width="302" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_30" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;명단이 로봇 수만큼 찼는가?&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1526.94" y="958" width="370.125" height="62" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_31" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;작업자 번호가 빠른 순서로&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;로봇을 한 대씩 붙인다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B685;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1609.75" y="1076" width="204.5" height="52" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_32" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;누가 어느 로봇을 맡았는지 기록에 남긴다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B685;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1565.25" y="1184" width="293.5" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_33" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;배정 결과를 그 로봇에 알린다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B685;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1600" y="1274" width="224" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_34" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;색 지문이 비어 있지는 않은가?&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1516" y="1530" width="404.25" height="62" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_35" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;작업자 번호마다 복장과 색 지문을 기억해 둔다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1555.38" y="1648" width="325.5" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_36" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#6F5610&quot;&gt;&lt;b&gt;내가 맡은 작업자인가?&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=nowrap;html=1;fillColor=#FFF8DE;strokeColor=#B8912B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1560.62" y="1738" width="315" height="62" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_37" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;그 지문을 짝짓기 기준값으로 건다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1593.62" y="1856" width="249" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_38" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;지문이 새로 오면 기준값도 따라 바꾼다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1577.62" y="1946" width="281" height="34" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_39" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;그냥 넘어간다&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;이번 소식은 여기서 끝&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCECEC;strokeColor=#C0392B;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2118" y="636" width="250" height="52" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_n_40" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;배정하지 않고 기록만 남긴다&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;이번 소식은 여기서 끝&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FCE