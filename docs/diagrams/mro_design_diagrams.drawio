;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_19" target="STEP3 시나리오_n_20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="539"/><mxPoint x="1410" y="541"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_53" value="Y  ·  1.0 s 이상&lt;br&gt;웹캠2 힌트로 방향" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_20" target="STEP3 시나리오_n_21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_54" value="target/visible = true&lt;br&gt;계속 추종한다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_20" target="STEP3 시나리오_n_22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="673"/><mxPoint x="1410" y="675"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_55" value="Y  ·  2프레임 연속&lt;br&gt;safety/estop = true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_22" target="STEP3 시나리오_n_23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_56" value="N  —  정상 주행 유지&lt;br&gt;estop 이 풀리면 Nav2 가 이어서 간다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#5A5F6A;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#5A5F6A;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_22" target="STEP3 시나리오_n_24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="807"/><mxPoint x="1410" y="809"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_57" value="mission/finish&lt;br&gt;std_msgs/Bool → follow_target 중단 · return_dock 시작" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_24" target="STEP3 시나리오_n_25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="962"/><mxPoint x="1410" y="964"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_58" value="/fleet/zone_token   acquire&lt;br&gt;ZoneToken (서비스) — P1 → DOCK 순서" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.8;dashed=1;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_25" target="STEP3 시나리오_n_26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="1096"/><mxPoint x="1410" y="1098"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_59" value="N  ·  다른 로봇이 보유&lt;br&gt;홀딩 포인트 대기" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_26" target="STEP3 시나리오_n_27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_60" value="action  dock&lt;br&gt;opennav_docking (액션) — 접근 지점에서 호출" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6B4FA8;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#6B4FA8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_26" target="STEP3 시나리오_n_28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="1236"/><mxPoint x="1410" y="1238"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_61" value="N  ·  2회 실패" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C0392B;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_28" target="STEP3 시나리오_n_29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP3 시나리오_e_62" value="shuttle/status = DOCKED&lt;br&gt;Mission.DONE — 미션이 여기서 확정된다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=1.8;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP3 시나리오_n_28" target="STEP3 시나리오_n_30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="1370"/><mxPoint x="1410" y="1372"/></Array></mxGeometry></mxCell><mxCell id="STEP3 시나리오_f_63" value="1단  —  진입 · 등록에서 대기공간 도착까지" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="33" y="80" width="289.08" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_64" value="2단  —  합류에서 도킹 완료까지" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1203" y="80" width="215.24" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_65" value="전 구간 공통" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="51" y="1490" width="93.56" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_66" value="· 모든 로그 · CSV · DB 는 ROS 시각을 쓴다 — 벽시계를 섞지 않는다 (계약 2절)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1516" width="393.368" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_67" value="· safety_watchdog 은 어느 단계에서든 항상 동작한다. estop 중에는 주행 명령을 내지 않는다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1536" width="457.872" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_68" value="· 안전 정지 뒤의 자동 재개는 사람의 개입이 아니므로 IPH(AC-13) 분자에 넣지 않는다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1556" width="418.184" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_69" value="· 토큰은 받았든 못 받았든 반드시 반납한다 — 안 하면 대기열에 남아 그 구역이 잠긴다 (I-033)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1576" width="462.272" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_70" value="· T_lim 120 초를 넘긴 미션은 폐기한다. 늦은 도착은 arrived_late 로 따로 남긴다 (계약 7절)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1596" width="465.352" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_71" value="· S1 ~ S10 은 로봇 두 대가 동시에 돈다. 두 대가 만나는 곳은 P1 과 DOCK 토큰뿐이다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="51" y="1616" width="422.408" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_72" value="이 순서도가 정하는 KPI 기준점" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1221" y="1490" width="207.96" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_73" value="· K-05 리드타임 — S3 의 created_at 에서 S4′ 의 WAITING 까지. 도킹 완료(DONE)와 다르다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1516" width="451.272" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_74" value="· AC-08 배송 성공 — S4′ 의 WAITING 이 T_lim 안이면 성공. 미션당 한 번만 센다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1536" width="401.904" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_75" value="· AC-05 추종거리 — S6~S8 의 FOLLOWING 구간만. Nav2 도착 오차 0.25 는 뺀다 (I-029)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1556" width="432.968" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_76" value="· K-04 재획득 — q4 의 Lost 1건을 성공 · 포기 · 미복귀 중 하나로만 센다 (I-028)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1576" width="411.584" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_77" value="· K-06 교착 — q2 · q6 의 REJECT → GRANT 가 60 초 안. 그 사이 RECLAIM 이면 미해결 (I-032)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1596" width="471.6" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_78" value="· AC-13 IPH — 개입 ÷ (undock ~ DOCKED). q5 의 안전 정지는 개입이 아니다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="1221" y="1616" width="380.344" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_79" value="읽는 법" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="33" y="1686" width="60.28" height="21" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_80" value="토픽  Topic" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="95" y="1714" width="70.936" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_81" value="서비스  Service" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="255.7" y="1714" width="91.352" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_82" value="액션  Action" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="439.6" y="1714" width="76.304" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_83" value="안전 경로" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="606.4" y="1714" width="60" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_84" value="단계 상자의 채움색이 그 단계를 수행하는 PC 다. 화살표 위 상자는 첫 줄이 토픽 · 서비스 · 액션 이름, 둘째 줄이 메시지 타입과 그 선이 하는 일이다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="33" y="1746" width="723.544" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_85" value="오른쪽 빨간 상자는 그 판단에서 갈라지는 예외와 그때의 처리다. 판단의 나머지 한쪽(Y 또는 N)이 아래로 이어지는 정상 흐름이다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#3A3E46;" vertex="1" parent="1"><mxGeometry x="33" y="1766" width="621.464" height="19" as="geometry"/></mxCell><mxCell id="STEP3 시나리오_f_86" value="생성: tools/build_diagrams.py   ·   근거: BRD v3.5 3.2 시나리오, SDD 3.3, docs/interfaces.md" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="33" y="1789" width="455.28" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step3b_system_flow" name="STEP3-2 전체 흐름"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2620" pageHeight="1829" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP3-2 전체 흐름_t_1" value="STEP 3-2 — 전체 기능 흐름 (Functional Process Flow)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="2572" height="30" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_t_2" value="PC = 채움색 · 화살표 색 = 통신 종류(토픽 / 서비스 / 액션 / 안전) · SDD 3.3 · 계약 v1.11" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="2572" height="20" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_3" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;PC-R3 — 로봇3 제어 PC   (namespace /robot3)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF3FC;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="860" height="675" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_4" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;PC-R4 — 로봇4 제어 PC   (namespace /robot4)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F4EFFB;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1740" y="96" width="860" height="675" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_5" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8A4F0B&quot;&gt;&lt;b&gt;PC-F — 관제 PC   (Discovery Server ID 1)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFF9EC;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="900" y="96" width="820" height="475" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_6" value="" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#5A5F6A;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="1071" width="2580" height="196" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_7" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1E6B40&quot;&gt;&lt;b&gt;PC-W1 / PC-W2 — 웹캠 PC&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EDF7F1;strokeColor=#7C8794;align=left;spacingLeft=10;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="900" y="1457" width="820" height="155" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_8" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;TurtleBot4 · OAK-D Pro 드라이버&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;oakd/rgb · stereo/depth · camera_info   704×704 crop · BEST_EFFORT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;scan 10 Hz · odom · tf · battery_state · dock_status&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;cmd_vel (geometry_msgs/TwistStamped) 로 구동한다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="136" width="828" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_9" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;aruco_detector&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;camera_fx_scale 1.7778 보정 (I-031)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;solvePnP IPPE_SQUARE · 1.5 m 게이트&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;aruco/id · aruco/distance&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_10" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;amr_detection&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;RGB+Depth 동기 slop 0.1 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;worker.pt · 재식별 임계 0.6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;target/paired · map_point&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="318.667" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_11" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#8E2A1F&quot;&gt;&lt;b&gt;safety_watchdog  (온보드)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;scan 만 구독 · 전방 ±35°&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;0.30 m 2프레임 → estop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;cmd_vel 0 을 20 Hz 로 덮어씀&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FDF0EF;strokeColor=#D98A80;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="601.333" y="264" width="262.667" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_12" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;shuttle_mission    S4 셔틀&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;READY → SHUTTLE → AT_BAY → WAITING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;ArUco 확인 → 적재 5 s → P1 토큰 → 대기공간&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;T_lim 120 s 초과 → 미션 폐기 (계약 7절)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;WAITING 은 도착 확정 시 1회 — AC-08 기준점&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="400" width="339" height="97" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_13" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;Nav2 / AMCL   turtlebot4_navigation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;map_server · amcl · bt_navigator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;planner_server · controller_server&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;velocity_smoother → cmd_vel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;xy_goal_tolerance 0.25 (I-029)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="525" y="400" width="339" height="97" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_14" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;follow_target      S5~S8 추종&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;APPROACH_1 / 2 → ARRIVED → FOLLOWING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;standoff 0.5 m · 놓치면 힌트 방향 탐색&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;T_lim 초과 → STANDBY (운영자 대기)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="543" width="339" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_15" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;opennav_docking&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;action  undock  — S2 기동&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;action  dock     — S10 복귀&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="525" y="543" width="339" height="67" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_16" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;return_dock       S10 복귀&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;P1 → DOCK 토큰 (한 번에 한 대, E-7)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;도크 정면 접근 지점 경유 → dock&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;T_ret 180 s · 재시도 2회 · 실패해도 반납&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB4CE;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="671" width="339" height="82" as="geometry"/></mxCell><mxCell id="STEP3-2 전체 흐름_n_17" value="&lt;font style=&quot;font-size:12.5px;lin