t_navigator → planner_server&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3232" y="2491" width="428" height="52" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_124" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;planner_server   (Smac / NavFn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;전역 경로 생성 — 정적 맵 + 전역 costmap&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3186" y="2565" width="520" height="52" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_125" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;전역 경로   nav_msgs/Path&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;planner_server → controller_server&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3232" y="2639" width="428" height="52" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_126" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;controller_server   (RPP / DWB)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;지역 경로 추종 → 속도 명령 산출&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;xy_goal_tolerance 0.25 — I-029&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3186" y="2713" width="520" height="67" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_127" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#1B4F91&quot;&gt;&lt;b&gt;속도 명령   TwistStamped&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;controller_server → velocity_smoother&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3232" y="2802" width="428" height="52" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_128" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;velocity_smoother&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;급가감속을 깎아 cmd_vel 로 내보낸다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;estop 중에는 safety 의 0 이 이 출력을 이긴다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3186" y="2876" width="520" height="67" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_129" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;behavior_server&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;spin · backup · wait  (복구 동작)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3186" y="2953" width="520" height="52" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_130" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;amcl  +  map_server&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;입력 scan + odom + 정적 맵&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;출력 amcl_pose · map→odom 변환&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;도크 기준 초기자세는 우리 노드가 넣는다 — I-013&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3186" y="3015" width="520" height="82" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_131" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#4B357A&quot;&gt;&lt;b&gt;global / local costmap&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;입력 정적 맵 + scan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;inflation_radius 0.25 — 받침대 덮기 (I-009)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B4A2D2;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="3186" y="3107" width="520" height="67" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_132" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;우리가 Nav2 에 하는 일은 두 가지뿐이다&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;navigate_to_pose 를 부르고, 결과를 기다린다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;그 안의 계획 · 추종 · 복구는 건드리지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;그래서 기본 판(0번)에서는 이 안쪽을 접어 둔다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="2346" y="2402" width="510" height="82" as="geometry"/></mxCell><mxCell id="STEP0-B 완전 통합 상세 (번외)_n_133" value="&lt;font style=&quot;font-size:12.5px;line-height:19px&quot; color=&quot;#333840&quot;&gt;&lt;b&gt;Nav2 launch 는 로봇당 한 PC 에서만&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;중복으로 띄우면 cmd_vel 퍼블리셔가 2개가 되어&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;line-height:15px&quot; color=&quot;#3A3E46&quot;&gt;두 개의 속도 명령이 싸운다 (setup.md)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=nowrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacing=0;spacingTop=7;spacingBottom=0;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1566" y="2402" width="450" height="67" as="geometry"/>