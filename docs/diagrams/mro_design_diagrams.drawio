<mxfile host="app.diagrams.net" type="device"><diagram id="step1_deployment" name="STEP1 배치도"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="815" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="STEP1 배치도_t_1" value="STEP 1 — 시스템 배치도 (PC 5대 · AMR 2대 · 네트워크)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=19;fontColor=#1A1D22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1232" height="30" as="geometry"/></mxCell><mxCell id="STEP1 배치도_t_2" value="MRO Multi-AMR Phase 1 · 2026-09-05 구성 확정 및 검증 완료 · SDD 3.1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=12;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1232" height="20" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_3" value="&lt;b&gt;&lt;font color=&quot;#5A5F6A&quot;&gt;무선망 SSID turtle08   ·   ROS_DOMAIN_ID = 3   ·   RMW = rmw_fastrtps_cpp   ·   전송 = Fast DDS Discovery Server 방식 (멀티캐스트 미사용)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#D7DBE0;align=left;spacingLeft=10;verticalAlign=middle;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="24" y="70" width="1232" height="34" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_4" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;PC-W1 — 웹캠1 PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ubuntu 24.04 · ROS 2 Jazzy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pkg  mro_webcam&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• webcam_register&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;   작업자 등록 · 외형 서술자 발행&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;USB 웹캠 640×480 (출입구 시야)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ROS_SUPER_CLIENT = False&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;담당  한세교 · 김학민&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="126" width="236" height="142" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_5" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;PC-W2 — 웹캠2 PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ubuntu 24.04 · ROS 2 Jazzy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pkg  mro_webcam&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• webcam_hint&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;   재탐지 방위 힌트 · KPI 계측&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;USB 웹캠 640×480 (작업공간 남단)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ROS_SUPER_CLIENT = False&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;담당  한세교 · 김학민&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="273" y="126" width="236" height="142" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_6" value="&lt;b&gt;&lt;font color=&quot;#8A4F0B&quot;&gt;PC-F — 관제 PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ubuntu 24.04 · Jazzy · GPU 불필요&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IP 192.168.108.41/24 (고정)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;★ Fast DDS Discovery Server&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;    서버 ID 1 · UDP 11811&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pkg  mro_fleet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• fleet_manager   • zone_semaphore&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• control_ui (Flask :5000)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• kpi_logger · SQLite&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;담당  김민준&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF3E3;strokeColor=#B06810;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="522" y="126" width="236" height="172" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_7" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;PC-R3 — 로봇3 제어 PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ubuntu 24.04 · Jazzy · NVIDIA GPU&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nav2 + AMCL + RViz2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pkg  mro_perception&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• amr_detection  • aruco_detector&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pkg  mro_navigation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• shuttle_mission  • follow_target&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• return_dock  • safety_watchdog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;namespace = /robot3&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="771" y="126" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_8" value="&lt;b&gt;&lt;font color=&quot;#1B4F91&quot;&gt;PC-R4 — 로봇4 제어 PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ubuntu 24.04 · Jazzy · NVIDIA GPU&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nav2 + AMCL + RViz2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pkg  mro_perception&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• amr_detection  • aruco_detector&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pkg  mro_navigation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• shuttle_mission  • follow_target&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• return_dock  • safety_watchdog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;namespace = /robot4&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4FD;strokeColor=#3576C8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1020" y="126" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_9" value="&lt;b&gt;&lt;font color=&quot;#8A4F0B&quot;&gt;ROS_DISCOVERY_SERVER = &quot;;192.168.108.41:11811&quot;      ← 앞의 세미콜론 하나가 &quot;서버 ID 1&quot; 을 뜻한다. 5대 PC + 로봇 2대가 모두 같은 값을 쓴다.&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;이 경로로 오가는 것은 참가자·토픽 탐색 정보뿐이다. 실제 토픽 데이터는 발행 노드와 구독 노드 사이를 직접(P2P) 흐르므로 PC-F 를 거치지 않는다.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF3E3;strokeColor=#B06810;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="402" width="1232" height="52" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_10" value="&lt;b&gt;&lt;font color=&quot;#1E6B40&quot;&gt;robot3 — TurtleBot4 Standard&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Raspberry Pi 4B · Ubuntu 24.04&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;turtlebot4_bringup · _node&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;depthai_ros_driver → OAK-D Pro&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rplidar_ros → RPLIDAR A1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;iRobot Create3 (범퍼·클리프·도크)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;onboard Discovery ID 3 — 남겨두되&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PC 의 접속 목록에는 넣지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Offboard IP → 192.168.108.41&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="771" y="512" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_11" value="&lt;b&gt;&lt;font color=&quot;#1E6B40&quot;&gt;robot4 — TurtleBot4 Standard&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Raspberry Pi 4B · Ubuntu 24.04&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;turtlebot4_bringup · _node&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;depthai_ros_driver → OAK-D Pro&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rplidar_ros → RPLIDAR A1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;iRobot Create3 (범퍼·클리프·도크)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;onboard Discovery ID 4 — 남겨두되&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PC 의 접속 목록에는 넣지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Offboard IP → 192.168.108.41&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="1020" y="512" width="236" height="157" as="geometry"/></mxCell><mxCell id="STEP1 배치도_n_12" value="&lt;b&gt;&lt;font color=&quot;#333840&quot;&gt;읽는 법 · 확인 상태&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;─── 주황 실선 = 디스커버리 등록 경로. 모든 참가자가 PC-F 의 서버 하나에만 등록한다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;      토픽 데이터 경로는 P2P 라서 이 그림에 선으로 그리지 않는다 (STEP 2 가 그 내용이다).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[검증됨] 2026-09-05 — PC 5대와 로봇 2대를 모두 붙인 뒤 각 PC 에서 /robot3 · /robot4 토픽이&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;      동시에 보이는 것을 확인했다. 통신 구성은 이 상태로 확정한다 (SDD NR-01).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;이 구조를 택한 이유 — 종전에는 로봇의 라즈베리파이가 디스커버리 허브를 겸했다. PC 가 늘어날수록&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;      RPi 가 병목이 되고, 로봇 2대면 PC 마다 서버 두 곳을 동시에 봐야 해서 설정이 갈라진다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;      서버를 관제 노트북 한 대로 빼면 RPi 는 자기 센서 처리에만 쓰이고, 모든 PC 의 설정이 한 줄로 같아진다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;웹캠 PC 와 nav2 터미널은 ROS_SUPER_CLIENT = False 로 둔다. 전체 토픽 목록이 필요한 도구&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;      (ros2 topic list, RViz 탐색)를 쓸 때만 True 가 필요하고, 상시 True 는 불필요한 트래픽을 만든다.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;고정 IP 192.168.108.41 은 공유기 DHCP 예약이 아직 걸려 있지 않다 → 강사님께 예약 요청 필요.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9CFD6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;fontFamily=Noto Sans KR;fontSize=11;dashed=0;" vertex="1" parent="1"><mxGeometry x="24" y="512" width="723" height="247" as="geometry"/></mxCell><mxCell id="STEP1 배치도_e_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_4" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="142" y="335"/><mxPoint x="640" y="335"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_5" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="391" y="335"/><mxPoint x="640" y="335"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_6" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_7" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="889" y="342.5"/><mxPoint x="640" y="342.5"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_8" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1138" y="342.5"/><mxPoint x="640" y="342.5"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_10" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="889" y="483"/><mxPoint x="640" y="483"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_e_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#B06810;strokeWidth=1.6;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#B06810;endArrow=none;" edge="1" parent="1" source="STEP1 배치도_n_11" target="STEP1 배치도_n_9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1138" y="483"/><mxPoint x="640" y="483"/></Array></mxGeometry></mxCell><mxCell id="STEP1 배치도_f_20" value="생성: tools/build_diagrams.py   ·   원본 근거: docs/setup.md, docs/architecture.md, SDD 2.3 NR-01" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans KR;fontSize=10;fontColor=#8A8F98;" vertex="1" parent="1"><mxGeometry x="24" y="767" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="step2_nav2" name="STEP2 Nav2 스택"><mxGraphModel dx="1400" dy="900" grid="1" grid