id="STEP5 노드 그래프 — 웹캠1_e_81" value="mission/assigned&lt;br&gt;토픽 · Mission" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3576C8;strokeWidth=2;dashed=0;fontFamily=Noto Sans KR;fontSize=10;fontColor=#3576C8;endArrow=classic;" edge="1" parent="1" source="STEP5 노드 그래프 — 웹캠1_n_33" target="STEP5 노드 그래프 — 웹캠1_n_34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1712" y="1419"/><mxPoint x="1718.12" y="1419"/></Array></mxGeometry></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_f_82" value="외부 장비   — 장비 상자에는 사양을 적는다" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=12;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="23" y="235" width="266.48" height="20" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_f_83" value="읽는 법" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=13;fontColor=#333840;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="23" y="2078" width="60.28" height="21" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_f_84" value="타원 = 시작   ·   네모 = 하는 일   ·   마름모 = 판단   ·   빨간 네모 = 그때의 처리" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="23" y="2104" width="429.888" height="19" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_f_85" value="상자에는 무슨 일을 하는지만 적는다. 함수 이름과 변수 이름은 쓰지 않는다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="23" y="2124" width="368.816" height="19" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_f_86" value="파란 화살표가 PC 를 건너는 ROS 토픽이다 — 토픽 이름과 메시지 타입을 적는다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="23" y="2144" width="387.032" height="19" as="geometry"/></mxCell><mxCell id="STEP5 노드 그래프 — 웹캠1_f_87" value="사양은 외부 장비 상자에만 적는다. 장비는 화살표로 설명할 상대가 없기 때문이다." style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans KR;fontSize=11;fontColor=#5A5F6A;" vertex="1" parent="1"><mxGeometry x="23" y="2164" width="397.856" height="19" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>