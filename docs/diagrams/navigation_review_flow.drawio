        <mxCell id="c160" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CBA6;strokeColor=#B5651D;strokeWidth=1.5;fontSize=14;fontColor=#1A1A1A;align=center;verticalAlign=middle;" value="&lt;b&gt;⑦ estop 중?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;No → 아무것도 내지 않는다&lt;br&gt;(Nav2 를 방해하지 않는다)&lt;/span&gt;" vertex="1">
