        <mxCell id="c161" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CBA6;strokeColor=#B5651D;strokeWidth=1.5;fontSize=14;fontColor=#1A1A1A;align=center;verticalAlign=middle;" value="&lt;b&gt;⑧ Nav2 명령 0.5 s 안?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;nav_cmd_valid_s&lt;br&gt;지나면 각속도도 0&lt;/span&gt;" vertex="1">
