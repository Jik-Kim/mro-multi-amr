        <mxCell id="c162" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CBA6;strokeColor=#B5651D;strokeWidth=1.5;fontSize=15;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" value="&lt;b&gt;⑨ cmd_vel 덮어쓰기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;병진 전부 0&lt;/b&gt; · 각속도만 ±0.4 rad/s&lt;br&gt;20 Hz — Nav2 보다 나중 명령이 이긴다&lt;/span&gt;" vertex="1">
