        <mxCell id="NHzX2QWQummSIviHYQlM-1570" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C2CBD5;fontSize=11.5;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;strokeWidth=1.2;arcSize=4;" value="&lt;b&gt;bt_navigator/get_state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;&quot; color=&quot;#0B5FA5&quot;&gt;lifecycle_msgs/GetState → active 인가&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;&quot; color=&quot;#8A97A6&quot;&gt;srv client · 5 s 간격 최대 3회 (기동 확인)&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="330" x="17212" y="14918" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1571" edge="1" parent="1" source="NHzX2QWQummSIviHYQlM-1092" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;strokeColor=#B0BAC6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;fontSize=9.5;fontColor=#7A8798;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="NHzX2QWQummSIviHYQlM-1570" value="⑤ 스택 기동 확인">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="17102" y="14683" />
              <mxPoint x="17102" y="14952" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1572" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0AE;strokeWidth=1.8;arcSize=3;" value="" vertex="1">
          <mxGeometry height="560" width="1520" x="16022" y="16367" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1573" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE2E9;strokeColor=#DCE2E9;fontColor=#333F4E;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=14;arcSize=5;" value="우리가 Nav2 를 어떻게 쓰나 (v3.0 에서 편 이유)&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot; color=&quot;#333F4E&quot;&gt;아래 카드의 노드 상자와 짝을 이룬다&lt;/font&gt;" vertex="1">
          <mxGeometry height="62" width="1520" x="16022" y="16367" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1574" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBFCFD;strokeColor=#E4E9EE;fontSize=12;fontColor=#22303F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;" value="&lt;b&gt;우리 노드가 부르는 것은 넷뿐이다.&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;NavigateToPose&lt;/b&gt; — 셔틀 · 추종 · 복귀 셋이 모두 bt_navigator 에 목표 하나를 준다&lt;br&gt;&amp;#8226; &lt;b&gt;Spin · DriveOnHeading&lt;/b&gt; — 셔틀의 마커 정렬만. behavior_server 가 받는다&lt;br&gt;&amp;#8226; &lt;b&gt;Dock · Undock&lt;/b&gt; — 셔틀의 언독, 복귀의 도킹. docking_server 가 받는다&lt;br&gt;&amp;#8226; &lt;b&gt;상태 조회&lt;/b&gt; — 셔틀이 기동 직후 bt_navigator 가 active 인지 묻는다&lt;br&gt;&lt;br&gt;&lt;b&gt;부르지 않는 것 셋&lt;/b&gt; — smoother_server · route_server · waypoint_follower.&lt;br&gt;라이프사이클에는 뜨지만 우리 코드가 한 번도 부르지 않는다. 켜져 있다고 쓰는 것이 아니다.&lt;br&gt;&lt;br&gt;&lt;b&gt;측위는 우리가 열어준다.&lt;/b&gt; amcl 은 &lt;b&gt;initialpose&lt;/b&gt; 를 받아야 map→odom 을 내고, 그게 없으면 코스트맵도 뜨지 않는다. 그래서 셔틀이 &lt;b&gt;주행 스택을 켜기 전에&lt;/b&gt; 도크 좌표를 먼저 보낸다 (I-035).&lt;br&gt;&lt;br&gt;&lt;b&gt;안전은 스택 밖에 있다.&lt;/b&gt; collision_monitor 가 Nav2 의 마지막 관문이지만, safety_watchdog 는 그 뒤에서 같은 &lt;b&gt;cmd_vel&lt;/b&gt; 을 20 Hz 로 덮어쓴다 — 나중 명령이 이긴다." vertex="1">
          <mxGeometry height="464" width="1488" x="16038" y="16445" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1575" edge="1" parent="1" source="NHzX2QWQummSIviHYQlM-1570" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8894A4;strokeWidth=2.2;endArrow=blockThin;endFill=1;endSize=7;jumpStyle=arc;jumpSize=10;fontSize=12;fontStyle=1;fontColor=#8894A4;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;arcSize=12;labelBorderColor=#C9D4E0;" target="NHzX2QWQummSIviHYQlM-1515" value="GetState 요청 → active 여부">
