        <mxCell id="NHzX2QWQummSIviHYQlM-918" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.2;fontSize=11.5;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=4;" value="&lt;b&gt;④&lt;/b&gt; 상태 합성 — 추종 갈래와 셔틀 갈래 두 문자열에서&lt;br&gt;로봇 하나의 상태를 만든다 (&lt;b&gt;복귀가 우선&lt;/b&gt;)" vertex="1">
