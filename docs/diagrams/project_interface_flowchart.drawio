        <mxCell id="sOfq9NzT-7iqfco4Ug7B-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C2CBD5;fontSize=11.5;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;strokeWidth=1.2;arcSize=4;" value="&lt;b&gt;target/pair_state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;&quot; color=&quot;#0B5FA5&quot;&gt;std_msgs/String&lt;br&gt;PAIRED | GATE_FAIL | NO_TARGET&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;&quot; color=&quot;#8A97A6&quot;&gt;pub · RELIABLE 10 · 변화 즉시 + 1 Hz · 계약 10.2&lt;/font&gt;" vertex="1">
