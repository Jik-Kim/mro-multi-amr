        <mxCell id="NHzX2QWQummSIviHYQlM-1528" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#B7C0CA;strokeWidth=1.4;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#66727E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;smoother_server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;라이프사이클에는 뜨지만 &lt;b&gt;주행 노드가 부르지 않는다&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="940" x="12022" y="18690" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1529" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#B7C0CA;strokeWidth=1.4;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#66727E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;route_server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;라이프사이클에는 뜨지만 &lt;b&gt;주행 노드가 부르지 않는다&lt;/b&gt;&lt;/font&gt;" vertex="1">
