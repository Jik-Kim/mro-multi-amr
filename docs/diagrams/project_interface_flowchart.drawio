        <mxCell id="NHzX2QWQummSIviHYQlM-1519" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;amcl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;likelihood_field · 입자 500~2000 · &lt;b&gt;map → odom TF&lt;/b&gt;&lt;br&gt;&lt;b&gt;initialpose 를 받아야 낸다&lt;/b&gt; — 없으면 코스트맵이 안 뜬다&lt;br&gt;update_min_d 0.25 → &lt;b&gt;0.05&lt;/b&gt; (측위 점프 완화) · update_min_a 0.2&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="940" x="14122" y="18150" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1520" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E0F6;strokeColor=#A897D4;strokeWidth=1.8;fontSize=12;fontColor=#3F2180;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;lifecycle_manager_navigation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;켜는 대상 &lt;b&gt;10개&lt;/b&gt; · bond_timeout 10.0&lt;br&gt;&lt;b&gt;활성화에 실패해도 재시도하지 않는다&lt;/b&gt; — 아래 점선 10개가 그 관계다&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="940" x="16222" y="18150" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1521" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;bt_navigator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;NavigateToPose · NavigateThroughPoses &lt;b&gt;액션 서버&lt;/b&gt;&lt;br&gt;행동 트리가 계획 → 제어 → 복구를 엮는다&lt;br&gt;bt_loop_duration 10 · 상태 조회로 active 확인&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="940" x="12022" y="18410" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1522" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;planner_server &lt;font color=&quot;#5B6B7C&quot;&gt;+ global_costmap&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;NavFn (A* 아님) · tolerance 0.5&lt;br&gt;global: resolution 0.06 · track_unknown_space&lt;br&gt;&lt;b&gt;inflation_radius 0.30&lt;/b&gt; · cost_scaling 4.0&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="940" x="13072" y="18410" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1523" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;controller_server &lt;font color=&quot;#5B6B7C&quot;&gt;+ local_costmap&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;DWB · 20 Hz · &lt;b&gt;max_vel_x 0.26&lt;/b&gt; (계약 v_max 0.3 과 충돌)&lt;br&gt;SimpleGoalChecker xy 0.25 · yaw 0.25 rad → 작은 목표는 &quot;이미 도착&quot;&lt;br&gt;local: 3×3 m rolling · inflation 0.1 · 외접 0.189&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="940" x="14122" y="18410" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1524" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;behavior_server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;&lt;b&gt;spin · drive_on_heading&lt;/b&gt; · backup · wait · assisted_teleop&lt;br&gt;cycle 10 Hz · min_rot &lt;b&gt;0.4&lt;/b&gt; / max_rot 1.0 rad/s → 한 사이클 2.3°&lt;br&gt;&lt;b&gt;backup 은 쓰지 않는다&lt;/b&gt; (계약 2절 후진 금지)&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="940" x="15172" y="18410" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1525" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;velocity_smoother&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;20 Hz · max_velocity [0.26, 0, 1.0] · velocity_timeout 1.0&lt;br&gt;min_velocity 는 −0.26 이지만 우리는 후진 명령을 내지 않는다&lt;br&gt;내보내는 이름 &lt;b&gt;cmd_vel_smoothed&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="940" x="16222" y="18410" as="geometry" />
        </mxCell>
        <mxCell id="NHzX2QWQummSIviHYQlM-1526" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;collision_monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;cmd_vel_smoothed → &lt;b&gt;cmd_vel&lt;/b&gt; (최종 관문)&lt;br&gt;FootprintApproach · time_before_collision 1.2 s&lt;br&gt;&lt;b&gt;scan min_height 0.15&lt;/b&gt; — 그보다 낮은 장애물은 못 본다&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="940" x="17272" y="18410" as="geometry" />
