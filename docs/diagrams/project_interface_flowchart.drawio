        <mxCell id="NHzX2QWQummSIviHYQlM-1527" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=4;" value="&lt;b&gt;docking_server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;&quot; color=&quot;#5B6B7C&quot;&gt;dock / undock &lt;b&gt;액션 서버&lt;/b&gt;&lt;br&gt;&lt;b&gt;dock_backwards false&lt;/b&gt; · max_retries 3&lt;br&gt;staging_x_offset −0.7 · docking_threshold 0.05&lt;/font&gt;" vertex="1">
